---
// Runtime jumper layer over the whole desk world. Any element with data-wire-from="<selector>" is a pad;
// a wire runs from the header pin that selector finds to that pad.
// Optional on the pad: data-wire-color, data-wire-group (each group gets its own block of lanes),
// data-wire-shared (the pin already carries a housing, so the wire leaves from its end),
// data-wire-side on the bench units (top or bottom: the jumper runs above or below the breadboard and
// drops onto its hole from that side).
// A selector may end in "@n" to pick the nth match. Missing or hidden anchors drop the wire.
// Desk world: wires leave the headers to the right, drop or rise in the gap between the stations,
// and land on the bench, which this script first slides level with the headers it is wired to.
// Stacked layout: only short leads at the headers.
---

<svg class="wire-layer" aria-hidden="true" focusable="false"></svg>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const LCD_OUTER = 1542 + 4.5; // outer edge of the LCD jumpers, board units
  const BOARD_W = 1500;

  type Wire = { pin: DOMRect; pad: DOMRect; color: string; group: string; shared: boolean; side: string };
  type Seg = { h: boolean; c: number; a: number; b: number };

  const pick = (sel: string) => {
    const [q, n] = sel.split('@');
    try {
      const el = document.querySelectorAll(q)[Number(n ?? 0)];
      return el && el.getClientRects().length ? el.getBoundingClientRect() : null;
    } catch {
      return null;
    }
  };
  const el = (name: string, attrs: Record<string, string | number>) => {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  };
  const midY = (r: DOMRect) => r.top + r.height / 2;
  // a polyline with rounded corners, each radius clipped to half its shorter leg
  const rounded = (pts: [number, number][], rmax: number) => {
    const p = pts.filter((q, i) => !i || Math.hypot(q[0] - pts[i - 1][0], q[1] - pts[i - 1][1]) > 0.5);
    let d = `M${p[0][0]} ${p[0][1]}`;
    for (let i = 1; i < p.length - 1; i++) {
      const [x0, y0] = p[i - 1];
      const [x1, y1] = p[i];
      const [x2, y2] = p[i + 1];
      const l1 = Math.hypot(x1 - x0, y1 - y0);
      const l2 = Math.hypot(x2 - x1, y2 - y1);
      const r = Math.min(rmax, l1 / 2, l2 / 2);
      d += `L${x1 - ((x1 - x0) / l1) * r} ${y1 - ((y1 - y0) / l1) * r}Q${x1} ${y1} ${x1 + ((x2 - x1) / l2) * r} ${y1 + ((y2 - y1) / l2) * r}`;
    }
    const last = p[p.length - 1];
    return `${d}L${last[0]} ${last[1]}`;
  };
  const crosses = (s: Seg, t: Seg) => {
    if (s.h === t.h) return false;
    const [h, v] = s.h ? [s, t] : [t, s];
    return v.c > h.a && v.c < h.b && h.c > v.a && h.c < v.b;
  };
  const mean = (a: number[]) => a.reduce((s, v) => s + v, 0) / (a.length || 1);

  // slide the bench so J1 sits level with CN5 and the breadboard holes level with D2-D7;
  // when both cannot hold, split the difference
  const align = () => {
    const right = document.querySelector<HTMLElement>('.station[data-station="right"]');
    if (!right) return;
    const band = (group: string, header: string) => {
      const pads = [...right.querySelectorAll<HTMLElement>(`[data-wire-group="${group}"]`)].filter((t) => t.dataset.wireFrom!.includes(header));
      const pins = pads.map((t) => pick(t.dataset.wireFrom!)).filter((r): r is DOMRect => !!r);
      if (!pads.length || pins.length !== pads.length) return null;
      return mean(pads.map((t) => midY(t.getBoundingClientRect()))) - mean(pins.map(midY));
    };
    const e1 = band('trace', 'cn5');
    if (e1 === null) return;
    // the bench units take their jumpers from above and below, so only a level group pulls on the bench
    const e2 = band('builds', 'cn9') ?? e1;
    const cs = getComputedStyle(right);
    const W = parseFloat(cs.getPropertyValue('--work-y')) || 120;
    const P = parseFloat(cs.getPropertyValue('--projects-y')) || 48;
    const P2 = Math.max(20, P - (e2 - e1));
    const D = e2 - e1 + (P2 - P);
    const W2 = Math.max(32, W - e1 - D / 2);
    if (Math.abs(W2 - W) > 1) right.style.setProperty('--work-y', `${Math.round(W2)}px`);
    if (Math.abs(P2 - P) > 1) right.style.setProperty('--projects-y', `${Math.round(P2)}px`);
    // the bench moved, so anything placed by its position (scroll anchors) is stale
    if (Math.abs(W2 - W) > 1 || Math.abs(P2 - P) > 1) window.dispatchEvent(new Event('rk:layout'));
  };

  let teardown: (() => void) | null = null;
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });

  const init = () => {
    const svg = document.querySelector<SVGSVGElement>('.wire-layer');
    const desk = svg?.parentElement;
    const stage = desk?.querySelector<HTMLElement>('.stage');
    if (!svg || !desk || !stage || svg.dataset.bound) return;
    svg.dataset.bound = '1';
    teardown?.();
    const hero = desk.querySelector<HTMLElement>('.desk');

    const draw = () => {
      // the laptop zoom scales the whole camera; redraw once it is back
      if (document.documentElement.dataset.zoom) return;
      svg.replaceChildren();
      if (hero?.dataset.intro === 'run') return;
      const world = document.documentElement.classList.contains('world');
      if (world) align();
      const d = desk.getBoundingClientRect();
      const s = stage.getBoundingClientRect();
      const u = s.width / BOARD_W;
      svg.setAttribute('viewBox', `0 0 ${d.width} ${d.height}`);
      svg.setAttribute('width', String(d.width));
      svg.setAttribute('height', String(d.height));

      const groups = new Map<string, Wire[]>();
      document.querySelectorAll<HTMLElement>('[data-wire-from]').forEach((t) => {
        const pin = pick(t.dataset.wireFrom!);
        const pad = t.getClientRects().length ? t.getBoundingClientRect() : null;
        if (!pin || (!pad && world)) return;
        const g = t.dataset.wireGroup ?? 'a';
        if (!groups.has(g)) groups.set(g, []);
        groups.get(g)!.push({ pin, pad: pad ?? new DOMRect(), color: t.dataset.wireColor ?? '#8a8a86', group: g, shared: 'wireShared' in t.dataset, side: t.dataset.wireSide ?? '' });
      });
      if (!groups.size) return;

      // board units to desk px; parts are drawn at the board's scale
      const X = (x: number) => s.left - d.left + x * u;
      const housingW = 52 * u;
      const housingH = Math.max(10, 28 * u);
      const wireW = Math.max(2.6, 9 * u);
      const pitch = wireW * 1.9;

      const shadow = el('g', { fill: 'none', stroke: '#000', 'stroke-linecap': 'round', 'stroke-linejoin': 'round', opacity: 0.22, transform: 'translate(3 5)' });
      const body = el('g', { fill: 'none', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' });
      const shine = el('g', { fill: 'none', stroke: '#fff', 'stroke-linecap': 'round', opacity: 0.28, transform: 'translate(-0.8 -0.8)' });
      const caps = el('g', {});
      // a wide invisible stroke over the ribbon makes it a click target
      const hit = el('g', { class: 'wire-hit', fill: 'none', stroke: 'transparent', 'stroke-width': 18 });
      svg.append(shadow, body, shine, caps, hit);

      // Dupont housing lying flat between x0 and x1, contact at cx
      const housing = (cx: number, cy: number, x0: number, x1: number) => {
        caps.append(
          el('rect', { x: x0 + 3, y: cy - housingH / 2 + 4, width: x1 - x0, height: housingH, rx: 2.5, fill: '#000', opacity: 0.28 }),
          el('rect', { x: x0, y: cy - housingH / 2, width: x1 - x0, height: housingH, rx: 2.5, fill: '#18191c' }),
          el('path', { d: `M${x0 + 2} ${cy - housingH / 2 + 1.5}H${x1 - 2}`, stroke: '#4a4b51', 'stroke-width': 1.5 }),
          el('rect', { x: cx - 3, y: cy - 3, width: 6, height: 6, rx: 1, fill: '#2c2d32' }),
        );
      };
      const stroke = (path: string, color: string, w = wireW) => {
        shadow.append(el('path', { d: path, 'stroke-width': w + 1.5 }));
        body.append(el('path', { d: path, stroke: color, 'stroke-width': w }));
        shine.append(el('path', { d: path, 'stroke-width': Math.max(0.8, w * 0.28) }));
        if (world) hit.append(el('path', { d: path }));
      };

      // power has its own route in the desk world (below); the ribbon lanes are for the signal groups
      const ownRoute = (g: string) => world && g === 'power';
      const ribbon = [...groups].filter(([g]) => !ownRoute(g)).map(([, w]) => w);
      // lanes fill the gap between the board's LCD jumpers and the nearest landing pad; the bench units'
      // jumpers turn before the breadboard's edge
      const bench = document.querySelector('.bb')?.getBoundingClientRect();
      const pads = ribbon.flat().map((w) => (w.side && bench ? bench.left : w.pad.left) - d.left);
      const start = X(LCD_OUTER) + 3 * pitch;
      const end = Math.min(...pads) - housingW - 2 * pitch;
      const total = ribbon.reduce((n, g) => n + g.length, 0) + 2 * (ribbon.length - 1);
      // a tight ribbon, centred in the gap
      const gap = Math.max(wireW * 1.2, Math.min(pitch, (end - start) / Math.max(1, total)));
      let lane = start + Math.max(0, (end - start - gap * total) / 2);

      // 5V and GND: off the pins, up the board's edge, along the empty desk above the bench, down the
      // bench's right margin, and a short drop into the rail ends. Nothing crosses the ribbon or the
      // breadboard, and the higher pin takes the higher run and the outer lane, so the two never cross
      const power = (wires: Wire[]) => {
        const eyebrow = document.querySelector('#work .eyebrow')?.getBoundingClientRect();
        const bench = document.querySelector('.bb')?.getBoundingClientRect();
        if (!eyebrow || !bench || wires.length < 2) return;
        const [hi, lo] = [...wires].sort((a, b) => midY(a.pin) - midY(b.pin));
        const run0 = eyebrow.top - d.top - 44;
        const margin = bench.right - d.left + 26;
        const r = 14;
        [hi, lo].forEach((w) => {
          const px = w.pin.left + w.pin.width / 2 - d.left;
          const py = midY(w.pin) - d.top;
          const out = px + 28 * u;
          housing(px, py, px - 24 * u, out);
          const tx = w.pad.left + w.pad.width / 2 - d.left;
          const ty = midY(w.pad) - d.top;
          const tEnd = tx + housingW * 0.6;
          housing(tx, ty, tx - housingW * 0.3, tEnd);
          const rise = hi === w ? run0 : run0 + 16;
          const xr = out + 10 + (hi === w ? 0 : 12);
          const xm = hi === w ? margin + 20 : margin;
          const r1 = Math.min(r, Math.abs(rise - py) / 2);
          const sy = rise < py ? -1 : 1;
          stroke(
            [
              `M${out} ${py}`,
              `H${xr - r1}`,
              `Q${xr} ${py} ${xr} ${py + sy * r1}`,
              `V${rise - sy * r}`,
              `Q${xr} ${rise} ${xr + r} ${rise}`,
              `H${xm - r}`,
              `Q${xm} ${rise} ${xm} ${rise + r}`,
              `V${ty - r}`,
              `Q${xm} ${ty} ${xm - r} ${ty}`,
              `H${tEnd}`,
            ].join(''),
            w.color,
          );
        });
      };

      // vertical Dupont housing on a breadboard hole, the wire arriving from above (dir -1) or below (1)
      const housingV = (cx: number, cy: number, dir: number) => {
        const y0 = dir < 0 ? cy - housingW * 0.6 : cy - housingW * 0.3;
        caps.append(
          el('rect', { x: cx - housingH / 2 + 3, y: y0 + 4, width: housingH, height: housingW * 0.9, rx: 2.5, fill: '#000', opacity: 0.28 }),
          el('rect', { x: cx - housingH / 2, y: y0, width: housingH, height: housingW * 0.9, rx: 2.5, fill: '#18191c' }),
          el('path', { d: `M${cx - housingH / 2 + 1.5} ${y0 + 2}V${y0 + housingW * 0.9 - 2}`, stroke: '#4a4b51', 'stroke-width': 1.5 }),
          el('rect', { x: cx - 3, y: cy - 3, width: 6, height: 6, rx: 1, fill: '#2c2d32' }),
        );
        return dir < 0 ? y0 : y0 + housingW * 0.9;
      };

      // bench units: off the pin, along a lane, out to a channel above (top half) or below (bottom half)
      // the breadboard, across, and a short drop onto the switch's hole. The nearest drop takes the channel
      // closest to the board; lanes are ordered by a few passes of swaps that cut crossings
      const units = (wires: Wire[]) => {
        if (!bench) return;
        const chGap = Math.max(wireW * 1.7, 6);
        const chan = new Map<Wire, number>();
        const ends = new Map<Wire, number>();
        for (const side of ['top', 'bottom']) {
          const list = wires.filter((w) => (w.side === 'top') === (side === 'top')).sort((a, b) => a.pad.left - b.pad.left);
          list.forEach((w, i) => chan.set(w, side === 'top' ? bench.top - d.top - 14 - i * chGap : bench.bottom - d.top + 14 + i * chGap));
        }
        const geo = wires.map((w) => {
          const px = w.pin.left + w.pin.width / 2 - d.left;
          const py = midY(w.pin) - d.top;
          const out = px + 28 * u;
          const tx = w.pad.left + w.pad.width / 2 - d.left;
          const ty = midY(w.pad) - d.top;
          return { w, px, py, out, tx, ty, cy: chan.get(w)!, dir: w.side === 'top' ? -1 : 1 };
        });
        const segs = (g: (typeof geo)[number], L: number): Seg[] => [
          { h: true, c: g.py, a: g.out, b: L },
          { h: false, c: L, a: Math.min(g.py, g.cy), b: Math.max(g.py, g.cy) },
          { h: true, c: g.cy, a: L, b: g.tx },
          { h: false, c: g.tx, a: Math.min(g.cy, g.ty), b: Math.max(g.cy, g.ty) },
        ];
        const cost = (order: typeof geo) => {
          const all = order.map((g, i) => segs(g, lane + i * gap));
          let n = 0;
          for (let i = 0; i < all.length; i++) for (let j = i + 1; j < all.length; j++) for (const s of all[i]) for (const t of all[j]) n += +crosses(s, t);
          return n;
        };
        const order = [...geo].sort((a, b) => a.py - b.py);
        let best = cost(order);
        for (let pass = 0; pass < order.length; pass++) {
          let moved = false;
          for (let i = 0; i + 1 < order.length; i++) {
            [order[i], order[i + 1]] = [order[i + 1], order[i]];
            const c = cost(order);
            if (c < best) {
              best = c;
              moved = true;
            } else [order[i], order[i + 1]] = [order[i + 1], order[i]];
          }
          if (!moved) break;
        }
        order.forEach((g, i) => {
          housing(g.px, g.py, g.px - 24 * u, g.out);
          ends.set(g.w, housingV(g.tx, g.ty, g.dir));
          const L = lane + i * gap;
          stroke(
            rounded(
              [
                [g.out, g.py],
                [L, g.py],
                [L, g.cy],
                [g.tx, g.cy],
                [g.tx, ends.get(g.w)!],
              ],
              Math.min(30, chGap * 2),
            ),
            g.w.color,
          );
        });
      };

      for (const [name, wires] of groups) {
        if (ownRoute(name)) {
          power(wires);
          continue;
        }
        if (world && name === 'units') {
          units(wires);
          lane += (wires.length + 2) * gap;
          continue;
        }
        wires.sort((a, b) => a.pin.top - b.pin.top);
        // going down, the top wire takes the far lane; going up, the near one; then nothing crosses
        const down = mean(wires.map((w) => midY(w.pad) - midY(w.pin))) >= 0;
        wires.forEach((w, i) => {
          const px = w.pin.left + w.pin.width / 2 - d.left;
          const py = midY(w.pin) - d.top;
          const out = w.shared ? px + 28 * u + 2 : px + 28 * u;
          if (!w.shared) housing(px, py, px - 24 * u, out);
          if (!world) {
            stroke(`M${out} ${py}h${Math.max(10, 22 * u)}`, w.color);
            return;
          }
          const tx = w.pad.left + w.pad.width / 2 - d.left;
          const ty = midY(w.pad) - d.top;
          const tEnd = tx - housingW * 0.6;
          housing(tx, ty, tEnd, tx + housingW * 0.3);
          const lx = lane + (down ? wires.length - 1 - i : i) * gap;
          const dy = ty - py;
          const r = Math.min(30, Math.abs(dy) / 2, (lx - out) / 2, (tEnd - lx) / 2);
          const sy = Math.sign(dy) || 1;
          stroke(
            Math.abs(dy) < 2
              ? `M${out} ${py}H${tEnd}`
              : [
                  `M${out} ${py}`,
                  `H${lx - r}`,
                  `Q${lx} ${py} ${lx} ${py + sy * r}`,
                  `V${ty - sy * r}`,
                  `Q${lx} ${ty} ${lx + r} ${ty}`,
                  `H${tEnd}`,
                ].join(''),
            w.color,
          );
        });
        lane += (wires.length + 2) * gap;
      }
    };

    let raf = 0;
    const queue = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(draw);
    };
    // the ribbon leads to the bench, and back
    const go = () => {
      const here = document.documentElement.dataset.station;
      window.dispatchEvent(new CustomEvent('rk:go', { detail: here === 'right' ? 'center' : 'right' }));
    };
    svg.addEventListener('click', (e) => (e.target as Element).closest('.wire-hit') && go());
    const ro = new ResizeObserver(queue);
    ro.observe(desk);
    document.querySelectorAll('[data-wire-from]').forEach((t) => ro.observe(t));
    const mo = new MutationObserver(queue);
    if (hero) mo.observe(hero, { attributes: true, attributeFilter: ['data-intro'] });
    window.addEventListener('resize', queue);
    window.addEventListener('rk:world-moved', queue);
    document.fonts?.ready.then(queue);
    document.fonts?.addEventListener('loadingdone', queue);
    queue();
    teardown = () => {
      ro.disconnect();
      mo.disconnect();
      window.removeEventListener('resize', queue);
      window.removeEventListener('rk:world-moved', queue);
      document.fonts?.removeEventListener('loadingdone', queue);
    };
  };
  document.addEventListener('astro:after-swap', init);
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .wire-layer {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    overflow: visible;
    pointer-events: none;
  }
  .wire-layer :global(.wire-hit path) {
    pointer-events: stroke;
    cursor: pointer;
  }
</style>
