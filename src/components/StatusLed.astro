---
// 0603 status LED: amber blinking at 1 Hz while in progress, steady green once shipped
interface Props {
  status: 'wip' | 'shipped';
  class?: string;
}
const { status, class: cls } = Astro.props;
---

<span class:list={['sled', cls]} data-status={status} aria-hidden="true"></span>

<style>
  .sled {
    display: inline-block;
    flex: none;
    width: 12px;
    height: 8px;
    border-radius: 2px;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.3),
      inset -2px -1px 0 rgba(255, 255, 255, 0.35),
      1px 2px 2px rgba(0, 0, 0, 0.35);
  }
  [data-status='shipped'] {
    background: #3fb27f;
  }
  [data-status='wip'] {
    background: #e8a33a;
    animation: sled-blink 1s steps(1, end) infinite;
  }
  @keyframes sled-blink {
    50% {
      background: #6b5532;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-status='wip'] {
      animation: none;
    }
  }
</style>
