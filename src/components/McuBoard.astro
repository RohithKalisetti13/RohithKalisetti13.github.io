---
// Hand-traced 64-pin STM32 development board (RK-FW1 rev A), STM32F446RET6, top view.
// Units: viewBox 1500x2000, about 20.6 units per mm, header pitch 53.
// Light comes from the top-left; every shadow is offset down-right.
interface Props {
  power?: 'off' | 'on';
  idPrefix?: string;
  class?: string;
}
const { power = 'off', idPrefix = '', class: cls = '' } = Astro.props;
const p = idPrefix;
const u = (id: string) => `url(#${p}${id})`;
const h = (id: string) => `#${p}${id}`;

const P = 53;
const SILK = '#2a58a6';

// board outline: rounded top corners, lower edge with the chamfered notch
