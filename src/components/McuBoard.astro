// each part split into: two terminals (a, b) and the body between them
const split = ([, x, y, w, h]: Part) => {
  const v = h > w;
  const L = v ? h : w;
  const t = Math.round(L * 0.27);
  return v
    ? { v, a: [x, y, w, t], b: [x, y + h - t, w, t], body: [x, y + t, w, h - 2 * t] }
    : { v, a: [x, y, t, h], b: [x + w - t, y, t, h], body: [x + t, y, w - 2 * t, h] };
};
