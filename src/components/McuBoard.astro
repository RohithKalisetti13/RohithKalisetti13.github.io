// quad flat package legs: one transform per leg, the leg symbol points up from the body edge
const qfp = (cx: number, cy: number, body: number, n: number, pitch = 10.3) =>
  [0, 90, 180, 270].flatMap((a) =>
    Array.from({ length: n }, (_, i) => {
      const o = (i - (n - 1) / 2) * pitch;
      return `translate(${cx} ${cy}) rotate(${a}) translate(${o} ${-body / 2})`;
    }),
  );
const U5 = { cx: 694, cy: 1361, b: 208 };
const U2 = { cx: 750, cy: 453, b: 146 };
const u5Legs = qfp(U5.cx, U5.cy, U5.b, 16);
// soft land strip under each leg row, so the legs read as a row of pins, not a comb
const qfpBands = (c: { cx: number; cy: number; b: number }, n: number, pitch = 10.3) =>
  [0, 90, 180, 270].map((a) => ({ t: `translate(${c.cx} ${c.cy}) rotate(${a})`, x: -(n * pitch) / 2, y: -c.b / 2 - 38, w: n * pitch, hh: 38 }));
const u2Legs = qfp(U2.cx, U2.cy, U2.b, 12);

