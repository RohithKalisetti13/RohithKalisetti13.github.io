<style is:global>
  .mcu-board {
    display: block;
    width: 100%;
    height: auto;
  }
  /* power-on order: LD3 (5V), then LD1 (COM), then LD2 starts its 1 Hz blink */
  .mcu-board .led-on {
    opacity: 0;
    transition: opacity 160ms ease-out;
  }
  .mcu-board[data-power='on'] [data-led='ld3'] .led-on,
  .mcu-board[data-power='on'] [data-led='ld1'] .led-on,
  .mcu-board[data-power='on'] [data-led='ld2'] .led-on {
    opacity: 1;
  }
  .mcu-board[data-power='on'] [data-led='ld1'] .led-on {
    transition-delay: 260ms;
  }
  .mcu-board[data-power='on'] [data-led='ld2'] .led-on {
    /* first half of each period is dark, so LD2 comes on about 520 ms after power */
    animation: mcu-blink 1s steps(1, end) 20ms infinite backwards;
  }
  @keyframes mcu-blink {
    0% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mcu-board[data-power='on'] [data-led='ld2'] .led-on {
      animation: none;
    }
  }
  .mcu-board text {
    font-kerning: normal;
  }
</style>
