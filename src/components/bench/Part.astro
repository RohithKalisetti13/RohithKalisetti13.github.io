---
// The project parts on the bench, drawn from above in the unit frame of lib/parts.ts (10 units = one
// hole pitch), so header pins land on breadboard holes. Matte PCBs, one light from the top-left;
// the soft shadow under each part is set in CSS. Silkscreen carries part numbers only.
import { PART_BOX, type PartKind } from '../../lib/parts';

interface Props {
  kind: PartKind;
}
const { kind } = Astro.props;
const b = PART_BOX[kind];
const MONO = "'JetBrains Mono Variable', ui-monospace, monospace";
const SILK = '#efeee8';
const range = (n: number) => Array.from({ length: n }, (_, i) => i);
const pins = (xs: number[]) => xs.map((x) => ({ x }));
// 8x8 matrix: a hollow square, the edge of a filtered image
const edge = (r: number, c: number) => ((r === 2 || r === 5) && c >= 2 && c <= 5) || ((c === 2 || c === 5) && r >= 2 && r <= 5);
// 5x7 pixel seven for the OLED
const SEVEN = ['11111', '00001', '00010', '00100', '01000', '01000', '01000'];
---

<svg class="part" viewBox={`${b.x} ${b.y} ${b.w} ${b.h}`} data-kind={kind} aria-hidden="true" focusable="false" font-family={MONO}>
  <Fragment>
    {
      kind === 'msa311' && (
        <g>
          <rect x="28" y="-40" width="76" height="44" rx="4" fill="#1c1d20" />
          <path d="M30 2V-36Q30 -38 32 -38H100" fill="none" stroke="#34363b" stroke-width="0.8" />
          {[[33, -34], [99, -34], [33, -3], [99, -3]].map(([x, y]) => (
            <g>
              <circle cx={x} cy={y} r="3.8" fill="#b8954a" />
              <circle cx={x} cy={y} r="2.1" fill="#2b2824" />
            </g>
          ))}
          {[26.5, 96.5].map((x) => (
            <g>
              <rect x={x} y="-28" width="9" height="14" rx="0.8" fill="#e6e4dd" />
              <rect x={x + 2} y="-26" width="5" height="10" rx="0.4" fill="#c2bfb5" />
            </g>
          ))}
          <rect x="62.5" y="-25.5" width="7" height="7" rx="0.6" fill="#101012" />
          <circle cx="63.8" cy="-24.2" r="0.6" fill="#3c3d42" />
          <g fill="#c9b48a">
            <rect x="52" y="-24" width="3" height="1.6" />
            <rect x="52" y="-20" width="3" height="1.6" />
            <rect x="77" y="-24" width="3" height="1.6" />
          </g>
          <rect x="77" y="-20" width="3" height="1.6" fill="#2a2a2c" />
          <g class="ind">
            <circle cx="87.7" cy="-13.05" r="4.2" fill="url(#bd-ind-glow)" />
            <rect x="86" y="-14" width="3.4" height="1.9" rx="0.3" />
          </g>
          <text x="66" y="-31" font-size="6" font-weight="700" fill={SILK} text-anchor="middle">MSA311</text>
          <g font-size="2.7" fill={SILK} text-anchor="middle">
            {['VIN', '3Vo', 'GND', 'SCL', 'SDA', 'INT'].map((t, i) => (
              <text x={40 + i * 10} y="-5">{t}</text>
            ))}
          </g>
          {pins([40, 50, 60, 70, 80, 90]).map((p) => (
            <g>
              <circle cx={p.x} cy="0" r="2.5" fill="#c9a24a" />
              <circle cx={p.x} cy="0" r="1.1" fill="#5e4e24" />
            </g>
          ))}
        </g>
      )
    }
    {
      kind === 'wifi' && (
        <g>
          <rect x="24" y="-40" width="84" height="44" rx="3" fill="#24467a" />
          <path d="M26 2V-36Q26 -38 28 -38H104" fill="none" stroke="#3a5d92" stroke-width="0.8" />
          {[[30, -34], [102, -34]].map(([x, y]) => (
            <g>
              <circle cx={x} cy={y} r="3.4" fill="#b8954a" />
              <circle cx={x} cy={y} r="1.9" fill="#2b2824" />
            </g>
          ))}
          <rect x="40" y="-37" width="56" height="29" rx="1" fill="#17271f" />
          <g fill="#b8954a">
            {range(5).map((i) => (
              <>
                <rect x="40" y={-34 + i * 5.2} width="1.6" height="2.4" />
                <rect x="94.4" y={-34 + i * 5.2} width="1.6" height="2.4" />
              </>
            ))}
          </g>
          <rect x="43" y="-34.5" width="34" height="24" rx="1" fill="url(#bd-silver)" />
          <path d="M44 -11.5V-33.5H76" fill="none" stroke="#f4f5f6" stroke-width="0.6" opacity="0.8" />
          <path d="M76 -33.5V-11.5H44" fill="none" stroke="#8a8e92" stroke-width="0.6" />
          <text x="60" y="-24" font-size="4.6" font-weight="700" fill="#55595e" text-anchor="middle">WLAN</text>
          <text x="60" y="-18" font-size="2.9" fill="#55595e" text-anchor="middle">2.4G b/g/n</text>
          <path d="M80 -12V-33H83.2V-14H86.4V-33H89.6V-14H92.8V-33" fill="none" stroke="#c9a24a" stroke-width="1.3" stroke-linejoin="round" />
          <g class="ind">
            <circle cx="99.7" cy="-25.05" r="4.2" fill="url(#bd-ind-glow)" />
            <rect x="98" y="-26" width="3.4" height="1.9" rx="0.3" />
          </g>
          <g font-size="2.6" fill={SILK} text-anchor="middle">
            {['GND', 'V+', 'EN', 'RST', 'TX', 'RX', 'IO0', 'IO2'].map((t, i) => (
              <text x={30 + i * 10} y="-4">{t}</text>
            ))}
          </g>
          {pins(range(8).map((i) => 30 + i * 10)).map((p) => (
            <g>
              <circle cx={p.x} cy="0" r="2.4" fill="#c9a24a" />
              <circle cx={p.x} cy="0" r="1.1" fill="#5e4e24" />
            </g>
          ))}
        </g>
      )
    }
    {
      kind === 'crystal' && (
        <g>
          <g stroke="#a9aaa5" stroke-width="1.1" fill="none" stroke-linecap="round">
            <path d="M33 -14L30 0M39 -14L40 0" />
            <path d="M63 -8L60 0M67 -8L70 0" />
            <path d="M93 -14L90 0M99 -14L100 0" />
          </g>
          <g fill="#34302a">
            {[30, 40, 60, 70, 90, 100].map((x) => (
              <circle cx={x} cy="0" r="1.4" />
            ))}
          </g>
          {[36, 96].map((cx) => (
            <g>
              <circle cx={cx} cy="-17" r="7.6" fill="url(#bd-disc)" />
              <path d={`M${cx - 5} -20A6 6 0 0 1 ${cx - 1} -23`} fill="none" stroke="#f6c3a5" stroke-width="0.9" stroke-linecap="round" opacity="0.7" />
              <text x={cx} y="-15.4" font-size="4.6" font-weight="700" fill="#8a4a2c" text-anchor="middle">20</text>
            </g>
          ))}
          <rect x="60.5" y="-29" width="9" height="22" rx="4.2" fill="url(#bd-tube)" />
          <rect x="61.5" y="-9.5" width="7" height="2.6" rx="0.8" fill="#8f9397" />
          <text x="65" y="-18" font-size="3" fill="#5d6166" text-anchor="middle" transform="rotate(-90 65 -18)">32.768K</text>
        </g>
      )
    }
    {
      kind === 'adxl335' && (
        <g>
          <rect x="24" y="-40" width="72" height="44" rx="4" fill="#245d93" />
          <path d="M26 2V-36Q26 -38 28 -38H92" fill="none" stroke="#3b74a8" stroke-width="0.8" />
          {[[31, -33], [89, -33]].map(([x, y]) => (
            <g>
              <circle cx={x} cy={y} r="3.6" fill="#b8954a" />
              <circle cx={x} cy={y} r="2" fill="#2b2824" />
            </g>
          ))}
          <text x="60" y="-32" font-size="5.2" font-weight="700" fill={SILK} text-anchor="middle">ADXL335</text>
          <rect x="55" y="-26" width="10" height="10" rx="0.6" fill="#121214" />
          <circle cx="56.6" cy="-24.4" r="0.6" fill="#3c3d42" />
          <g stroke={SILK} stroke-width="0.7" fill="none">
            <path d="M48 -21H40M42 -23L40 -21L42 -19" />
            <path d="M73 -24V-16M71 -18L73 -16L75 -18" />
            <circle cx="81" cy="-24" r="2.2" />
          </g>
          <circle cx="81" cy="-24" r="0.6" fill={SILK} />
          <g class="ind">
            <circle cx="88.7" cy="-17.05" r="4.2" fill="url(#bd-ind-glow)" />
            <rect x="87" y="-18" width="3.4" height="1.9" rx="0.3" />
          </g>
          <g font-size="3" fill={SILK} text-anchor="middle">
            <text x="44" y="-24">X</text>
            <text x="77" y="-14">Y</text>
            <text x="86" y="-26">Z</text>
          </g>
          <g font-size="2.6" fill={SILK}>
            {['Vin', '3Vo', 'GND', 'Zout', 'Yout', 'Xout', 'Test'].map((t, i) => (
              <text x={30 + i * 10 + 0.9} y="-4.5" transform={`rotate(-90 ${30 + i * 10 + 0.9} -4.5)`}>{t}</text>
            ))}
          </g>
          {pins(range(7).map((i) => 30 + i * 10)).map((p) => (
            <g>
              <circle cx={p.x} cy="0" r="2.5" fill="#c9a24a" />
              <circle cx={p.x} cy="0" r="1.1" fill="#5e4e24" />
            </g>
          ))}
        </g>
      )
    }
    {
      kind === 'hcsr04' && (
        <g>
          <rect x="18" y="-40" width="96" height="44" rx="2" fill="#2b5b94" />
          <path d="M20 2V-38H112" fill="none" stroke="#3f71a8" stroke-width="0.8" />
          <rect x="60" y="-38.5" width="12" height="5" rx="2.2" fill="url(#bd-silver)" />
          {[40, 92].map((cx) => (
            <g>
              <circle cx={cx} cy="-19" r="17.2" fill="url(#bd-ring)" />
              <circle cx={cx} cy="-19" r="13.6" fill="#3e4146" />
              <g fill="none" stroke="#575b61" stroke-width="0.5">
                <circle cx={cx} cy="-19" r="11" />
                <circle cx={cx} cy="-19" r="8" />
                <circle cx={cx} cy="-19" r="5" />
              </g>
              <path d={`M${cx - 12} -26A14 14 0 0 1 ${cx - 6} -31.6`} fill="none" stroke="#fff" stroke-width="1.2" stroke-linecap="round" opacity="0.45" />
            </g>
          ))}
          <text x="66" y="-26" font-size="3.6" font-weight="700" fill={SILK} text-anchor="middle">HC-SR04</text>
          <g font-size="4" font-weight="700" fill={SILK} text-anchor="middle">
            <text x="23.5" y="-2">T</text>
            <text x="108.5" y="-2">R</text>
          </g>
          <g font-size="2.6" fill={SILK} text-anchor="middle">
            {['Vcc', 'Trig', 'Echo', 'Gnd'].map((t, i) => (
              <text x={50 + i * 10} y="-5">{t}</text>
            ))}
          </g>
          {pins([50, 60, 70, 80]).map((p) => (
            <g>
              <circle cx={p.x} cy="0" r="2.5" fill="#c9a24a" />
              <circle cx={p.x} cy="0" r="1.1" fill="#5e4e24" />
            </g>
          ))}
        </g>
      )
    }
    {
      kind === 'matrix' && (
        <g>
          <rect x="36" y="-4" width="60" height="48" rx="2.5" fill="#1f2d55" />
          <g font-size="2.8" fill={SILK} text-anchor="middle">
            {['+', '−', 'D', 'C'].map((t, i) => (
              <text x={50 + i * 10 + 3.6} y="1">{t}</text>
            ))}
          </g>
          {pins([50, 60, 70, 80]).map((p) => (
            <g>
              <circle cx={p.x} cy="0" r="2.4" fill="#c9a24a" />
              <circle cx={p.x} cy="0" r="1.1" fill="#5e4e24" />
            </g>
          ))}
          <rect x="44" y="4" width="44" height="40" rx="1" fill="#1a1b1e" />
          <path d="M45 43V5H87" fill="none" stroke="#34363b" stroke-width="0.6" />
          {range(64).map((i) => {
            const r = Math.floor(i / 8);
            const c = i % 8;
            return <circle class:list={['dot', { on: edge(r, c) }]} cx={48.5 + c * 5} cy={7.5 + r * 4.7} r="1.85" />;
          })}
          <text x="40" y="40" font-size="2.6" fill={SILK} text-anchor="middle" transform="rotate(-90 40 40)">8x8</text>
        </g>
      )
    }
    {
      kind === 'swd' && (
        <g>
          <rect x="32" y="-4" width="60" height="42" rx="3" fill="#1c1d20" />
          <path d="M34 36V-1Q34 -2 35 -2H90" fill="none" stroke="#34363b" stroke-width="0.8" />
          {pins([40, 50, 60, 70, 80]).map((p) => (
            <g>
              <circle cx={p.x} cy="0" r="2.4" fill="#c9a24a" />
              <circle cx={p.x} cy="0" r="1.1" fill="#5e4e24" />
            </g>
          ))}
          <g font-size="2.4" fill={SILK} text-anchor="middle">
            {['VCC', 'DIO', 'CLK', 'GND', 'RST'].map((t, i) => (
              <text x={40 + i * 10} y="6.4">{t}</text>
            ))}
          </g>
          <rect x="43" y="11" width="38" height="20" rx="1.2" fill="#111214" />
          <path d="M44 30V12H80" fill="none" stroke="#2c2d31" stroke-width="0.7" />
          <rect x="46" y="14" width="32" height="14" rx="0.6" fill="#050506" />
          <rect x="58" y="28" width="8" height="3" fill="#050506" />
          <g fill="#c9a24a">
            {range(10).map((i) => (
              <rect x={51.1 + (i % 5) * 5} y={i < 5 ? 16.6 : 21.6} width="1.8" height="1.8" />
            ))}
          </g>
          <path d="M44 9.2l1.6-2 1.6 2z" fill={SILK} />
          <text x="86" y="35" font-size="4" font-weight="700" fill={SILK} text-anchor="end">SWD</text>
        </g>
      )
    }
    {
      kind === 'oled' && (
        <g>
          <rect x="32" y="-4" width="68" height="48" rx="3" fill="#1f3a6b" />
          <path d="M34 42V-1Q34 -2 35 -2H98" fill="none" stroke="#33528a" stroke-width="0.8" />
          {[[37, 2], [95, 2], [37, 39], [95, 39]].map(([x, y]) => (
            <g>
              <circle cx={x} cy={y} r="2.8" fill="#b8954a" />
              <circle cx={x} cy={y} r="1.5" fill="#2b2824" />
            </g>
          ))}
          {pins([50, 60, 70, 80]).map((p) => (
            <g>
              <circle cx={p.x} cy="0" r="2.4" fill="#c9a24a" />
              <circle cx={p.x} cy="0" r="1.1" fill="#5e4e24" />
            </g>
          ))}
          <g font-size="2.4" fill={SILK} text-anchor="middle">
            {['GND', 'VCC', 'SCL', 'SDA'].map((t, i) => (
              <text x={50 + i * 10} y="6.2">{t}</text>
            ))}
          </g>
          <rect x="58" y="38" width="16" height="6" fill="#a8763c" />
          <rect x="36" y="8.5" width="60" height="30" rx="1" fill="#101317" />
          <rect x="40" y="11.5" width="52" height="22" fill="#030405" />
          <path d="M37 38V9.5H95" fill="none" stroke="#2a2f36" stroke-width="0.6" />
          <g class="px" fill="#d6ecff">
            {SEVEN.flatMap((row, r) =>
              [...row].map((v, c) => (v === '1' ? <rect x={59.5 + c * 2.6} y={13.4 + r * 2.6} width="2.3" height="2.3" /> : null)),
            )}
          </g>
        </g>
      )
    }
    {
      kind === 'camera' && (
        <g>
          <rect x="36" y="-4" width="60" height="48" rx="2" fill="#1f5a3d" />
          <path d="M38 42V-2H94" fill="none" stroke="#2e7350" stroke-width="0.8" />
          {[[41, 39], [91, 39], [41, 6], [91, 6]].map(([x, y]) => (
            <g>
              <circle cx={x} cy={y} r="2.6" fill="#b8954a" />
              <circle cx={x} cy={y} r="1.4" fill="#2b2824" />
            </g>
          ))}
          {pins([50, 60, 70, 80]).map((p) => (
            <g>
              <circle cx={p.x} cy="0" r="2.4" fill="#c9a24a" />
              <circle cx={p.x} cy="0" r="1.1" fill="#5e4e24" />
            </g>
          ))}
          <g font-size="2.4" fill={SILK} text-anchor="middle">
            {['3V3', 'GND', 'SDA', 'SCL'].map((t, i) => (
              <text x={50 + i * 10} y="6.2">{t}</text>
            ))}
          </g>
          <rect x="50" y="10" width="32" height="32" rx="2" fill="#17181a" />
          <path d="M51 41V11H81" fill="none" stroke="#2e3034" stroke-width="0.7" />
          <circle cx="66" cy="26" r="12.4" fill="#26272b" />
          <circle cx="66" cy="26" r="9.6" fill="#1b1c1f" stroke="#3a3c41" stroke-width="0.6" />
          <circle cx="66" cy="26" r="7" fill="url(#bd-glass)" />
          <circle cx="66" cy="26" r="3" fill="#06090d" />
          <ellipse cx="63" cy="22.8" rx="2.2" ry="1.4" fill="#fff" opacity="0.4" transform="rotate(-35 63 22.8)" />
          <text x="44" y="22" font-size="2.6" fill={SILK} text-anchor="middle" transform="rotate(-90 44 22)">CAM</text>
          <g class="ind">
            <circle cx="87.7" cy="20.95" r="4.2" fill="url(#bd-ind-glow)" />
            <rect x="86" y="20" width="3.4" height="1.9" rx="0.3" />
          </g>
        </g>
      )
    }
  </Fragment>
</svg>

<style>
  .part {
    display: block;
    overflow: visible;
    filter: drop-shadow(1.5px 2.5px 1.5px rgba(0, 0, 0, 0.32));
  }
  .dot {
    fill: #c9c6bd;
    transition: fill 250ms ease-out;
  }
  .dot.on {
    fill: #ecdcb4;
  }
  .px,
  .ind circle {
    transition: opacity 250ms ease-out;
  }
  .ind rect {
    fill: #ff5a3c;
    transition: fill 250ms ease-out;
  }
  /* board power off: screens, pixels and power LEDs go dark; the parts themselves stay */
  :global(html:has(.desk[data-power='off'])) .px,
  :global(html:has(.desk[data-power='off'])) .ind circle {
    opacity: 0;
  }
  :global(html:has(.desk[data-power='off'])) .dot {
    fill: #2c2d31;
  }
  :global(html:has(.desk[data-power='off'])) .ind rect {
    fill: #5a2a24;
  }
</style>
