---
// Flat top-down 830-point breadboard: cream ABS, square holes with their spring contacts showing,
// 63 columns, rows a-e and f-j over a centre channel, two power rails with red and blue lines.
// Light from the top-left; one soft drop shadow under the whole board (set in CSS).
import { BB_W, BB_H, COLS, PITCH, ROWS, GROOVE, RAIL_COLS, RAIL_LINES, colX, rowY } from '../../lib/breadboard';

const MONO = "'JetBrains Mono Variable', ui-monospace, monospace";
const R = 4;
// outline: rounded rectangle, a dovetail slot in each short edge and two small notches in each long edge
const W = BB_W;
const H = BB_H;
const outline =
  `M${R} 0H118V2.5H126V0H554V2.5H562V0H${W - R}Q${W} 0 ${W} ${R}` +
  `V91L${W - 5} 87.5V108.5L${W} 105V${H - R}Q${W} ${H} ${W - R} ${H}` +
  `H570V${H - 2.5}H562V${H}H126V${H - 2.5}H118V${H}H${R}Q0 ${H} 0 ${H - R}` +
  `V105L5 108.5V87.5L0 91V${R}Q0 0 ${R} 0Z`;
const nums = [1, ...Array.from({ length: 12 }, (_, i) => (i + 1) * 5)];
const groups = Array.from({ length: 10 }, (_, g) => RAIL_COLS[g * 5]);
const top = rowY('a') - PITCH / 2;
const bot = rowY('f') - PITCH / 2;
---

<svg class="bb-art" viewBox={`0 0 ${BB_W} ${BB_H}`} aria-hidden="true" focusable="false" font-family={MONO}>
  <defs>
    <linearGradient id="bb-abs" x1="0" y1="0" x2="0.35" y2="1">
      <stop offset="0" stop-color="#f6f3eb" />
      <stop offset="1" stop-color="#e7e2d4" />
    </linearGradient>
    <linearGradient id="bb-groove" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#cfc8b7" />
      <stop offset="0.35" stop-color="#e2dccd" />
      <stop offset="1" stop-color="#efebe1" />
    </linearGradient>
    <!-- one hole per 10x10 tile, centred: a dark square, the two spring leaves of its contact, a lit lower-right wall -->
    <pattern id="bb-hole" width={PITCH} height={PITCH} patternUnits="userSpaceOnUse">
      <rect x="2.6" y="2.6" width="4.8" height="4.8" rx="0.6" fill="#dcd6c7" />
      <rect x="3.1" y="3.1" width="3.8" height="3.8" rx="0.3" fill="#34302a" />
      <path d="M4 3.5V6.5M6 3.5V6.5" stroke="#858075" stroke-width="0.6" />
      <path d="M3.3 6.7H6.7V3.3" fill="none" stroke="#a29b8b" stroke-width="0.4" />
      <path d="M2.7 7.5H7.5V2.7" fill="none" stroke="#fffcf4" stroke-width="0.5" opacity="0.8" />
    </pattern>
  </defs>

  <path d={outline} fill="url(#bb-abs)" />
  <!-- bevel: lit top and left edges, shaded bottom and right -->
  <path d={`M1 ${BB_H - 6}V5Q1 1 5 1H${BB_W - 6}`} fill="none" stroke="#fffdf7" stroke-width="1.4" />
  <path d={`M${BB_W - 1} 6V${BB_H - 5}Q${BB_W - 1} ${BB_H - 1} ${BB_W - 5} ${BB_H - 1}H6`} fill="none" stroke="#cbc4b2" stroke-width="1.4" />

  <!-- centre channel -->
  <rect x="8" y={GROOVE.y0} width={BB_W - 16} height={GROOVE.y1 - GROOVE.y0} rx="1.5" fill="url(#bb-groove)" />
  <path d={`M8 ${GROOVE.y0 + 0.4}H${BB_W - 8}`} stroke="#bdb5a2" stroke-width="0.8" />

  <!-- rails -->
  <g stroke-width="1.3" stroke-linecap="round">
    <path d={`M22 ${RAIL_LINES.topRed}H${BB_W - 22}M22 ${RAIL_LINES.botRed}H${BB_W - 22}`} stroke="#c4483d" />
    <path d={`M22 ${RAIL_LINES.topBlue}H${BB_W - 22}M22 ${RAIL_LINES.botBlue}H${BB_W - 22}`} stroke="#3c6eaa" />
  </g>
  <g fill="#8a8373" font-size="5.5" text-anchor="middle">
    {
      [
        [RAIL_LINES.topRed + 2, '+'],
        [RAIL_LINES.topBlue + 2, '−'],
        [RAIL_LINES.botRed + 2, '+'],
        [RAIL_LINES.botBlue + 2, '−'],
      ].map(([y, t]) => (
        <>
          <text x="13" y={y}>{t}</text>
          <text x={BB_W - 13} y={y}>{t}</text>
        </>
      ))
    }
  </g>
  {
    groups.map((c) => (
      <>
        <rect x={colX(c) - 5} y="6" width={PITCH * 5} height={PITCH * 2} fill="url(#bb-hole)" />
        <rect x={colX(c) - 5} y="166" width={PITCH * 5} height={PITCH * 2} fill="url(#bb-hole)" />
      </>
    ))
  }

  <!-- terminal strips -->
  <rect x={colX(1) - 5} y={top} width={COLS * PITCH} height={PITCH * 5} fill="url(#bb-hole)" />
  <rect x={colX(1) - 5} y={bot} width={COLS * PITCH} height={PITCH * 5} fill="url(#bb-hole)" />

  <!-- moulded markings -->
  <g fill="#8a8373" font-size="4.4" text-anchor="middle">
    {
      nums.map((n) => (
        <>
          <text x={colX(n)} y="36.4">{n}</text>
          <text x={colX(n)} y="159.6">{n}</text>
        </>
      ))
    }
    {
      ROWS.map((r) => (
        <>
          <text x="17" y={rowY(r) + 1.6}>{r}</text>
          <text x={BB_W - 17} y={rowY(r) + 1.6}>{r}</text>
        </>
      ))
    }
  </g>
</svg>

<style>
  .bb-art {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(5px 9px 10px rgba(0, 0, 0, 0.28));
    user-select: none;
  }
  /* the same cream board under a dimmer lamp */
  :global(:root:not([data-theme='light'])) .bb-art {
    filter: drop-shadow(5px 9px 12px rgba(0, 0, 0, 0.5)) brightness(0.9);
  }
</style>
