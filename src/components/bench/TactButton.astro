---
// 6 mm tactile switch from above: black body, metal cover pins in the corners, a round cap.
// Legs sit on holes 20 units apart each way; the cap drops a pixel while pressed (CSS).
---

<svg class="tact" viewBox="-17 -17 34 34" aria-hidden="true" focusable="false">
  <rect x="-11.4" y="-10.4" width="26" height="26" rx="2" fill="#000" opacity="0.24" />
  <g fill="#b9bab6">
    <rect x="-11" y="-15.6" width="2" height="3" rx="0.4" />
    <rect x="9" y="-15.6" width="2" height="3" rx="0.4" />
    <rect x="-11" y="12.6" width="2" height="3" rx="0.4" />
    <rect x="9" y="12.6" width="2" height="3" rx="0.4" />
  </g>
  <rect x="-13" y="-13" width="26" height="26" rx="1.8" fill="#222327" />
  <path d="M-12 11.8V-11.2Q-12 -12 -11.2 -12H11.8" fill="none" stroke="#45464b" stroke-width="0.8" />
  <g fill="#3b3c41">
    <circle cx="-9.4" cy="-9.4" r="1.3" />
    <circle cx="9.4" cy="-9.4" r="1.3" />
    <circle cx="-9.4" cy="9.4" r="1.3" />
    <circle cx="9.4" cy="9.4" r="1.3" />
  </g>
  <circle r="8.6" fill="#18191c" />
  <g class="cap">
    <circle r="7.4" fill="url(#bd-cap)" />
    <path d="M-5 -2.6A5.6 5.6 0 0 1 -1.6 -5.4" fill="none" stroke="#6a6c72" stroke-width="0.9" stroke-linecap="round" opacity="0.7" />
  </g>
</svg>

<style>
  .tact {
    display: block;
    overflow: visible;
  }
  .cap {
    transition:
      transform 90ms ease-out,
      filter 90ms ease-out;
  }
</style>
