---
// The editor on the laptop screen. main.c is About, written as C; terminal is Contact, as a serial
// session with real links. In the stacked layout both panels show one after the other.
import { Code } from 'astro:components';
import type { ShikiTransformer, ThemeRegistration } from 'shiki';
// @ts-ignore: node types are not installed; this runs at build time only
import { statSync } from 'node:fs';
import site from '../content/site.json';

// draft copy: only confirmed facts
const mainC = `/*
 * main.c - about
 *
 * Firmware engineer. I like knowing what the machine is actually
 * doing from the inside, not just what the comment says it's doing.
 *
 * I work on: bare-metal C, C++, real-time systems and embedded Linux,
 *            from registers up to the OS.
 * Earlier:   firmware engineering intern at Mill, teaching assistant
 *            for GPU and microcontroller courses, reverse-engineering
 *            research.
 * Lately:    Linux kernel drivers and GPU kernel optimization.
 * Off the bench: cricket, Lego, movies, die-cast cars.
 */

#include "about.h"

static const struct engineer rohith = {
    .name     = "Rohith Kalisetti",
    .role     = "Embedded Firmware Engineer",
    .location = "SF Bay Area, CA (open to relocation)",
    .degree   = "M.S. Computer Engineering",
    .school   = "George Mason University",
    .grad     = "May 2025",
};

/* experience, newest first */
static const struct role history[] = {
    {
        .org   = "Mill Industries",
        .work  = "embedded firmware",
    },
    {
        .org   = "George Mason University",
        .work1 = "teaching: GPU and microcontroller labs",
        .work2 = "research: embedded and reverse-engineering topics",
    },
};

int main(void)
{
    about_print(&rohith);
    for (size_t i = 0; i < ARRAY_SIZE(history); i++)
        role_print(&history[i]);
    return 0;
}`;

const color = (v: string) => ({ foreground: `var(--syn-${v})` });
const theme: ThemeRegistration = {
  name: 'tokens',
  type: 'dark',
  colors: { 'editor.background': 'var(--ide-bg)', 'editor.foreground': 'var(--syn-fg)' },
  tokenColors: [
    { scope: ['comment', 'punctuation.definition.comment'], settings: color('com') },
    { scope: ['keyword', 'storage', 'keyword.control', 'meta.preprocessor'], settings: color('kw') },
    { scope: ['entity.name.type', 'support.type', 'storage.type.built-in'], settings: color('type') },
    { scope: ['entity.name.function', 'support.function', 'entity.name.label'], settings: color('fn') },
    { scope: ['string', 'punctuation.definition.string'], settings: color('str') },
    { scope: ['constant.numeric', 'constant.language', 'constant'], settings: color('num') },
    { scope: ['punctuation', 'keyword.operator'], settings: color('punc') },
    { scope: ['variable', 'entity.name.variable'], settings: color('fg') },
  ],
};
const numbered: ShikiTransformer = {
  line(node) {
    node.properties.class = 'line';
  },
};

// optional portrait: rendered only when public/photo.png exists
const photo = Object.keys(import.meta.glob('../../public/photo.png')).length ? '/photo.png' : null;
const resumeBytes = statSync('public/rohith_resume.pdf').size;
const CONTACT = [
  { key: 'email', label: site.email, href: `mailto:${site.email}` },
  { key: 'linkedin', label: site.linkedin, href: site.linkedin },
  { key: 'github', label: site.github, href: site.github },
];
---

<div class="ide" data-ide>
  <div class="chrome">
    <div class="dots">
      <button type="button" class="dot-close" data-zoom-out aria-label="Close laptop"><i></i></button>
      <i class="dot-y" aria-hidden="true"></i>
      <i class="dot-g" aria-hidden="true"></i>
    </div>
    <div class="tabs" role="tablist" aria-label="About and contact">
      <button type="button" role="tab" id="ide-tab-about" data-tab="about" aria-controls="ide-about" aria-selected="true" tabindex="0">main.c</button>
      <button type="button" role="tab" id="ide-tab-contact" data-tab="contact" aria-controls="contact" aria-selected="false" tabindex="-1">terminal</button>
    </div>
  </div>

  <section class="panel" role="tabpanel" id="ide-about" aria-labelledby="ide-tab-about" tabindex="0" data-lenis-prevent>
    <h3 class="sr-only">About</h3>
    {photo && <img class="photo" src={photo} alt="Portrait of Rohith Kalisetti" width="150" height="200" loading="eager" decoding="async" />}
    <Code code={mainC} lang="c" theme={theme} transformers={[numbered]} />
  </section>

  <section class="panel term" role="tabpanel" id="contact" aria-labelledby="ide-tab-contact" tabindex="0" data-lenis-prevent>
    <h3 class="sr-only">Contact</h3>
    <ul class="sr-only">
      {CONTACT.map((c) => <li>{c.key}: {c.label}</li>)}
      <li>resume: {site.resumeName}</li>
    </ul>
    <pre class="serial" data-term>
<span class="ln"><span class="prompt">rohith@rk-fw:~$ </span><span class="cmd" data-type="whoami">whoami</span>
</span><span class="out">rohith (embedded firmware engineer, SF Bay Area)
</span><span class="ln"><span class="prompt">rohith@rk-fw:~$ </span><span class="cmd" data-type="cat contact.txt">cat contact.txt</span>
</span><span class="out">{CONTACT.map((c) => (<Fragment><span class="key">{c.key.padEnd(10)}</span><a href={c.href} {...(c.key === 'email' ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>{c.label.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '')}</a>{'\n'}</Fragment>))}</span><span class="ln"><span class="prompt">rohith@rk-fw:~$ </span><span class="cmd" data-type="ls -l docs/">ls -l docs/</span>
</span><span class="out">-rw-r--r-- 1 rohith rohith {resumeBytes} <a href={site.resume} target="_blank" rel="noopener noreferrer">resume.pdf</a>
</span><span class="ln"><span class="prompt">rohith@rk-fw:~$ </span><span class="cursor" aria-hidden="true"></span></span></pre>
  </section>

  <p class="status mono" aria-hidden="true">uart0 · 115200 8N1 · UTF-8</p>
</div>

<script>
  // tabs: click, arrows, Home and End; bound once per IDE element
  const init = () => {
    document.querySelectorAll<HTMLElement>('[data-ide]').forEach((ide) => {
      if (ide.dataset.bound) return;
      ide.dataset.bound = '1';
      const tabs = [...ide.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const select = (next: HTMLButtonElement, focus = true) => {
        tabs.forEach((t) => {
          const on = t === next;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          const panel = document.getElementById(t.getAttribute('aria-controls')!);
          if (panel) panel.hidden = !on;
        });
        if (focus) next.focus();
      };
      select(tabs[0], false);
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t));
        t.addEventListener('keydown', (e) => {
          const n = tabs.length;
          const to =
            e.key === 'ArrowRight' ? (i + 1) % n
            : e.key === 'ArrowLeft' ? (i - 1 + n) % n
            : e.key === 'Home' ? 0
            : e.key === 'End' ? n - 1
            : -1;
          if (to < 0) return;
          e.preventDefault();
          select(tabs[to]);
        });
      });
      // the laptop picks a tab when it opens
      ide.addEventListener('rk:tab', (e) => {
        const t = tabs.find((x) => x.dataset.tab === (e as CustomEvent<string>).detail);
        if (t) select(t);
      });
    });
  };
  // the terminal types its commands the first time it is shown; later visits keep the finished session
  const typeTerm = () => {
    const term = document.querySelector<HTMLElement>('[data-term]');
    if (!term || term.dataset.bound) return;
    term.dataset.bound = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const panel = term.closest<HTMLElement>('.panel')!;
    let started = false;
    const io = new IntersectionObserver((es) => {
      if (started || !es.some((e) => e.isIntersecting)) return;
      started = true;
      io.disconnect();
      const cmds = [...term.querySelectorAll<HTMLElement>('.cmd')];
      const outs = [...term.querySelectorAll<HTMLElement>('.out')];
      const cursor = term.querySelector<HTMLElement>('.cursor')!;
      const last = cursor.parentElement!;
      cmds.forEach((c) => (c.textContent = ''));
      outs.forEach((o) => (o.hidden = true));
      term.querySelectorAll<HTMLElement>('.ln').forEach((l, i) => i > 0 && (l.hidden = true));
      const lines = [...term.querySelectorAll<HTMLElement>('.ln')];
      let k = 0;
      const next = () => {
        if (k >= cmds.length) return;
        const cmd = cmds[k];
        const text = cmd.dataset.type!;
        const ln = lines[k];
        ln.hidden = false;
        cmd.after(cursor);
        let i = 0;
        const tick = () => {
          cmd.textContent = text.slice(0, ++i);
          if (i < text.length) return void setTimeout(tick, 25);
          outs[k].hidden = false;
          k++;
          if (k < cmds.length) { lines[k].hidden = false; setTimeout(next, 25); }
          else { lines[k].hidden = false; lines[k].append(cursor); }
        };
        setTimeout(tick, 25);
      };
      next();
    });
    io.observe(panel);
  };
  document.addEventListener('astro:page-load', typeTerm);
  typeTerm();
  document.addEventListener('astro:after-swap', init);
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .ide {
    --code-fs: 0.8125rem;
    --pad: var(--s-2);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 6px;
    background: var(--ide-bg);
    color: var(--syn-fg);
  }
  .chrome {
    position: relative;
    display: flex;
    flex: none;
    align-items: end;
    gap: var(--s-2);
    padding: 8px 8px 0 var(--s-2);
    background: var(--ide-chrome);
    border-bottom: 1px solid var(--line);
  }
  /* macOS-style window controls; the red one closes the laptop and is a 24px target around a 10px dot */
  .dots {
    --tl-r: #c0584f;
    --tl-y: #b8923a;
    --tl-g: #5a9a6a;
    display: flex;
    align-items: center;
    gap: 6px;
    align-self: center;
    padding-bottom: 8px;
  }
  :global(:root[data-theme='light']) .dots {
    --tl-r: #b8433b;
    --tl-y: #96701a;
    --tl-g: #3a7d4d;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dot-y {
    background: var(--tl-y);
  }
  .dot-g {
    background: var(--tl-g);
  }
  .dot-close {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    margin: -7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    /* only the dot shows until the laptop is open: nothing to focus or press on the stacked page */
    visibility: hidden;
  }
  .dot-close i {
    visibility: visible;
    display: grid;
    place-items: center;
    background: var(--tl-r);
    pointer-events: none;
  }
  .dot-close i::after {
    content: '';
    width: 6px;
    height: 6px;
    opacity: 0;
    background:
      linear-gradient(45deg, transparent 43%, #120201 43% 57%, transparent 57%),
      linear-gradient(-45deg, transparent 43%, #120201 43% 57%, transparent 57%);
    transition: opacity var(--t-fast) var(--ease);
  }
  :global(html[data-zoom='in']) .dot-close {
    visibility: visible;
  }
  :global(html[data-zoom='in']) .dots:hover .dot-close i::after,
  :global(html[data-zoom='in']) .dots:focus-within .dot-close i::after {
    opacity: 1;
  }
  .dot-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .tabs {
    display: flex;
    gap: 2px;
    margin-right: auto;
  }
  [role='tab'] {
    min-height: 32px;
    padding: 0 var(--s-2);
    border: 1px solid transparent;
    border-bottom: 0;
    border-radius: var(--r-1) var(--r-1) 0 0;
    background: transparent;
    color: var(--muted);
    font: var(--fs-label-lg) var(--font-mono);
    cursor: pointer;
    transition:
      color var(--t-fast) var(--ease),
      background var(--t-fast) var(--ease);
  }
  [role='tab']:hover {
    color: var(--text);
  }
  [role='tab'][aria-selected='true'] {
    position: relative;
    top: 1px;
    background: var(--ide-bg);
    border-color: var(--line);
    color: var(--text);
    box-shadow: inset 0 2px 0 var(--accent);
  }
  [role='tab']:focus-visible,
  .panel:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .panel {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
  }
  .panel[hidden] {
    display: none;
  }
  /* laptop: pinned top right of the code; widest of lines 1 to 14 is about 600px, the 1024 pane leaves 140px */
  .photo {
    position: absolute;
    top: 12px;
    right: 12px;
    width: clamp(120px, 10.4vw, 180px);
    height: auto;
    aspect-ratio: 3 / 4;
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    object-fit: cover;
    object-position: 50% 15%;
    /* head and shoulders of the 720x960 source: x 20 to 420, y 310 to 843 */
  }
  /* stacked layout: above the text, left aligned */
  :global(html:not(.world)) .photo {
    position: static;
    display: block;
    width: 120px;
    margin: var(--pad) var(--pad) 0;
  }
  .panel :global(pre) {
    margin: 0;
    padding: var(--pad);
    background: transparent !important;
    font: var(--code-fs) / 1.55 var(--font-mono);
    tab-size: 4;
  }
  .panel :global(code) {
    counter-reset: ln;
    font: inherit;
  }
  .panel :global(.line) {
    counter-increment: ln;
  }
  .panel :global(.line)::before {
    content: counter(ln);
    display: inline-block;
    width: 2.5ch;
    margin-right: 2ch;
    text-align: right;
    color: var(--syn-ln);
    user-select: none;
  }
  .serial {
    color: var(--syn-fg);
    white-space: pre-wrap;
  }
  .dim {
    color: var(--syn-com);
  }
  .ok {
    color: var(--syn-str);
  }
  .prompt {
    color: var(--syn-kw);
  }
  .serial {
    line-height: 1.8;
  }
  .out[hidden],
  .ln[hidden] {
    display: none;
  }
  .key {
    color: var(--syn-type);
  }
  .serial a {
    color: var(--syn-str);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .serial a:hover {
    color: var(--text);
  }
  .serial a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1.06s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .status {
    flex: none;
    padding: 4px var(--s-2);
    border-top: 1px solid var(--line);
    background: var(--ide-chrome);
    color: var(--muted);
    font-size: var(--fs-label);
  }

  /* stacked layout: About then Contact, no tabs */
  :global(html:not(.world)) .ide {
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--r-3);
  }
  :global(html:not(.world)) .tabs {
    visibility: hidden;
  }
  :global(html:not(.world)) .panel[hidden] {
    display: block;
  }
  :global(html:not(.world)) .panel :global(pre) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  :global(html:not(.world)) .term {
    border-top: 1px solid var(--line);
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
