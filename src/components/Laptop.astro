---
// Open laptop lying on the desk, top view, lid folded flat above the deck. Same light as the board:
// soft from the top-left, shadows offset down-right, matte finishes. Units: viewBox 1080x1300,
// the chassis spans x 0-1000 and the USB plug sticks out of the right side.
// The screen holds the IDE as live HTML: a dim preview on the desk, full size once zoomed in.
import IdeWindow from './IdeWindow.astro';

const SCREEN = { x: 52, y: 52, w: 896, h: 516 };
const VB = { w: 1080, h: 1300 };
const pct = (v: number, of: number) => `${+((v / of) * 100).toFixed(4)}%`;
const PORT = { x: 1078, y: 740 };

// keyboard: a half-height function row, then five rows with the wide keys where a real board has them;
// each key carries its legend, set small and dim like a real keycap
type Key = [number, string];
const k1 = (t: string): Key[] => [...t].map((c) => [1, c]);
const ROWS: Key[][] = [
  [[1.4, 'esc'], ...Array.from({ length: 12 }, (_, i): Key => [1, `F${i + 1}`]), [1, '']],
  [[1, '`'], ...k1('1234567890-='), [1.6, 'delete']],
  [[1.6, 'tab'], ...k1('QWERTYUIOP[]\\')],
  [[1.9, 'caps lock'], ...k1("ASDFGHJKL;'"), [1.7, 'return']],
  [[2.4, 'shift'], ...k1('ZXCVBNM,./'), [2.4, 'shift']],
  [[1, 'fn'], [1, 'control'], [1, 'option'], [1.3, 'command'], [5.6, ''], [1.3, 'command'], [1, 'option'], [1, '‹'], [1, '›']],
];
const KB = { x: 92, y: 704, w: 816, gap: 7, h: 50, fh: 28 };
const keys = ROWS.flatMap((row, r) => {
  const total = row.reduce((a, [span]) => a + span, 0);
  const unit = (KB.w - KB.gap * (row.length - 1)) / total;
  const y = r === 0 ? KB.y : KB.y + KB.fh + KB.gap + (r - 1) * (KB.h + KB.gap);
  const h = r === 0 ? KB.fh : KB.h;
  let x = KB.x;
  return row.map(([span, t]) => {
    const k = { x, y, w: span * unit, h, t, word: t.length > 1 && !/^F\d/.test(t) };
    x += span * unit + KB.gap;
    return k;
  });
});
const FONT = "'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif";
---

<div class="laptop">
  <svg class="lap-art" viewBox={`0 0 ${VB.w} ${VB.h}`} aria-hidden="true" focusable="false" font-family={FONT}>
    <defs>
      <linearGradient id="lap-alu" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#80848a" />
        <stop offset=".5" stop-color="#686c72" />
        <stop offset="1" stop-color="#585c61" />
      </linearGradient>
      <linearGradient id="lap-pad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#73777d" />
        <stop offset="1" stop-color="#62666b" />
      </linearGradient>
      <linearGradient id="lap-hinge" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#16171a" />
        <stop offset=".6" stop-color="#2b2d31" />
        <stop offset="1" stop-color="#46494e" />
      </linearGradient>
      <linearGradient id="lap-key" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1d1e21" />
        <stop offset="1" stop-color="#121315" />
      </linearGradient>
      <pattern id="lap-grille" width="8" height="8" patternUnits="userSpaceOnUse">
        <circle cx="4" cy="4" r="1.5" fill="#2e3034" />
        <circle cx="3.6" cy="3.6" r="0.6" fill="#8a8e94" opacity=".3" />
      </pattern>
    </defs>

    <!-- shadows, down and to the right -->
    <rect x="26" y="34" width="1000" height="1262" rx="34" fill="#000" opacity=".3" />
    <rect x="12" y="16" width="1000" height="1262" rx="32" fill="#000" opacity=".25" />

    <!-- USB plug in the right-hand port; the cable from the board meets it -->
    <rect x="996" y="724" width="70" height="32" rx="7" fill="#000" opacity=".3" transform="translate(6 8)" />
    <rect x="996" y="724" width="70" height="32" rx="7" fill="#1b1c1f" />
    <rect x="1060" y="728" width="22" height="24" rx="4" fill="#141518" />
    <path d="M1000 727H1060" stroke="#fff" stroke-width="2" opacity=".14" />

    <!-- lid, folded open: aluminium rim, thin black bezel -->
    <rect x="0" y="0" width="1000" height="626" rx="30" fill="url(#lap-alu)" />
    <path d="M4 600V30Q4 4 30 4H970" stroke="#fff" stroke-width="3" fill="none" opacity=".18" />
    <rect x="14" y="14" width="972" height="598" rx="20" fill="#0a0b0c" />
    <path d="M18 600V34Q18 18 34 18H966" stroke="#fff" stroke-width="1.5" fill="none" opacity=".06" />
    <rect x={SCREEN.x} y={SCREEN.y} width={SCREEN.w} height={SCREEN.h} rx="4" fill="#0d1512" />
    <circle cx="500" cy="33" r="3.5" fill="#1a1d21" />

    <!-- hinge, with the shadow it throws on the deck -->
    <rect x="70" y="616" width="860" height="30" rx="8" fill="url(#lap-hinge)" />
    <path d="M78 620H922" stroke="#fff" stroke-width="1.5" opacity=".08" />

    <!-- deck -->
    <rect x="0" y="638" width="1000" height="640" rx="30" fill="url(#lap-alu)" />
    <path d="M4 1250V668Q4 642 30 642H970" stroke="#fff" stroke-width="3" fill="none" opacity=".14" />
    <rect x="0" y="638" width="1000" height="22" fill="#000" opacity=".12" />
    <path d="M70 660H930" stroke="#000" stroke-width="10" opacity=".08" />

    <!-- speaker grilles either side of the keyboard -->
    <rect x="30" y="704" width="44" height="325" rx="6" fill="url(#lap-grille)" />
    <rect x="926" y="704" width="44" height="325" rx="6" fill="url(#lap-grille)" />

    <!-- keyboard well and keycaps -->
    <rect x="84" y="696" width="832" height="341" rx="12" fill="#25272b" />
    <path d="M86 1032V708Q86 698 96 698H912" stroke="#000" stroke-width="2.5" fill="none" opacity=".35" />
    {
      keys.map((k) => (
        <g>
          <rect x={k.x + 1.2} y={k.y + 2.2} width={k.w} height={k.h} rx="6" fill="#000" opacity=".4" />
          <rect x={k.x} y={k.y} width={k.w} height={k.h} rx="6" fill="url(#lap-key)" />
          <path d={`M${k.x + 3} ${k.y + k.h - 6}V${k.y + 6}Q${k.x + 3} ${k.y + 2} ${k.x + 7} ${k.y + 2}H${k.x + k.w - 6}`} stroke="#fff" stroke-width="1.2" fill="none" opacity=".08" />
          {k.t &&
            (k.word ? (
              <text x={k.x + 8} y={k.y + k.h - 9} font-size="10.5" fill="#9a9ea4" opacity=".75">
                {k.t}
              </text>
            ) : (
              <text x={k.x + k.w / 2} y={k.y + k.h / 2 + (k.h > 40 ? 5.5 : 4)} font-size={k.h > 40 ? 16 : 10} fill="#9a9ea4" opacity=".75" text-anchor="middle">
                {k.t}
              </text>
            ))}
        </g>
      ))
    }

    <!-- trackpad: one wide glass plate, a hair lower than the deck -->
    <rect x="288" y="1064" width="424" height="190" rx="16" fill="#000" opacity=".16" transform="translate(2 3)" />
    <rect x="288" y="1064" width="424" height="190" rx="16" fill="url(#lap-pad)" />
    <rect x="288.75" y="1064.75" width="422.5" height="188.5" rx="15.5" fill="none" stroke="#45484d" stroke-width="1.5" />
    <path d="M292 1246V1080Q292 1068 304 1068H696" stroke="#fff" stroke-width="1.5" fill="none" opacity=".14" />
    <!-- thumb notch in the front lip -->
    <path d="M440 1277Q500 1268 560 1277" stroke="#3e4146" stroke-width="3" fill="none" />
    <!-- port slot on the left side -->
    <rect x="-3" y="728" width="7" height="24" rx="2" fill="#1b1c1f" />
  </svg>

  <!-- zoomed in, this fills the viewport behind the screen and hides the laptop body -->
  <span class="veil" aria-hidden="true"></span>

  <!-- the live screen, sized to the painted one -->
  <div
    class="screen"
    style={`left:${pct(SCREEN.x, VB.w)};top:${pct(SCREEN.y, VB.h)};width:${pct(SCREEN.w, VB.w)};height:${pct(SCREEN.h, VB.h)}`}
  >
    <IdeWindow />
    <span class="glare" aria-hidden="true"></span>
  </div>

  <button type="button" class="lap-open" aria-label="Open the laptop: about and contact" aria-expanded="false" aria-controls="ide-about">
    <span class="lap-hint mono" aria-hidden="true">Open</span>
  </button>
  <span class="usb-port" aria-hidden="true" style={`left:${pct(PORT.x, VB.w)};top:${pct(PORT.y, VB.h)}`}></span>
</div>

<script>
  const root = document.documentElement;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const MS = 600;
  const EASE = 'cubic-bezier(0.2, 0.7, 0.2, 1)';

  let ac: AbortController | null = null;
  document.addEventListener('astro:before-swap', () => {
    ac?.abort();
    ac = null;
    delete root.dataset.zoom;
  });

  const init = () => {
    const lap = document.querySelector<HTMLElement>('.laptop');
    const world = lap?.closest<HTMLElement>('[data-world]');
    if (!lap || !world || lap.dataset.bound) return;
    lap.dataset.bound = '1';
    ac?.abort();
    ac = new AbortController();
    const signal = ac.signal;
    const screen = lap.querySelector<HTMLElement>('.screen')!;
    const ide = lap.querySelector<HTMLElement>('[data-ide]')!;
    const open = lap.querySelector<HTMLButtonElement>('.lap-open')!;
    const lock = (on: boolean) => window.dispatchEvent(new CustomEvent('rk:scroll-lock', { detail: on }));
    const zoomed = () => root.dataset.zoom === 'in';
    // on the desk the screen is a preview only; it takes input once zoomed
    const preview = () => (screen.inert = root.classList.contains('world') && !zoomed());
    preview();

    // FLIP on the screen alone: only its transform moves (translate and scale, from the painted
    // screen to the whole viewport under the nav); the veil fades in behind it and the laptop body
    // goes with it. No width, height or layout is animated.
    const veil = lap.querySelector<HTMLElement>('.veil')!;
    let anim: Animation | null = null;
    const flip = (to: string, done?: () => void, start?: string) => {
      const from = start ?? getComputedStyle(screen).transform;
      anim?.cancel();
      anim = null;
      screen.style.transform = to;
      if (reduced.matches || from === to) {
        done?.();
        return;
      }
      screen.style.willChange = 'transform';
      const a = screen.animate([{ transform: from }, { transform: to }], { duration: MS, easing: EASE });
      anim = a;
      a.onfinish = () => {
        if (anim !== a) return;
        anim = null;
        screen.style.willChange = '';
        done?.();
      };
    };
    // the veil covers exactly the viewport under the nav, so it never stretches the page
    const cover = () => {
      const nav = document.querySelector<HTMLElement>('.nav')?.offsetHeight ?? 52;
      const l = lap.getBoundingClientRect();
      Object.assign(veil.style, {
        left: `${-l.left}px`,
        top: `${nav - l.top}px`,
        width: `${document.documentElement.clientWidth}px`,
        height: `${window.innerHeight - nav}px`,
      });
    };

    const zoomIn = (tab: 'about' | 'contact' = 'about') => {
      if (!root.classList.contains('world') || document.querySelector('dialog[open]')) return;
      ide.dispatchEvent(new CustomEvent('rk:tab', { detail: tab }));
      if (zoomed()) return;
      root.dataset.zoom = 'in';
      lock(true);
      preview();
      open.setAttribute('aria-expanded', 'true');
      // measure only once the page has taken its locked layout, from the screen as it rests
      const start = getComputedStyle(screen).transform;
      anim?.cancel();
      screen.style.transform = 'none';
      void screen.offsetWidth;
      cover();
      const nav = document.querySelector<HTMLElement>('.nav')?.offsetHeight ?? 52;
      const vw = document.documentElement.clientWidth;
      const vh = window.innerHeight - nav;
      const r = screen.getBoundingClientRect();
      const s = Math.min(vw / r.width, vh / r.height);
      const to = `translate(${(vw - r.width * s) / 2 - r.left}px, ${nav + (vh - r.height * s) / 2 - r.top}px) scale(${s})`;
      flip(to, () => ide.querySelector<HTMLElement>('[role="tab"][aria-selected="true"]')?.focus({ preventScroll: true }), start);
    };
    const zoomOut = () => {
      if (!zoomed()) return;
      delete root.dataset.zoom;
      open.setAttribute('aria-expanded', 'false');
      preview();
      flip('none', () => {
        screen.style.transform = '';
        lock(false);
        window.dispatchEvent(new Event('rk:world-moved'));
      });
      open.focus({ preventScroll: true });
    };

    open.addEventListener('click', () => zoomIn('about'));
    // on the desk the screen is inert under the open button, so a vertical wheel over it scrolls the
    // shown pane first and the page once the pane is at its end
    open.addEventListener(
      'wheel',
      (e) => {
        if (zoomed() || e.ctrlKey || Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
        const r = screen.getBoundingClientRect();
        if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) return;
        const pane = ide.querySelector<HTMLElement>('.panel:not([hidden])');
        if (!pane) return;
        const dy = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaMode === 2 ? e.deltaY * pane.clientHeight : e.deltaY;
        const end = pane.scrollHeight - pane.clientHeight;
        if (dy < 0 ? pane.scrollTop <= 0 : pane.scrollTop >= end - 1) return;
        e.preventDefault();
        pane.scrollTop += dy;
      },
      { passive: false, signal },
    );
    window.addEventListener('rk:zoom-out', zoomOut, { signal });
    lap.querySelector('[data-zoom-out]')!.addEventListener('click', zoomOut);
    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && zoomed()) {
          e.preventDefault();
          zoomOut();
        }
      },
      { signal },
    );
    // the Contact pill and #contact open the terminal once the camera has arrived
    window.addEventListener(
      'rk:laptop',
      (e) => {
        if ((e as CustomEvent<string>).detail !== 'contact') return;
        if (root.dataset.station === 'left' && !world.classList.contains('moving')) return zoomIn('contact');
        window.addEventListener('rk:world-moved', () => zoomIn('contact'), { once: true, signal });
      },
      { signal },
    );
    // a layout switch to the stack drops the zoom
    window.matchMedia('(min-width: 1024px)').addEventListener(
      'change',
      () => {
        if (zoomed()) {
          delete root.dataset.zoom;
          anim?.cancel();
          anim = null;
          screen.style.transform = '';
          screen.style.willChange = '';
          lock(false);
        }
        preview();
      },
      { signal },
    );
    window.addEventListener('resize', () => zoomed() && zoomOut(), { signal });
  };
  document.addEventListener('astro:after-swap', init);
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .laptop {
    position: relative;
    width: min(1000px, 70cqw);
    aspect-ratio: 1080 / 1300;
    margin-inline: auto;
  }
  .lap-art {
    display: block;
    width: 100%;
    height: 100%;
  }
  .screen {
    position: absolute;
    overflow: hidden;
    border-radius: 3px;
    transform-origin: 0 0;
  }
  .veil {
    position: absolute;
    background: var(--ide-bg);
    opacity: 0;
    pointer-events: none;
    transition: opacity 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(html[data-zoom='in']) .veil {
    opacity: 1;
  }
  /* on the desk: a dim preview behind glass. The editor's own brightness joins in once the screen
     is 60% of the way up (240 ms of 600), and leads on the way back */
  .screen > :global(.ide) {
    transition: opacity 240ms var(--ease);
  }
  :global(html[data-zoom='in']) .screen > :global(.ide) {
    transition-delay: 360ms;
  }
  /* dim, but still readable at 4.5:1; the light theme's pale editor cannot dim and keep that */
  :global(html.world[data-theme='dark']:not([data-zoom='in'])) .screen > :global(.ide) {
    opacity: 0.86;
  }
  .glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(115deg, rgba(255, 255, 255, 0.06), transparent 38%);
    transition: opacity 400ms var(--ease);
  }
  :global(html[data-zoom='in']) .glare {
    opacity: 0;
  }
  .lap-open {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: start center;
    padding: 0;
    border: 0;
    border-radius: 3%;
    background: none;
    cursor: zoom-in;
  }
  .lap-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  .lap-hint {
    margin-top: 51%;
    padding: 2px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--board) 90%, transparent);
    color: var(--text);
    font-size: var(--fs-label);
    opacity: 0;
    transition: opacity var(--t-fast) var(--ease);
  }
  .lap-open:hover .lap-hint,
  .lap-open:focus-visible .lap-hint {
    opacity: 1;
  }
  :global(html[data-zoom='in']) .lap-open {
    display: none;
  }
  .usb-port {
    position: absolute;
    width: 2px;
    height: 2px;
    margin: -1px 0 0 -1px;
  }

  /* stacked layout: no laptop, just the editor in the flow */
  :global(html:not(.world)) .laptop {
    width: auto;
    aspect-ratio: auto;
  }
  :global(html:not(.world)) .lap-art,
  :global(html:not(.world)) .lap-open,
  :global(html:not(.world)) .glare {
    display: none;
  }
  :global(html:not(.world)) .screen {
    position: static;
    width: auto !important;
    height: auto !important;
    overflow: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .screen > :global(.ide),
    .veil,
    .glare,
    .lap-hint {
      transition: none;
    }
  }
</style>
