---
// Nucleo-64 style board with two sensors and a 5-LED bar. Flat vector, no logos.
const leds = ['pa0', 'pa1', 'pa2', 'pa3', 'pa4'];
const ledX = (i: number) => 74 + i * 40;
// signal source on the board: PA0, PA1, PA4 on CN7 (left), PA2, PA3 on CN10 (right)
const src: Record<string, { x: number; y: number; side: 'l' | 'r' }> = {
  pa0: { x: 372, y: 236, side: 'l' },
  pa1: { x: 372, y: 244, side: 'l' },
  pa4: { x: 372, y: 252, side: 'l' },
  pa2: { x: 556, y: 268, side: 'r' },
  pa3: { x: 556, y: 276, side: 'r' },
};
const busY = (i: number) => 320 + i * 7;
const wire = (id: string, i: number) => {
  const s = src[id];
  const y = busY(i);
  const out = s.side === 'l' ? 328 + (i === 4 ? 2 : i) * 6 : 588 + (i - 2) * 6;
  return `M${s.x} ${s.y}H${out}V${y}H0`;
};
---

<figure class="nucleo">
  <svg viewBox="0 0 600 360" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="pin2" width="8" height="8" patternUnits="userSpaceOnUse">
        <rect width="8" height="8" fill="#232528" />
        <rect x="2.25" y="2.25" width="3.5" height="3.5" fill="#d8b46a" />
      </pattern>
      <pattern id="sock" width="8" height="8" patternUnits="userSpaceOnUse">
        <rect width="8" height="8" fill="#1c1d1f" />
        <rect x="2.5" y="2.5" width="3" height="3" fill="#000" />
      </pattern>
      <pattern id="perf" width="8" height="8" patternUnits="userSpaceOnUse">
        <circle cx="4" cy="4" r="1.2" fill="#c9a86a" opacity=".55" />
      </pattern>
      <radialGradient id="glow">
        <stop offset="0" stop-color="#ffb547" stop-opacity=".75" />
        <stop offset="1" stop-color="#ffb547" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- board outline, white PCB -->
    <g class="pcb">
      <rect x="352" y="36" width="224" height="264" rx="6" fill="#f2f2ee" stroke="#b9bdb4" />
      <path d="M352 112H576" stroke="#b9bdb4" stroke-dasharray="10 4" />

      <!-- ST-LINK: CN1 USB, U2, CN2 jumpers, CN4 SWD, LD1, X1 -->
      <rect x="444" y="26" width="40" height="24" rx="2" fill="#b7bbc1" stroke="#8b9097" />
      <rect x="452" y="32" width="24" height="7" rx="1" fill="#3a3d42" />
      <rect x="449" y="63" width="30" height="30" fill="#a3a7ad" />
      <rect x="452" y="66" width="24" height="24" fill="#202226" />
      <g fill="#1d1d1f">
        <rect x="372" y="56" width="8" height="16" rx="1.5" />
        <rect x="384" y="56" width="8" height="16" rx="1.5" />
      </g>
      <rect x="544" y="48" width="8" height="48" fill="url(#pin2)" />
      <rect x="414" y="88" width="7" height="4" rx="1" fill="#e9b5a0" stroke="#b07a63" stroke-width=".6" />
      <rect x="500" y="66" width="18" height="8" rx="4" fill="#c4c8cd" stroke="#8b9097" stroke-width=".6" />

      <!-- main: morpho CN7/CN10, Arduino CN5/CN6/CN8/CN9 -->
      <rect x="360" y="128" width="16" height="152" fill="url(#pin2)" />
      <rect x="552" y="128" width="16" height="152" fill="url(#pin2)" />
      <rect x="384" y="128" width="8" height="64" fill="url(#sock)" />
      <rect x="384" y="224" width="8" height="48" fill="url(#sock)" />
      <rect x="536" y="120" width="8" height="80" fill="url(#sock)" />
      <rect x="536" y="208" width="8" height="64" fill="url(#sock)" />

      <!-- MCU, LQFP64 mounted at 45 degrees -->
      <g transform="rotate(45 464 210)">
        <rect x="440" y="186" width="48" height="48" fill="#a3a7ad" />
        <rect x="444" y="190" width="40" height="40" fill="#1f2125" />
        <circle cx="450" cy="196" r="2" fill="#34373c" />
      </g>

      <!-- B1 USER (PC13), B2 RESET -->
      <g>
        <rect x="402" y="124" width="18" height="18" rx="2" fill="#c4c8cd" stroke="#8b9097" stroke-width=".6" />
        <circle cx="411" cy="133" r="6" fill="#2f6fd6" />
      </g>
      <g>
        <rect x="508" y="124" width="18" height="18" rx="2" fill="#c4c8cd" stroke="#8b9097" stroke-width=".6" />
        <circle cx="517" cy="133" r="6" fill="#1b1b1b" />
      </g>

      <!-- LD2 user LED (PA5) -->
      <rect data-led="ld2" x="522" y="156" width="8" height="5" rx="1" fill="#57c26f" stroke="#2f7d45" stroke-width=".6" />

      <!-- X2 32.768 kHz -->
      <rect x="490" y="250" width="16" height="6" rx="3" fill="#c4c8cd" stroke="#8b9097" stroke-width=".6" />

      <g class="silk" fill="#2b2d2f" font-family="ui-monospace, monospace" font-size="6">
        <text x="490" y="22" text-anchor="middle">CN1</text>
        <text x="376" y="80">CN2</text>
        <text x="541" y="44">CN4</text>
        <text x="524" y="104">SWD</text>
        <text x="412" y="101">LD1</text>
        <text x="502" y="84">X1</text>
        <text x="411" y="152" text-anchor="middle">B1 USER</text>
        <text x="517" y="152" text-anchor="middle">B2 RESET</text>
        <text x="506" y="161">LD2</text>
        <text x="492" y="265">X2</text>
        <text x="368" y="292" text-anchor="middle">CN7</text>
        <text x="560" y="292" text-anchor="middle">CN10</text>
      </g>
    </g>

    <!-- HC-SR04 ultrasonic module -->
    <g data-sensor="hcsr04">
      <rect x="40" y="70" width="150" height="62" rx="3" fill="#1f5aa6" />
      <g fill="#c9ccd1" stroke="#8d9198">
        <circle cx="78" cy="101" r="24" />
        <circle cx="152" cy="101" r="24" />
      </g>
      <g fill="#3a3d42" stroke="#55595f" stroke-dasharray="1.5 1.5">
        <circle cx="78" cy="101" r="16" />
        <circle cx="152" cy="101" r="16" />
      </g>
      <rect x="96" y="128" width="32" height="8" fill="url(#pin2)" />
      <text x="115" y="128" fill="#e8eef7" font-family="ui-monospace, monospace" font-size="4.5" text-anchor="middle">Vcc Trig Echo Gnd</text>
    </g>

    <!-- LDR photoresistor module -->
    <g data-sensor="ldr">
      <rect x="196" y="180" width="84" height="32" rx="3" fill="#1f5aa6" />
      <circle cx="218" cy="196" r="10" fill="#e9cf9f" stroke="#9a7442" />
      <path d="M211 192h12l-12 4h12l-12 4h12" fill="none" stroke="#8a5a2b" stroke-width="1.2" />
      <rect x="280" y="184" width="8" height="24" fill="url(#pin2)" />
      <text x="254" y="199" fill="#e8eef7" font-family="ui-monospace, monospace" font-size="4.5" text-anchor="middle">VCC GND AO</text>
    </g>

    <!-- sensor jumpers -->
    <g class="jumpers" fill="none" stroke-width="2.5" stroke-linecap="round">
      <path d="M100 136C100 168 350 156 388 164" stroke="#e5534b" />
      <path d="M124 136C124 176 350 164 388 172" stroke="#222" />
      <path d="M108 136C108 156 330 140 364 140" stroke="#e08b3a" />
      <path d="M116 136C116 162 330 148 364 148" stroke="#9b7be0" />
      <path d="M288 188C330 188 350 156 388 156" stroke="#e5534b" />
      <path d="M288 196C330 196 350 180 388 180" stroke="#222" />
      <path d="M288 204C320 204 340 156 364 156" stroke="#d9dde3" />
    </g>

    <!-- LED bar on a strip of perfboard -->
    <g class="ledbar">
      <rect x="50" y="232" width="200" height="72" rx="3" fill="#11291f" stroke="#2a6b50" />
      <rect x="50" y="232" width="200" height="72" rx="3" fill="url(#perf)" />
      <path d="M58 244H244" stroke="#555" stroke-width="2" />
      {
        leds.map((id, i) => (
          <g data-led={id} class:list={['led', { on: i === 0 }]}>
            <path d={`M${ledX(i)} 244V252`} stroke="#999" stroke-width="1.2" />
            <circle class="halo" cx={ledX(i)} cy="262" r="20" fill="url(#glow)" />
            <circle class="lens" cx={ledX(i)} cy="262" r="9" />
            <rect x={ledX(i) - 3} y="280" width="6" height="16" rx="2" fill="#d8c39a" />
            <rect x={ledX(i) - 3} y="283" width="6" height="2" fill="#8a4f20" />
            <rect x={ledX(i) - 3} y="287" width="6" height="2" fill="#222" />
            <rect x={ledX(i) - 3} y="291" width="6" height="2" fill="#a0522d" />
          </g>
        ))
      }
    </g>

    <!-- ribbon from PA0..PA4 to the LED bar, exiting bottom-left -->
    <g class="ribbon" fill="none" stroke-width="3" stroke-linejoin="round">
      {
        leds.map((id, i) => (
          <g>
            <path d={`M${ledX(i)} ${busY(i)}V296`} stroke={`var(--${id})`} stroke-width="2.4" />
            <path d={wire(id, i)} stroke="var(--bg)" stroke-width="5" />
            <path d={wire(id, i)} stroke={`var(--${id})`} />
            <circle cx={ledX(i)} cy={busY(i)} r="2.6" fill={`var(--${id})`} />
            <text x={ledX(i) + 5} y="226" fill="var(--muted)" font-family="ui-monospace, monospace" font-size="8">{id.toUpperCase()}</text>
          </g>
        ))
      }
    </g>
    <rect id="rail-origin" x="0" y="318" width="2" height="32" fill="none" />
  </svg>
  <figcaption class="sr-only">
    Illustration: a Nucleo-64 development board with an HC-SR04 ultrasonic sensor and a light sensor module on jumper wires,
    and a five-LED bar wired to pins PA0 to PA4. The PA0 LED blinks.
  </figcaption>
</figure>

<style>
  .nucleo {
    margin: 0;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .led .lens {
    fill: #6a4a1f;
  }
  .led .halo {
    opacity: 0;
  }
  .led.on .lens {
    fill: #ffb547;
  }
  .led.on .lens,
  .led.on .halo {
    animation: led-blink 1.1s steps(1) infinite;
  }
  .led.on .halo {
    opacity: 1;
  }
  @keyframes led-blink {
    50% {
      opacity: 0.2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .led.on .lens,
    .led.on .halo {
      animation: none !important;
    }
  }
</style>
