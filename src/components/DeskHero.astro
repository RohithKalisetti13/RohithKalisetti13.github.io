---
// Hero: the board lying on a desk, a USB cable in CN1 with an inline power switch,
// and a 1602 character LCD on an I2C backpack wired to CN5.
// Overlays share the board's 1500x2000 user space, so every coordinate below is board units.
// Markup is the powered-on state; the inline script switches to off before first paint.
import McuBoard from './McuBoard.astro';
import LedDot from './LedDot.astro';
import site from '../content/site.json';

// 1602 module, lying on the desk above the top-right corner (local coordinates inside it)
const LCD = { x: 1105, y: -186, w: 410, h: 176 };
const WIN = { x: 22, y: 40, w: 366, h: 108 };
// 5x8 dot cells: dot pitch D, a one-dot gap between characters and between the two rows
const D = 3.6;
const DOT = 3;
const COLS = 16;
const TX = WIN.x + (WIN.w - (COLS * 6 - 1) * D) / 2;
const TY = WIN.y + (WIN.h - 17 * D) / 2;
const CELLS = Array.from({ length: COLS * 2 }, (_, i) => [TX + (i % COLS) * 6 * D, TY + Math.floor(i / COLS) * 9 * D]);

// HD44780-style glyphs, seven rows of five bits; the eighth row is the cursor line
const FONT: Record<string, number[]> = {
  A: [14, 17, 17, 17, 31, 17, 17], B: [30, 17, 17, 30, 17, 17, 30], C: [14, 17, 16, 16, 16, 17, 14],
  D: [28, 18, 17, 17, 17, 18, 28], E: [31, 16, 16, 30, 16, 16, 31], F: [31, 16, 16, 30, 16, 16, 16],
  G: [14, 17, 16, 23, 17, 17, 15], H: [17, 17, 17, 31, 17, 17, 17], I: [14, 4, 4, 4, 4, 4, 14],
  J: [7, 2, 2, 2, 2, 18, 12], K: [17, 18, 20, 24, 20, 18, 17], L: [16, 16, 16, 16, 16, 16, 31],
  M: [17, 27, 21, 21, 17, 17, 17], N: [17, 17, 25, 21, 19, 17, 17], O: [14, 17, 17, 17, 17, 17, 14],
  P: [30, 17, 17, 30, 16, 16, 16], Q: [14, 17, 17, 17, 21, 18, 13], R: [30, 17, 17, 30, 20, 18, 17],
  S: [15, 16, 16, 14, 1, 1, 30], T: [31, 4, 4, 4, 4, 4, 4], U: [17, 17, 17, 17, 17, 17, 14],
  V: [17, 17, 17, 17, 17, 10, 4], W: [17, 17, 17, 21, 21, 21, 10], X: [17, 17, 10, 4, 10, 17, 17],
  Y: [17, 17, 17, 10, 4, 4, 4], Z: [31, 1, 2, 4, 8, 16, 31], x: [0, 0, 17, 10, 4, 10, 17],
  0: [14, 17, 19, 21, 25, 17, 14], 1: [4, 12, 4, 4, 4, 4, 14], 2: [14, 17, 1, 2, 4, 8, 31],
  3: [31, 2, 4, 2, 1, 17, 14], 4: [2, 6, 10, 18, 31, 2, 2], 5: [31, 16, 30, 1, 1, 17, 14],
  6: [6, 8, 16, 30, 17, 17, 14], 7: [31, 1, 2, 4, 8, 8, 8], 8: [14, 17, 17, 14, 17, 17, 14],
  9: [14, 17, 17, 15, 1, 2, 12], ':': [0, 12, 12, 0, 12, 12, 0], '.': [0, 0, 0, 0, 0, 12, 12],
  '-': [0, 0, 0, 31, 0, 0, 0], '/': [0, 1, 2, 4, 8, 16, 0],
};
// lit dots for two 16-character lines, as one path
const frame = (a: string, b: string) =>
  [a, b]
    .flatMap((line, r) =>
      [...line.slice(0, COLS)].flatMap((ch, c) =>
        (FONT[ch] ?? []).flatMap((bits, y) =>
          [0, 1, 2, 3, 4]
            .filter((x) => bits & (16 >> x))
            .map((x) => `M${+(TX + (c * 6 + x) * D).toFixed(1)} ${+(TY + (r * 9 + y) * D).toFixed(1)}h${DOT}v${DOT}h-${DOT}z`),
        ),
      ),
    )
    .join('');
const NAME = 'ROHITH KALISETTI';
const TAG = 'EMBEDDED FIRMWARE ENGINEER';
const LOG = ['RK-FW1 REV A', 'RST: POWER-ON', 'CLK: PLL LOCKED', 'I2C1: 0x27 ACK', 'RTOS: SCHED UP', 'APP: READY'];

// backpack pins, left to right; the left pin takes the inner lane and the shallowest socket
type Wire = { pin: string; px: number; to: string; y: number; color: string };
const WIRES: Wire[] = [
  { pin: 'SCL', px: 280, to: 'SCL/D15', y: 826, color: '#e3b23c' },
  { pin: 'SDA', px: 305, to: 'SDA/D14', y: 879, color: '#3f86d8' },
  { pin: 'VCC', px: 330, to: 'AVDD', y: 932, color: '#d4483e' },
  { pin: 'GND', px: 355, to: 'GND', y: 985, color: '#2a2b2f' },
];
const HOUSING_END = 1298; // CN5 socket housings end here
const LANE0 = 1500; // right desk margin, clear of the board edge at 1470
const PIN_Y = LCD.y + 238; // bottom of the Dupont housings on the backpack
// over the corner, down the margin with a little slack, then into CN5
const wirePath = (w: Wire, i: number) => {
  const sx = LCD.x + w.px;
  const lx = LANE0 + i * 14;
  const sag = 16 + i * 3;
  return [
    `M${sx} ${PIN_Y}`,
    `C${sx} ${PIN_Y + 50} ${lx} ${PIN_Y + 30} ${lx} ${PIN_Y + 112}`,
    `C${lx + sag} ${PIN_Y + 330} ${lx + sag} ${w.y - 300} ${lx} ${w.y - 110}`,
    `C${lx} ${w.y - 30} ${lx - 46} ${w.y} ${lx - 110} ${w.y}`,
    `L${HOUSING_END + 4} ${w.y}`,
  ].join('');
};

// the switch box sits on the cable, above the plug
const SW = { x: 1018, y: -262 };

const LINKS = [
  { label: 'Resume', href: site.resume, pin: 'PB0', cap: 'light', external: true },
  { label: 'GitHub', href: site.github, pin: 'PB1', cap: 'dark', external: true },
  { label: 'LinkedIn', href: site.linkedin, pin: 'PB2', cap: 'dark', external: true },
  { label: 'Email', href: `mailto:${site.email}`, pin: 'PB3', cap: 'dark', external: false },
];
---

<section id="boot" class="desk" data-power="on" aria-labelledby="boot-title">
  <div class="desk-inner">
    <div class="copy">
      <h1 id="boot-title">{site.name}</h1>
      <div class="meta">
        <p class="role">{site.role}</p>
        <p class="avail powered-in"><LedDot color="var(--pa4)" />{site.availability}</p>
      </div>
      <p class="hint">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <rect x="7" y="3" width="10" height="18" rx="3" fill="none" stroke="currentColor" stroke-width="1.7" />
          <path d="M12 6.5v4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
          <circle cx="12" cy="16" r="2" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
        Flip the switch to power on
      </p>

      <!-- tactile switch module, one link per switch -->
      <ul class="tact" aria-label="Links">
        {
          LINKS.map((l) => (
            <li>
              <a
                class="tsw"
                data-cap={l.cap}
                href={l.href}
                {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <span class="sw" aria-hidden="true">
                  <i class="leg" />
                  <i class="leg" />
                  <i class="leg" />
                  <i class="leg" />
                  <span class="cap" />
                </span>
                <span class="lbl">{l.label}</span>
                <span class="pin" aria-hidden="true">
                  {l.pin}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="stage">
      <McuBoard power="on" idPrefix="hero-" />

      <!-- USB cable, permanently in CN1 -->
      <svg class="rig rig-usb" viewBox="0 -400 1500 2400" overflow="visible" aria-hidden="true">
        <defs>
          <clipPath id="usb-clip">
            <rect x="-500" y="-5000" width="2500" height="5101" />
          </clipPath>
          <linearGradient id="usb-mold" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#0d0e10" />
            <stop offset=".18" stop-color="#3a3b40" />
            <stop offset=".42" stop-color="#232428" />
            <stop offset="1" stop-color="#0e0f11" />
          </linearGradient>
          <linearGradient id="usb-tip" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#8d8c86" />
            <stop offset=".2" stop-color="#eeede8" />
            <stop offset=".55" stop-color="#b9b8b1" />
            <stop offset="1" stop-color="#7a7973" />
          </linearGradient>
        </defs>
        <g clip-path="url(#usb-clip)">
          <path d="M1015 -160C1015 -420 1034 -760 1050 -4000" transform="translate(16 24)" stroke="#000" stroke-width="44" fill="none" opacity=".28" />
          <rect x="962" y="-70" width="134" height="190" rx="14" fill="#000" opacity=".3" />
          <rect x="963" y="88" width="104" height="52" rx="3" fill="url(#usb-tip)" />
          <rect x="975" y="96" width="80" height="8" fill="#1a1a1c" opacity=".6" />
          <path d="M1015 -160C1015 -420 1034 -760 1050 -4000" stroke="#17181b" stroke-width="40" fill="none" />
          <path d="M1003 -170C1003 -420 1021 -760 1037 -4000" stroke="#fff" stroke-width="5" fill="none" opacity=".1" />
          <path d="M975 -78H1055L1039 -168H991Z" fill="#141518" />
          <path d="M979 -98H1051M983 -120H1047M986 -142H1044" stroke="#2c2d31" stroke-width="5" />
          <rect x="948" y="-80" width="134" height="180" rx="14" fill="url(#usb-mold)" />
          <path d="M955 92V-64Q955 -74 965 -74H1055" stroke="#fff" stroke-width="2.5" fill="none" opacity=".16" />
          <path d="M985 66H1045M985 78H1045" stroke="#0a0a0b" stroke-width="4" opacity=".8" />
          <g transform="translate(1015 4)" stroke="#55565c" stroke-width="3.5" fill="none" stroke-linecap="round">
            <path d="M0 26V-26M0-26l-7 9h14zM0 8l-14-8v-8M0 14l13-8v-7" />
            <circle cx="0" cy="30" r="4" fill="#55565c" />
          </g>
        </g>
      </svg>

      <!-- 1602 LCD module and its four jumpers -->
      <svg class="rig rig-fx" viewBox="0 0 1500 2000" overflow="visible" aria-hidden="true">
        <defs>
          <linearGradient id="lcd-pcb" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#2f7a3a" />
            <stop offset="1" stop-color="#1e5a29" />
          </linearGradient>
          <linearGradient id="lcd-back" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#c9d6df" />
            <stop offset=".6" stop-color="#b3c3cf" />
            <stop offset="1" stop-color="#a2b4c2" />
          </linearGradient>
          <pattern id="lcd-cell" patternUnits="userSpaceOnUse" x={TX} y={TY} width={D} height={D}>
            <rect width={DOT} height={DOT} fill="#1c2733" opacity=".07" />
          </pattern>
        </defs>

        <g class="lcd" transform={`translate(${LCD.x} ${LCD.y})`}>
          <rect x="14" y="22" width={LCD.w} height={LCD.h} rx="9" fill="#000" opacity=".22" />
          <rect x="5" y="8" width={LCD.w} height={LCD.h} rx="8" fill="#000" opacity=".35" />
          <rect x="-2" y="3" width={LCD.w + 2} height={LCD.h} rx="7" fill="#14431c" />
          <rect width={LCD.w} height={LCD.h} rx="7" fill="url(#lcd-pcb)" />
          <path d={`M3 ${LCD.h - 8}V10Q3 3 10 3H${LCD.w - 8}`} stroke="#fff" stroke-width="2" fill="none" opacity=".22" />
          {
            [
              [13, 13],
              [LCD.w - 13, 13],
              [13, LCD.h - 13],
              [LCD.w - 13, LCD.h - 13],
            ].map(([x, y]) => (
              <g>
                <circle cx={x} cy={y} r="8" fill="#d9c27a" />
                <circle cx={x} cy={y} r="4.6" fill="#0b120c" />
              </g>
            ))
          }
          <!-- 16-pin parallel header -->
          {
            Array.from({ length: 16 }, (_, i) => (
              <g>
                <rect x={44 + i * 20} y="7" width="13" height="13" rx={i ? 6.5 : 1.5} fill="#d9c27a" />
                <circle cx={50.5 + i * 20} cy="13.5" r="3.4" fill="#1d1a10" />
              </g>
            ))
          }
          <!-- bezel and backlit window -->
          <rect x="12" y="29" width="386" height="128" rx="4" fill="#25282d" />
          <path d="M13 156V31Q13 30 15 30H396" stroke="#4a4e55" stroke-width="2" fill="none" />
          <rect x={WIN.x} y={WIN.y} width={WIN.w} height={WIN.h} rx="2" fill="#3a3d42" />
          <g class="lcd-on">
            <rect x={WIN.x} y={WIN.y} width={WIN.w} height={WIN.h} rx="2" fill="url(#lcd-back)" />
            {CELLS.map(([x, y]) => <rect x={x} y={y} width={5 * D} height={8 * D} fill="url(#lcd-cell)" />)}
            <path class="lcd-lit" d={frame(NAME, TAG)} fill="#1c2733" opacity=".86" />
          </g>
          <path d={`M${WIN.x + 4} ${WIN.y + WIN.h - 3}L${WIN.x + 70} ${WIN.y + 3}H${WIN.x + 108}L${WIN.x + 42} ${WIN.y + WIN.h - 3}Z`} fill="#fff" opacity=".06" />

          <!-- I2C backpack along the bottom edge -->
          <rect x="152" y="168" width="250" height="44" rx="3" fill="#000" opacity=".35" />
          <rect x="148" y="164" width="250" height="44" rx="3" fill="#16191e" />
          <path d="M150 166H396" stroke="#3a3f47" stroke-width="1.5" />
          <rect x="164" y="176" width="54" height="22" rx="2" fill="#0c0d0f" />
          <path d="M168 174v-3M178 174v-3M188 174v-3M198 174v-3M208 174v-3M168 200v3M178 200v3M188 200v3M198 200v3M208 200v3" stroke="#a7a8ab" stroke-width="3" />
          <rect x="228" y="174" width="26" height="26" rx="3" fill="#2463c4" />
          <circle cx="241" cy="187" r="8" fill="#e9e6dc" />
          <path d="M236 187h10M241 182v10" stroke="#555" stroke-width="2.4" />
          <g fill="#e8edf2" opacity=".85" font-family="'JetBrains Mono Variable', ui-monospace, monospace" font-size="11" text-anchor="middle">
            {WIRES.map((w) => <text x={w.px} y="179">{w.pin}</text>)}
          </g>
        </g>

        <!-- jumpers: shadow, insulation, highlight, then the Dupont housings at both ends -->
        <g fill="none" stroke-linecap="round" stroke-linejoin="round">
          {WIRES.map((w, i) => <path d={wirePath(w, i)} transform="translate(7 10)" stroke="#000" stroke-width="11" opacity=".24" />)}
          {WIRES.map((w, i) => <path d={wirePath(w, i)} stroke={w.color} stroke-width="9" />)}
          {WIRES.map((w, i) => <path d={wirePath(w, i)} transform="translate(-1.5 -1.5)" stroke="#fff" stroke-width="2.4" opacity=".3" />)}
        </g>
        {
          WIRES.map((w) => (
            <g transform={`translate(${LCD.x + w.px} ${LCD.y})`}>
              <rect x="-9" y="190" width="22" height="58" rx="3" fill="#000" opacity=".3" />
              <rect x="-11" y="186" width="22" height="58" rx="3" fill="#18191c" />
              <path d="M-9 188H9" stroke="#4a4b51" stroke-width="2" />
              <rect x="-4" y="226" width="8" height="14" rx="1" fill="#2c2d32" />
            </g>
          ))
        }
        {
          WIRES.map((w) => (
            <g>
              <rect x="1252" y={w.y - 10} width={HOUSING_END - 1246} height="28" rx="3" fill="#000" opacity=".3" />
              <rect x="1246" y={w.y - 14} width={HOUSING_END - 1246} height="28" rx="3" fill="#18191c" />
              <path d={`M1248 ${w.y - 12}H${HOUSING_END - 3}`} stroke="#4a4b51" stroke-width="2" />
              <rect x="1262" y={w.y - 5} width="18" height="10" rx="1" fill="#2c2d32" />
            </g>
          ))
        }
      </svg>

      <button type="button" class="lcd-hit" aria-label="Open about"></button>

      <!-- inline rocker on the cable -->
      <button type="button" class="pwr" aria-pressed="true" aria-label="Power">
        <svg viewBox="0 0 96 150" aria-hidden="true">
          <defs>
            <linearGradient id="pwr-case" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#34363b" />
              <stop offset="1" stop-color="#16171a" />
            </linearGradient>
            <linearGradient id="pwr-up" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#4a4c52" />
              <stop offset="1" stop-color="#2a2c30" />
            </linearGradient>
            <linearGradient id="pwr-down" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#151619" />
              <stop offset="1" stop-color="#1f2024" />
            </linearGradient>
          </defs>
          <rect x="10" y="10" width="86" height="140" rx="16" fill="#000" opacity=".3" />
          <rect x="4" y="4" width="86" height="140" rx="16" fill="url(#pwr-case)" />
          <path d="M8 130V20Q8 8 20 8H76" stroke="#fff" stroke-width="1.5" fill="none" opacity=".18" />
          <circle class="pwr-led" cx="47" cy="20" r="4" />
          <rect x="21" y="30" width="52" height="82" rx="6" fill="#0b0c0e" />
          <g class="rk-i">
            <rect x="25" y="34" width="44" height="37" rx="3" />
            <path d="M47 43v18" stroke="#c9cbcf" stroke-width="3.2" stroke-linecap="round" />
          </g>
          <g class="rk-o">
            <rect x="25" y="71" width="44" height="37" rx="3" />
            <circle cx="47" cy="89.5" r="8" fill="none" stroke="#c9cbcf" stroke-width="3" />
          </g>
          <text x="47" y="132" text-anchor="middle" font-family="'JetBrains Mono Variable', ui-monospace, monospace" font-size="12" font-weight="600" fill="#b4b6bb">I/O</text>
        </svg>
      </button>
    </div>
  </div>
</section>

<script is:inline define:vars={{ FONT, LOG, NAME, TAG, TX, TY, D, DOT, COLS }}>
  (() => {
    const root = document.getElementById('boot');
    const board = root && root.querySelector('.mcu-board');
    if (!root || !board) return;
    const stage = root.querySelector('.stage');
    const sw = root.querySelector('.pwr');
    const lit = root.querySelector('.lcd-lit');
    const store = {
      get(k) {
        try {
          return window.sessionStorage.getItem(k);
        } catch {
          return null;
        }
      },
      set(k, v) {
        try {
          window.sessionStorage.setItem(k, v);
        } catch {
          /* storage blocked: every visit is a first visit */
        }
      },
    };
    const mq = (q) => window.matchMedia(q).matches;
    const reduced = mq('(prefers-reduced-motion: reduce)');

    // same lit-dot path as the server render
    const frame = (a, b) =>
      [a, b]
        .flatMap((line, r) =>
          [...line.slice(0, COLS)].flatMap((ch, c) =>
            (FONT[ch] || []).flatMap((bits, y) =>
              [0, 1, 2, 3, 4]
                .filter((x) => bits & (16 >> x))
                .map((x) => `M${+(TX + (c * 6 + x) * D).toFixed(1)} ${+(TY + (r * 9 + y) * D).toFixed(1)}h${DOT}v${DOT}h-${DOT}z`),
            ),
          ),
        )
        .join('');
    const show = (a, b) => lit.setAttribute('d', frame(a, b));

    // one pending LCD step at a time, so power-off cancels whatever is running
    let step = 0;
    const later = (fn, ms) => (step = setTimeout(fn, ms));
    const run = () => {
      if (reduced) return show(NAME, 'EMBEDDED FW ENG');
      // hold at the start, scroll one character per 300 ms, hold at the end, loop
      const last = TAG.length - COLS;
      let k = 0;
      const tick = () => {
        show(NAME, TAG.slice(k, k + COLS));
        const hold = k === 0 || k === last;
        k = k === last ? 0 : k + 1;
        later(tick, hold ? 2000 : 300);
      };
      tick();
    };
    const boot = () => {
      if (reduced) return run();
      let i = 0;
      show('', '');
      const tick = () => {
        show(LOG[i - 1] || '', LOG[i]);
        i += 1;
        later(i < LOG.length ? tick : run, i < LOG.length ? 300 : 900);
      };
      later(tick, 450);
    };

    let on = true;
    const setPower = (v, animate) => {
      on = v;
      clearTimeout(step);
      root.dataset.power = v ? 'on' : 'off';
      board.setAttribute('data-power', v ? 'on' : 'off');
      sw.setAttribute('aria-pressed', String(v));
      if (!v) show('', '');
      else if (animate) boot();
      else run();
    };

    root.querySelector('.lcd-hit').addEventListener('click', () => {
      const ev = new CustomEvent('rk:about', { cancelable: true });
      if (window.dispatchEvent(ev)) document.querySelector('#irq .about')?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' });
    });

    // a repeat visit in this session comes back powered, with no intro
    const repeat = store.get('rk-seen') === '1';
    store.set('rk-seen', '1');
    let touched = repeat;
    let idle = 0;
    sw.addEventListener('click', () => {
      touched = true;
      clearTimeout(idle);
      setPower(!on, true);
    });
    if (repeat) return run();

    setPower(false);
    // an unattended first visit still gets a powered board, unless the switch was used
    const arm = () => {
      clearTimeout(idle);
      if (!touched && !on) idle = setTimeout(() => !touched && setPower(true, true), 6000);
    };
    ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach((e) => window.addEventListener(e, arm, { passive: true }));

    const intro = !reduced && !mq('(max-width: 720px)') && window.scrollY < 8 && 'animate' in stage;
    if (!intro) return arm();

    // whole board centred under the nav at about 45%, then ease into the hero framing
    root.dataset.intro = 'run';
    const r = stage.getBoundingClientRect();
    const u = r.width / 1500;
    const nav = document.querySelector('.nav')?.getBoundingClientRect().height || 64;
    const vw = document.documentElement.clientWidth;
    const avail = window.innerHeight - nav - 40;
    const s = Math.min(0.45, avail / (2000 * u));
    const tx = vw / 2 - r.left - s * 750 * u;
    const ty = nav + 20 + avail / 2 - r.top - s * 870 * u;
    stage.style.transformOrigin = '0 0';
    const anim = stage.animate([{ transform: `translate(${tx}px, ${ty}px) scale(${s})` }, { transform: 'none' }], {
      duration: 1200,
      delay: 650,
      easing: 'cubic-bezier(.65, 0, .35, 1)',
      fill: 'backwards',
    });
    const skip = () => anim.finish();
    const done = () => {
      root.dataset.intro = 'done';
      window.removeEventListener('pointerdown', skip);
      window.removeEventListener('keydown', skip);
      arm();
    };
    window.addEventListener('pointerdown', skip);
    window.addEventListener('keydown', skip);
    anim.finished.then(done, done);
  })();
</script>

<style>
  .desk {
    position: relative;
    container-type: inline-size;
