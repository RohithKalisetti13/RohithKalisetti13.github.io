    font: var(--fs-label) var(--font-mono);
  }

  .stage {
    position: relative;
    z-index: 1;
    width: var(--stage-w);
    margin-left: calc((100% - var(--stage-w)) / 2);
    aspect-ratio: 1500 / 2000;
  }
  .sentinel {
    position: absolute;
    top: 32.5%;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
  .rig {
    position: absolute;
    left: 0;
    width: 100%;
    pointer-events: none;
  }
  .rig-fx {
    top: 0;
    height: 100%;
  }
  .rig-usb {
