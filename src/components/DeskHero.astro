  /* tactile switch strip: a small PCB lying on the desk */
  .tact {
    --pcb: var(--board);
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 4px var(--s-3);
    margin-top: var(--s-1);
    padding: 10px 26px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--pcb);
