    background: color-mix(in srgb, var(--board) 80%, transparent);
    color: var(--text-2);
    font: var(--fs-label-lg) var(--font-mono);
  }

  /* the chip waits for power; the hint shows only while unpowered */
  .powered-in {
    transition:
      opacity 500ms var(--ease) 350ms,
      visibility 0s;
