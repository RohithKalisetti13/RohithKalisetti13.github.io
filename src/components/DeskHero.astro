  .leg:nth-child(1) {
    top: 5px;
    left: -6px;
  }
  .leg:nth-child(2) {
    bottom: 5px;
    left: -6px;
  }
  .leg:nth-child(3) {
    top: 5px;
    right: -6px;
  }
  .leg:nth-child(4) {
    bottom: 5px;
    right: -6px;
  }
  .cap {
