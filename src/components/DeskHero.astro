    --lcd-b: #bfead8;
    --lcd-c: #a9dcc7;
    --halo: 1;
  }
  :global(:root[data-theme='light']) .desk {
    /* lit dots stay above 4.5:1 on the darkest stop, over the unlit dot cells */
    --lcd-a: #a2ae9c;
    --lcd-b: #9cab97;
    --lcd-c: #98a693;
    --halo: 0;
  }
  :global(#lcd-back stop) {
