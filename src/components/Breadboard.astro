---
// Projects as units on one solderless breadboard. Each unit is its part, then a tactile switch, a 220R
// and an LED in a row, with a jumper from the switch to a header pin on the board (drawn by WireLayer).
// The part, the switch and the plate are one link to the case study: pressing it drops the switch,
// lights the LED, then the page slides in. Under 720px the units become cards with the same drawings.
import type { Project } from '../content.config';
import StatusLed from './StatusLed.astro';
import BoardArt from './bench/BoardArt.astro';
import BenchDefs from './bench/BenchDefs.astro';
import Part from './bench/Part.astro';
import TactButton from './bench/TactButton.astro';
import Resistor from './bench/Resistor.astro';
import Led from './bench/Led.astro';
import { BB_W, BB_H, colX, rowY, railHole } from '../lib/breadboard';
import { PART_BOX, BUTTON, RESISTOR, LED, type PartKind, type Box } from '../lib/parts';

interface Props {
  projects: { id: string; data: Project }[];
}
const { projects } = Astro.props;

type Half = 'top' | 'bottom';
// left to right, top half then bottom half; label = the one-line plate text (the full title is in the tooltip),
// silk = silkscreen name of the header pin the jumper leaves (from). Pins run D7 to D0 down the header, so
// the top row takes the upper pins far to near and the bottom row the lower ones near to far: the harness
// then splits at the board's edge without a single crossing
const UNITS: { slug: string; label: string; kind: PartKind; half: Half; silk: string; from: string; color: string }[] = [
  { slug: 'iio-sensor-hub', label: 'IIO hub', kind: 'msa311', half: 'top', silk: 'D3', from: "#hero-cn9 [data-pin='PB3']", color: '#d9d6cf' },
  { slug: 'openwrt-fault-injection', label: 'OpenWrt', kind: 'wifi', half: 'top', silk: 'D4', from: "#hero-cn9 [data-pin='PB5']", color: '#4f8a4f' },
  { slug: 'freertos-host-shim', label: 'FreeRTOS', kind: 'crystal', half: 'top', silk: 'D5', from: "#hero-cn9 [data-pin='PB4']", color: '#c77a33' },
  { slug: 'gesture-wheelchair', label: 'Wheelchair', kind: 'adxl335', half: 'top', silk: 'D6', from: "#hero-cn9 [data-pin='PB10']", color: '#6d5596' },
  { slug: 'gpu-beamformer', label: 'Beamformer', kind: 'hcsr04', half: 'top', silk: 'D7', from: "#hero-cn9 [data-pin='PA8']", color: '#3f6fa8' },
  // A0 (PA0) sits on the far side of the MCU board; this jumper leaves the free CN10 morpho pin PC4,
  // which sits between D3 and D2, so all nine leave the board as one ribbon
  { slug: 'cuda-image-processing', label: 'CUDA', kind: 'matrix', half: 'bottom', silk: 'PC4', from: "#hero-cn10 [data-pin='PC4']", color: '#c9a43a' },
  { slug: 'hardware-debloat-ghidra', label: 'Ghidra', kind: 'swd', half: 'bottom', silk: 'D2', from: "#hero-cn9 [data-pin='PA10']", color: '#7a5136' },
  { slug: 'hdc-pi-vs-gpu', label: 'HDC', kind: 'oled', half: 'bottom', silk: 'D1', from: "#hero-cn9 [data-pin='PA2']", color: '#7d7f84' },
  { slug: 'captcha-cnn', label: 'CAPTCHA', kind: 'camera', half: 'bottom', silk: 'D0', from: "#hero-cn9 [data-pin='PA3']", color: '#3f86d8' },
];
const STATUS = { wip: 'In progress', shipped: 'Shipped' };
const byId = new Map(projects.map((p) => [p.id, p]));

// unit frames: five per half, twelve columns apart; origin on the first column at row a (top) or j (bottom).
// Plates sit on rows d-e and f-g, so the centre channel stays bare and the two rows of units stay apart
const START = [2, 14, 26, 38, 50];
const BAND: Record<Half, { li: [number, number]; art: [number, number]; plate: [number, number]; row: 'a' | 'j'; dy: number }> = {
  top: { li: [0, 88.5], art: [0, 78], plate: [79, 88], row: 'a', dy: BUTTON.dy },
  bottom: { li: [103.5, 196], art: [114, 196], plate: [104, 113], row: 'j', dy: -BUTTON.dy },
};
const pct = (v: number, of: number) => `${+((v / of) * 100).toFixed(4)}%`;
// a box in unit coordinates, placed inside the art rectangle of that unit
const place = (b: Box, ox: number, oy: number, art: { x: number; y: number; w: number; h: number }) =>
  `left:${pct(ox + b.x - art.x, art.w)};top:${pct(oy + b.y - art.y, art.h)};width:${pct(b.w, art.w)};height:${pct(b.h, art.h)}`;

const units = UNITS.map((u, i) => {
  const p = byId.get(u.slug);
  if (!p) return null;
  const band = BAND[u.half];
  const ox = colX(START[i % 5]);
  const oy = rowY(band.row);
  const li = { x: ox - 5, y: band.li[0], w: 120, h: band.li[1] - band.li[0] };
  const art = { x: li.x, y: band.art[0], w: li.w, h: band.art[1] - band.art[0] };
  const dy = band.dy;
  return {
    ...u,
    p,
    li: `left:${pct(li.x, BB_W)};top:${pct(li.y, BB_H)};width:${pct(li.w, BB_W)};height:${pct(li.h, BB_H)}`,
    art: `top:${pct(art.y - li.y, li.h)};height:${pct(art.h, li.h)}`,
    plate: `top:${pct(band.plate[0] - li.y, li.h)};height:${pct(band.plate[1] - band.plate[0], li.h)};left:${pct(3, li.w)};width:${pct(114, li.w)}`,
    part: place(PART_BOX[u.kind], ox, oy, art),
    btn: place({ x: BUTTON.cx - 17, y: dy - 17, w: 34, h: 34 }, ox, oy, art),
    res: place({ x: RESISTOR.x0 - 3, y: dy - 7, w: 46, h: 14 }, ox, oy, art),
    led: place({ x: LED.cx - 19, y: dy - 19, w: 38, h: 38 }, ox, oy, art),
    pad: `left:${pct(ox, BB_W)};top:${pct(oy, BB_H)}`,
  };
}).filter((u) => u !== null);
const next = `left:${pct(colX(50) - 5, BB_W)};top:${pct(104, BB_H)};width:${pct(120, BB_W)};height:${pct(55, BB_H)}`;

const POWER = [
  { from: "#hero-cn10 [data-pin='U5V']", color: '#c4473c', at: railHole(61, 'bot+') },
  { from: "#hero-cn11 [data-pin='GND']@1", color: '#2a2b2f', at: railHole(61, 'bot-') },
];
---

<div class="bbw">
  <BenchDefs />
  <div class="bb">
    <BoardArt />
    <ul class="units">
      {
        units.map((u) => (
          <li class:list={['unit', u.half]} style={u.li} data-status={u.p.data.status}>
            <a
              class="hit"
              href={`/projects/${u.slug}/`}
              aria-label={`${u.p.data.title}, ${u.p.data.period ?? 'Earlier project'}, ${STATUS[u.p.data.status]}`}
              data-unit
            >
              <span class="art" style={u.art} aria-hidden="true">
                <span class="u-part" style={u.part}>
                  <Part kind={u.kind} />
                </span>
                <span class="u-res" style={u.res}>
                  <Resistor />
                </span>
                <span class="u-led" style={u.led}>
                  <Led color={u.p.data.status === 'wip' ? 'amber' : 'green'} />
                </span>
                <span class="u-btn" style={u.btn}>
                  <TactButton />
                </span>
              </span>
              <span class="plate" style={u.plate} aria-hidden="true">
                <StatusLed status={u.p.data.status} />
                <span class="ttl">{u.label}</span>
                <span class="pin">{u.silk}</span>
              </span>
              <span class="tip">
                <span class="tt">{u.p.data.title}</span>
                <span class="tp">
                  {u.p.data.period ?? 'Earlier project'}
                  <span class="sr-only">, {STATUS[u.p.data.status]}</span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
      <li class="unit bottom next" style={next}>
        <span class="mono">next build</span>
      </li>
    </ul>
    {
      units.map((u) => (
        <span class="pad" style={u.pad} data-wire-from={u.from} data-wire-color={u.color} data-wire-group="units" data-wire-side={u.half} aria-hidden="true" />
      ))
    }
    {
      POWER.map((g) => (
        <span
          class="pad"
          style={`left:${pct(g.at.x, BB_W)};top:${pct(g.at.y, BB_H)}`}
          data-wire-from={g.from}
          data-wire-color={g.color}
          data-wire-group="power"
          aria-hidden="true"
        />
      ))
    }
  </div>

  <p class="legend mono">
    <span><StatusLed status="wip" /> Blinking amber: in progress</span>
    <span><StatusLed status="shipped" /> Green on press: shipped</span>
  </p>
</div>

<script>
  import { navigate } from 'astro:transitions/client';
  import { showTip, hideTip } from '../lib/tip';

  // the switch drops and the LED lights, then the case study slides in
  const init = () => {
    document.querySelectorAll<HTMLAnchorElement>('a[data-unit]').forEach((a) => {
      if (a.dataset.bound) return;
      a.dataset.bound = '1';
      a.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        if (a.classList.contains('pressed')) return;
        a.classList.add('pressed');
        setTimeout(() => navigate(a.href), 300);
      });
    });
  };
  document.addEventListener('astro:page-load', init);

  // the shared floating tip: above a top unit, below a bottom one, clear of the other row
  const wide = window.matchMedia('(min-width: 721px)');
  const show = (a: HTMLAnchorElement) => {
    const li = a.closest<HTMLElement>('.unit');
    const src = a.querySelector('.tip');
    if (!wide.matches || !li || !src) return;
    const row = li.classList.contains('top') ? 'top' : 'bottom';
    const others = [...document.querySelectorAll<HTMLElement>(`.bb .unit:not(.${row})`)].map((u) => u.getBoundingClientRect());
    showTip(li.getBoundingClientRect(), src.innerHTML, row === 'top' ? 'above' : 'below', others);
  };
  document.addEventListener('mouseover', (e) => {
    const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[data-unit]');
    if (a) show(a);
    else if (!(e.target as Element).closest?.('[data-tip]')) hideTip();
  });
  document.addEventListener('focusin', (e) => {
    const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[data-unit]');
    if (a?.matches(':focus-visible')) show(a);
    else if (!a && !(e.target as Element).closest?.('[data-tip]')) hideTip();
  });
  // a press moves focus onto the unit; only focus leaving a unit hides its tip
  document.addEventListener('focusout', (e) => (e.target as Element).closest?.('a[data-unit]') && hideTip());

  window.addEventListener('pageshow', (e) => {
    if (e.persisted) document.querySelectorAll('a[data-unit].pressed').forEach((a) => a.classList.remove('pressed'));
  });
</script>

<style>
  .bbw {
    --ivory: #f3efe5;
    --ivory-2: #ddd6c5;
    --ink: #2a2620;
    --ink-2: #4a443a;
    width: min(100%, 1160px);
    margin: var(--s-4) auto 0;
  }
  .bb {
    position: relative;
    container-type: inline-size;
    color: var(--ink);
  }
  .units {
    position: absolute;
    inset: 0;
  }
  .unit {
    position: absolute;
  }
  .unit:has(.hit:hover, .hit:focus-visible) {
    z-index: 3;
  }
  .hit {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .hit:focus-visible {
    outline: 2px solid #8a4a00;
    outline-offset: 2px;
  }
  .art {
    position: absolute;
    left: 0;
    width: 100%;
  }
  .art > span {
    position: absolute;
  }
  .art :global(svg) {
    width: 100%;
    height: 100%;
  }
  .u-part {
    transition: translate var(--t-fast) var(--ease);
  }
  .hit:hover .u-part {
    translate: 0 -1px;
  }

  /* switch: the cap drops while held and through the press */
  .hit:active .u-btn :global(.cap),
  .hit.pressed .u-btn :global(.cap) {
    transform: translateY(0.7px);
    filter: brightness(0.75);
  }

  /* LEDs: dim at rest; in progress blinks amber at 1 Hz; shipped lights green on hover or press */
  .u-led :global(.lit) {
    transition: opacity 250ms ease-out;
  }
  .hit:is(:hover, :focus-visible, .pressed) .u-led :global(.lit) {
    transition-duration: 120ms;
  }
  .unit[data-status='wip'] .u-led :global(.lit) {
    animation: unit-blink 1s steps(1, end) infinite;
  }
  @keyframes unit-blink {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
  .unit[data-status='shipped'] .hit:is(:hover, :focus-visible) .u-led :global(.lit),
  .hit.pressed .u-led :global(.lit) {
    opacity: 1;
    animation: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .unit[data-status='wip'] .u-led :global(.lit) {
      animation: none;
      opacity: 1;
    }
  }
  /* board power off: every LED stays dark, the links still work */
  :global(html:has(.desk[data-power='off'])) .u-led :global(.lit) {
    opacity: 0 !important;
    animation: none !important;
  }
  .plate :global(.sled) {
    transition: background-color 250ms ease-out;
  }
  :global(html:has(.desk[data-power='off'])) .plate :global(.sled) {
    animation: none;
    background: #3e3a32;
  }

  /* label strip beside the channel */
  .plate {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0 0.6em;
    border-radius: 3px;
    background: var(--ivory);
    box-shadow:
      0 0 0 1px var(--ivory-2),
      1px 2px 3px rgba(0, 0, 0, 0.12);
    font: 500 max(9px, calc(100cqw * 5.6 / 680)) / 1 var(--font-mono);
  }
  .hit:hover .plate {
    background: #fbf8f1;
  }
  .ttl {
    flex: 1;
    white-space: nowrap;
  }
  .pin {
    flex: none;
    padding: 0 0.35em;
    border: 1px solid var(--ink-2);
    border-radius: 3px;
    color: var(--ink-2);
    font-size: 0.9em;
    line-height: 1.1;
  }

  /* the unit's tip is the text source; on the bench it shows in one floating tip over the whole desk */
  .tip {
    display: none;
  }
  :global(.bb-tip) {
    position: fixed;
    z-index: 30;
    display: grid;
    width: max-content;
    max-width: 280px;
    padding: 8px 12px;
    border: 1px solid #2c3a35;
    border-radius: 8px;
    background: #101614;
    color: #e8efe9;
    font: 600 var(--fs-label-lg) / 1.4 var(--font-sans);
    box-shadow: 6px 10px 18px rgba(0, 0, 0, 0.3);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    translate: 0 var(--tip-dy, 4px);
    transition:
      opacity var(--t-fast) var(--ease),
      translate var(--t-fast) var(--ease),
      visibility 0s var(--t-fast);
  }
  :global(.bb-tip[data-side='below']) {
    --tip-dy: -4px;
  }
  :global(.bb-tip.on) {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition-delay: 0s;
  }
  /* the arrow points back at the unit */
  :global(.bb-tip)::after {
    content: '';
    position: absolute;
    left: var(--arrow, 50%);
    width: 10px;
    height: 10px;
    margin-left: -5px;
    border: solid #2c3a35;
    background: #101614;
    rotate: 45deg;
  }
  :global(.bb-tip[data-side='above'])::after {
    top: 100%;
    margin-top: -5px;
    border-width: 0 1px 1px 0;
  }
  :global(.bb-tip[data-side='below'])::after {
    bottom: 100%;
    margin-bottom: -5px;
    border-width: 1px 0 0 1px;
  }
  :global(.bb-tip .tp) {
    color: #b9ccc5;
    font: 400 var(--fs-label) var(--font-mono);
  }
  .tp {
    color: #b9ccc5;
    font: 400 var(--fs-label) var(--font-mono);
  }
  .next {
    display: grid;
    place-items: center;
    border: 1.5px dashed #a59d8a;
    border-radius: 6px;
    background: rgba(243, 239, 229, 0.82);
    color: var(--ink-2);
    font-size: max(9px, calc(100cqw * 6 / 680));
  }

  /* jumper landing holes; WireLayer draws the wire into each */
  .pad {
    position: absolute;
    width: 4px;
    height: 4px;
    margin: -2px 0 0 -2px;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    margin-top: var(--s-3);
    color: var(--text-2);
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
  }

  /* desk world: room above and below the board for the harness rows */
  :global(html.world) .bbw {
    width: 100%;
    margin: 96px 0 0;
  }
  :global(html.world) .legend {
    margin-top: 72px;
  }

  /* phones: one column of cards, the same drawings; the switch is the big target */
  @media (max-width: 720px) {
    .bbw {
      width: 100%;
    }
    .bb {
      container-type: normal;
    }
    .bb > :global(.bb-art),
    .pad {
      display: none;
    }
    .units {
      position: static;
      display: grid;
      gap: var(--s-1);
    }
    .unit {
      position: static;
      width: auto !important;
      height: auto !important;
    }
    .hit {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 9fr) minmax(0, 11fr);
      grid-template-rows: auto auto;
      column-gap: var(--s-2);
      align-items: center;
      padding: 10px 12px;
      border-radius: 8px;
      background: radial-gradient(circle, #cfc8b7 1.1px, transparent 1.5px) 0 0 / 10px 10px, var(--ivory);
      box-shadow:
        0 0 0 1px var(--ivory-2),
        2px 4px 10px rgba(0, 0, 0, 0.16);
    }
    .art {
      position: relative;
      grid-row: span 2;
      top: auto !important;
      height: auto !important;
      aspect-ratio: 120 / 80;
    }
    .top .art {
      aspect-ratio: 120 / 76;
    }
    .plate {
      position: static;
      align-self: end;
      width: auto !important;
      height: auto !important;
      padding: 6px 8px;
      font-size: var(--fs-label);
    }
    .tip {
      display: grid;
      position: static;
      align-self: start;
      width: auto;
      max-width: none;
      padding: 4px 8px 0;
      border: 0;
      background: none;
      box-shadow: none;
    }
    .tt {
      font-weight: 500;
    }
    .tp {
      color: var(--ink-2);
    }
    .next {
      min-height: 64px;
      border-radius: 8px;
      font-size: var(--fs-label);
    }
  }
</style>
