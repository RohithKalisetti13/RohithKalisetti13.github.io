---
// Skills: eight parts on the desk under the board, two rows of four, each with a label plate and the
// header pin its jumper leaves (WireLayer draws the jumpers). Positions are board units (var(--u)).
// The grouped list below the parts is the full text: visually hidden on the desk world, the whole
// section on phones, without scripts and with reduced motion.
import SkillPart from './SkillPart.astro';
import { SKILLS, FRAME, PAD, BLOCK, SLOT_W, ROW_Y, PLATE } from '../../lib/skills';

const parts = SKILLS.map((g, i) => {
  const x = (i % 4) * SLOT_W + (SLOT_W - FRAME.w) / 2;
  const y = ROW_Y[Math.floor(i / 4)];
  const [px, py] = PAD[g.kind];
  return { ...g, row: Math.floor(i / 4), style: `--x:${x};--y:${y}`, pad: `--px:${x + px};--py:${y + py}` };
});
---

<h2 id="regs-title" class="sk-title">Skills</h2>
<div class="skills-board" style={`--lift:${BLOCK.lift};--bh:${BLOCK.h};--fw:${FRAME.w};--fh:${FRAME.h};--pdy:${PLATE.dy};--ph:${PLATE.h}`}>
  <svg class="sk-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="sk-tin" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#e6e8ea" />
        <stop offset=".5" stop-color="#c0c3c7" />
        <stop offset="1" stop-color="#8f9397" />
      </linearGradient>
      <linearGradient id="sk-epoxy" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#2c2e33" />
        <stop offset="1" stop-color="#141518" />
      </linearGradient>
      <linearGradient id="sk-can" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#d9dbdd" />
        <stop offset=".6" stop-color="#b9bcc0" />
        <stop offset="1" stop-color="#999da2" />
      </linearGradient>
      <linearGradient id="sk-alu" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#c9ccd0" />
        <stop offset="1" stop-color="#9ea2a7" />
      </linearGradient>
      <radialGradient id="sk-glow">
        <stop offset=".3" stop-color="#7ee3a2" stop-opacity=".5" />
        <stop offset="1" stop-color="#7ee3a2" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="sk-jack" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#d4d6d9" />
        <stop offset="1" stop-color="#a6aaae" />
      </linearGradient>
    </defs>
  </svg>

  <ul class="sk-parts" aria-label="Skill groups">
    {
      parts.map((g) => (
        <li class="sk-unit" style={g.style} data-row={g.row}>
          <button
            type="button"
            class="skill-part"
            data-sk={g.n}
            data-tip
            aria-expanded="false"
            aria-controls="sk-sheet"
            aria-label={`U${g.n}: ${g.name}, ${g.skills.length} skills`}
          >
            <SkillPart kind={g.kind} />
            <span class="sk-plate" aria-hidden="true">
              <span class="ttl">{g.label}</span>
              <span class="pin">{g.silk}</span>
            </span>
            <span class="tip" aria-hidden="true">
              <span class="tt">{g.name}</span>
              <span class="tp">
                U{g.n} &middot; {g.skills.length} skills &middot; {g.silk}
              </span>
            </span>
          </button>
          <span class="sk-pad" style={g.pad} data-wire-from={g.from} data-wire-color={g.color} data-wire-group="skills" data-wire-side={`${g.row}`} data-sk={g.n} aria-hidden="true" />
        </li>
      ))
    }
  </ul>

  <!-- datasheet for the part that was pressed; one at a time, beside nothing modal -->
  <div id="sk-sheet" class="sk-sheet" role="region" aria-labelledby="sk-t1" tabindex="-1" hidden>
    <button type="button" class="sk-x" aria-label="Close datasheet">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
    {
      SKILLS.map((g) => (
        <div class="sk-body" data-sheet={g.n} hidden>
          <p class="sk-kicker">
            Datasheet &middot; {g.skills.length} bits set &middot; jumper {g.silk}
          </p>
          <h3 id={`sk-t${g.n}`}>
            U{g.n} - {g.name.toUpperCase()}
          </h3>
          <ol class="sk-bits">
            {g.skills.map((s, i) => (
              <li class="bit">
                <span class="idx" aria-hidden="true">
                  b{String(i).padStart(2, '0')}
                </span>
                <span class="nm">
                  {s.split('/').map((part, k) => (
                    <>
                      {k > 0 && (
                        <>
                          /<wbr />
                        </>
                      )}
                      {part}
                    </>
                  ))}
                </span>
                <span class="val" aria-hidden="true">
                  1
                </span>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>
  <p class="sr-only" aria-live="polite" data-sk-live></p>

  <div class="sk-list">
    {
      SKILLS.map((g) => (
        <section class="sk-group" aria-labelledby={`sk-g${g.n}`}>
          <h3 id={`sk-g${g.n}`}>{g.name}</h3>
          <ul>
            {g.skills.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</div>

<script>
  import { showTip, hideTip } from '../../lib/tip';
  import { SKILLS } from '../../lib/skills';

  let ac: AbortController | null = null;
  document.addEventListener('astro:before-swap', () => {
    ac?.abort();
    ac = null;
  });

  const init = () => {
    const root = document.querySelector<HTMLElement>('.skills-board');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    ac?.abort();
    ac = new AbortController();
    const signal = ac.signal;
    const sheet = root.querySelector<HTMLElement>('.sk-sheet')!;
    const live = root.querySelector<HTMLElement>('[data-sk-live]')!;
    const parts = [...root.querySelectorAll<HTMLButtonElement>('.skill-part')];
    let open: HTMLButtonElement | null = null;
    let near = '';

    // the part under the pointer or the keyboard lights its wire; an open datasheet keeps its own lit
    const light = () => {
      const svg = document.querySelector<SVGSVGElement>('.wire-layer');
      const n = near || open?.dataset.sk || '';
      if (!svg) return;
      if (n) svg.dataset.skHot = n;
      else delete svg.dataset.skHot;
    };
    const tip = (b: HTMLButtonElement) => {
      const li = b.closest<HTMLElement>('.sk-unit')!;
      const row = li.dataset.row;
      const others = [...root.querySelectorAll<HTMLElement>(`.sk-unit:not([data-row='${row}'])`)].map((u) => u.getBoundingClientRect());
      showTip(li.getBoundingClientRect(), b.querySelector('.tip')!.innerHTML, row === '0' ? 'above' : 'below', others);
    };
    const enter = (b: HTMLButtonElement) => {
      near = b.dataset.sk!;
      light();
      tip(b);
    };
    const leave = () => {
      near = '';
      light();
      hideTip();
    };

    const close = (refocus = true) => {
      const b = open;
      if (!b) return;
      open = null;
      b.setAttribute('aria-expanded', 'false');
      sheet.hidden = true;
      live.textContent = 'Datasheet closed';
      light();
      if (refocus) b.focus({ preventScroll: true });
    };
    const show = (b: HTMLButtonElement) => {
      if (open === b) return close();
      open?.setAttribute('aria-expanded', 'false');
      open = b;
      const n = b.dataset.sk!;
      const g = SKILLS.find((s) => String(s.n) === n)!;
      b.setAttribute('aria-expanded', 'true');
      for (const body of sheet.querySelectorAll<HTMLElement>('.sk-body')) body.hidden = body.dataset.sheet !== n;
      sheet.setAttribute('aria-labelledby', `sk-t${n}`);
      sheet.hidden = false;
      live.textContent = `Datasheet U${n} - ${g.name}: ${g.skills.length} skills`;
      light();
      hideTip();
      sheet.focus({ preventScroll: true });
      // bring the whole sheet into view, never past its top
      const r = sheet.getBoundingClientRect();
      const nav = document.querySelector('.nav')?.getBoundingClientRect().bottom ?? 0;
      const dy = Math.min(r.bottom + 24 - innerHeight, r.top - nav - 16);
      if (dy > 0) window.dispatchEvent(new CustomEvent('rk:scroll-to', { detail: { y: window.scrollY + dy } }));
    };

    for (const b of parts) {
      b.addEventListener('click', () => show(b), { signal });
      b.addEventListener('mouseenter', () => enter(b), { signal });
      b.addEventListener('mouseleave', leave, { signal });
      b.addEventListener('focus', () => b.matches(':focus-visible') && enter(b), { signal });
      b.addEventListener('blur', leave, { signal });
    }
    sheet.querySelector('.sk-x')!.addEventListener('click', () => close(), { signal });
    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key !== 'Escape' || !open) return;
        const a = document.activeElement;
        if (a && a !== document.body && !root.contains(a)) return;
        e.preventDefault();
        close();
      },
      { signal },
    );
  };
  document.addEventListener('astro:after-swap', init);
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .sk-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  .skills-board {
    position: relative;
    z-index: 2;
    width: var(--stage-w);
    margin-left: calc((100% - var(--stage-w)) / 2);
  }
  .sk-parts {
    display: none;
  }

  /* desk world: the parts, tucked under the board's lower edge. Phones, visits without scripts and
     reduced motion get the grouped list as cards instead */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.world) .skills-board {
      margin-top: calc(var(--lift) * var(--u) * -1);
    }
    :global(html.world) .sk-parts {
      position: relative;
      display: block;
      height: calc(var(--bh) * var(--u));
      margin: 0;
      padding: 0;
      list-style: none;
    }
    :global(html.world) .sk-title,
    :global(html.world) .sk-list {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  .sk-unit {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    width: calc(var(--fw) * var(--u));
    height: calc((var(--pdy) + var(--ph)) * var(--u));
  }
  .skill-part {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    border-radius: calc(10 * var(--u));
    background: none;
    color: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .skill-part :global(.sk-art) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: calc(var(--fh) * var(--u));
    overflow: visible;
    filter: drop-shadow(calc(5 * var(--u)) calc(9 * var(--u)) calc(7 * var(--u)) rgba(0, 0, 0, 0.42));
    transition: translate var(--t-fast) var(--ease);
  }
  :global(:root[data-theme='light']) .skill-part :global(.sk-art) {
    filter: drop-shadow(calc(5 * var(--u)) calc(9 * var(--u)) calc(7 * var(--u)) rgba(60, 50, 40, 0.3));
  }

  /* label strip under the part, the bench plate */
  .sk-plate {
    --ivory: #f3efe5;
    --ink: #2a2620;
    --ink-2: #4a443a;
    position: absolute;
    left: calc(10 * var(--u));
    right: calc(10 * var(--u));
    top: calc(var(--pdy) * var(--u));
    height: calc(var(--ph) * var(--u));
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0 0.7em;
    border-radius: 3px;
    background: var(--ivory);
    box-shadow:
      0 0 0 1px #ddd6c5,
      1px 2px 3px rgba(0, 0, 0, 0.12);
    color: var(--ink);
    font: 500 max(10px, calc(19 * var(--u))) / 1 var(--font-mono);
    text-align: left;
  }
  .ttl {
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .pin {
    flex: none;
    padding: 0 0.35em;
    border: 1px solid var(--ink-2);
    border-radius: 3px;
    color: var(--ink-2);
    font-size: 0.9em;
    line-height: 1.1;
  }

  /* power LED on every part: matte green while powered, dark when the board is off */
  .skill-part :global(.sk-led .lens) {
    fill: #46b77a;
    transition: fill 200ms ease-out;
  }
  .skill-part :global(.sk-led .glow) {
    fill: url(#sk-glow);
    opacity: 1;
    transition: opacity 200ms ease-out;
  }
  :global(html:has(.desk[data-power='off'])) .skill-part :global(.sk-led .lens) {
    fill: #26302a;
  }
  :global(html:has(.desk[data-power='off'])) .skill-part :global(.sk-led .glow) {
    opacity: 0;
  }

  /* hover and keyboard focus light the part; the open one keeps a ring */
  .skill-part:is(:hover, :focus-visible, [aria-expanded='true']) :global(.sk-art) {
    translate: 0 -2px;
  }
  .skill-part:hover {
    outline: 2px solid color-mix(in srgb, var(--accent) 50%, transparent);
    outline-offset: calc(6 * var(--u));
  }
  .skill-part:focus-visible,
  .skill-part[aria-expanded='true'] {
    outline: 2px solid var(--accent);
    outline-offset: calc(6 * var(--u));
  }
  .skill-part:is(:hover, :focus-visible) .sk-plate {
    background: #fbf8f1;
  }
  .tip {
    display: none;
  }

  /* datasheet: a page of bit-field cells, every bit set */
  .sk-sheet {
    position: relative;
    margin: var(--s-3) 0 0;
    padding: var(--s-3) var(--s-3) var(--s-3);
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: var(--board);
    color: var(--text);
    box-shadow: 6px 12px 28px rgba(0, 0, 0, 0.3);
  }
  .sk-sheet[hidden] {
    display: none;
  }
  .sk-sheet:focus {
    outline: none;
  }
  .sk-sheet:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .sk-kicker {
    color: var(--text-2);
    font: 500 var(--fs-label) var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .sk-sheet h3 {
    margin: 4px 48px var(--s-2) 0;
    font: 600 1.15rem / 1.3 var(--font-mono);
    letter-spacing: 0.02em;
  }
  .sk-x {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-1);
    background: none;
    color: var(--text);
    cursor: pointer;
  }
  .sk-x:hover {
    border-color: var(--accent);
  }
  .sk-x:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sk-bits {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bit {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 6px 8px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: color-mix(in srgb, var(--text) 4%, transparent);
    font: 500 var(--fs-label-lg) / 1.25 var(--font-mono);
  }
  .nm {
    min-width: 0;
    overflow-wrap: break-word;
  }
  .idx {
    color: var(--text-2);
    font-size: var(--fs-label);
  }
  .val {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 3px;
    background: var(--text);
    color: var(--board);
    font-size: var(--fs-label);
    font-weight: 700;
  }

  /* jumper landing pin; WireLayer draws the wire onto it */
  .sk-pad {
    position: absolute;
    left: calc((var(--px) - var(--x)) * var(--u));
    top: calc((var(--py) - var(--y)) * var(--u));
    width: 4px;
    height: 4px;
    margin: -2px 0 0 -2px;
    pointer-events: none;
  }

  /* the grouped list as cards */
  .sk-title {
    width: var(--stage-w);
    margin: var(--s-6) 0 var(--s-2) calc((100% - var(--stage-w)) / 2);
    color: var(--text);
  }
  .sk-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--s-2);
  }
  .sk-group {
    padding: var(--s-2);
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: var(--board);
  }
  .sk-group h3 {
    margin-bottom: var(--s-1);
    color: var(--text);
    font: 600 var(--fs-label-lg) / 1.3 var(--font-mono);
    letter-spacing: 0.04em;
  }
  .sk-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sk-group li {
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--text);
    font: 500 var(--fs-label-lg) / 1.35 var(--font-mono);
  }
</style>
