---
import LedDot from './LedDot.astro';

// stations of the desk: BOOT and REGS on the board, TRACE and BUILDS on the bench, IRQ on the laptop
const SECTIONS = [
  { id: 'boot', label: 'BOOT', addr: '0x0000', plain: 'Home', color: 'var(--pa0)' },
  { id: 'regs', label: 'REGS', addr: '0x0800', plain: 'Skills', color: 'var(--pa3)' },
  { id: 'trace', label: 'TRACE', addr: '0x1000', plain: 'Work', color: 'var(--pa1)' },
  { id: 'builds', label: 'BUILDS', addr: '0x2000', plain: 'Projects', color: 'var(--pa2)' },
  { id: 'irq', label: 'IRQ', addr: '0x4000', plain: 'Contact', color: 'var(--pa4)' },
];

// absolute hrefs: the nav persists across pages; on the desk the world moves the camera for them
const HASH: Record<string, string> = { boot: 'home', regs: 'skills', trace: 'work', builds: 'projects', irq: 'contact' };
const href = (id: string) => `/#${HASH[id]}`;
---

<header class="nav" transition:name="site-nav" transition:persist transition:animate="none">
  <div class="container bar">
    <a class="mono-mark" href="/#home" aria-label="Rohith Kalisetti, home">RK</a>
    <nav aria-label="Primary">
      <ul>
        <li class="pill" aria-hidden="true"></li>
        {
          SECTIONS.map((s) => (
            <li>
              <a href={href(s.id)} data-sec={s.id} data-addr={s.addr} data-plain={s.plain} data-tag={s.label}>
                <LedDot color={s.color} />
                <span class="tag">{s.label}</span>
                <span class="plain">{s.plain}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="status" aria-hidden="true">
      <span class="row r1"></span>
      <span class="row r2"></span>
    </div>
  </div>
</header>

<script>
  // one reference line at 45% of the viewport decides the active section
  const LINE = 0.45;
  const init = () => {
    const nav = document.querySelector<HTMLElement>('.nav');
    if (!nav || nav.dataset.ready) {
      nav?.dispatchEvent(new Event('rk:sync'));
      return;
    }
    nav.dataset.ready = '1';
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[data-sec]')];
    const pill = nav.querySelector<HTMLElement>('.pill')!;
    const r1 = nav.querySelector('.r1')!;
    const r2 = nav.querySelector('.r2')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pad = (s: string) => s.padEnd(16, ' ').slice(0, 16);
    let current = '';
    let placed = false;

    const place = (a: HTMLElement, instant: boolean) => {
      if (instant || reduced.matches) pill.style.transition = 'none';
      pill.style.width = `${a.offsetWidth}px`;
      pill.style.transform = `translateX(${a.offsetLeft}px)`;
      if (instant || reduced.matches) {
        void pill.offsetWidth;
        pill.style.transition = '';
      }
      pill.style.opacity = '1';
    };

    // 150 ms crossfade of the LCD text
    let swap = 0;
    const lcd = (a: HTMLElement, instant: boolean) => {
      const status = nav.querySelector<HTMLElement>('.status')!;
      const write = () => {
        r1.textContent = pad(`${a.dataset.addr} ${a.dataset.tag}`);
        r2.textContent = pad(a.dataset.plain!.toUpperCase());
      };
      clearTimeout(swap);
      if (instant || reduced.matches) return write();
      status.classList.add('swap');
      swap = window.setTimeout(() => {
        write();
        status.classList.remove('swap');
      }, 150);
    };

    const setActive = (id: string) => {
      const a = links.find((l) => l.dataset.sec === id);
      if (!a) return;
      const first = !placed;
      if (id !== current) {
        current = id;
        for (const l of links) {
          const on = l === a;
          l.classList.toggle('active', on);
          if (on) l.setAttribute('aria-current', 'location');
          else l.removeAttribute('aria-current');
        }
        lcd(a, first);
      }
      place(a, first);
      placed = true;
    };

    const top = (el: Element | null) => (el ? el.getBoundingClientRect().top : Infinity);
    const update = () => {
      const path = location.pathname;
      let id: string;
      const root = document.documentElement;
      const y = innerHeight * LINE;
      if (path.startsWith('/projects/')) id = 'builds';
      else if (path !== '/') id = '';
      else if (root.classList.contains('world')) {
        // the station picks the pair, the scroll position picks within it
        const st = root.dataset.station;
        if (st === 'left') id = 'irq';
        else if (st === 'right') id = top(document.getElementById('projects')) <= y ? 'builds' : 'trace';
        else id = top(document.getElementById('s-regs')) <= y ? 'regs' : 'boot';
      } else {
        id =
          top(document.getElementById('about')) <= y ? 'irq'
          : top(document.getElementById('projects')) <= y ? 'builds'
          : top(document.getElementById('work')) <= y ? 'trace'
          : top(document.getElementById('s-regs')) <= y ? 'regs'
          : 'boot';
      }
      if (id) setActive(id);
      else {
        pill.style.opacity = '0';
        links.forEach((l) => l.classList.remove('active'));
        current = '';
      }
      // the LCD wakes once the hero copy has scrolled away
      const hero = document.getElementById('home');
      nav.classList.toggle('show-status', !!hero && hero.getBoundingClientRect().bottom < nav.offsetHeight);
    };

    // three rect reads per event: cheap enough to run unthrottled, and never stalls behind rAF
    const queue = update;
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', () => {
      placed = false;
      current = '';
      queue();
    });
    nav.addEventListener('rk:sync', () => {
      queue();
    });
    document.fonts?.ready.then(() => {
      placed = false;
      current = '';
      queue();
    });
    update();
  };
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  /* faint row of gold-finger pads along the bottom edge */
  .nav::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 5px;
    background: repeating-linear-gradient(90deg, var(--accent) 0 6px, transparent 6px 10px);
    opacity: 0.22;
    pointer-events: none;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    height: 100%;
  }
  .mono-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--r-2);
    color: var(--text);
    font: 700 var(--fs-label-lg) var(--font-mono);
    letter-spacing: 0.06em;
    text-decoration: none;
  }
  nav {
    margin-right: auto;
  }
  ul {
    position: relative;
    display: flex;
    gap: 2px;
  }
  /* single sliding pill, moved with transform and width */
  .pill {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 0;
    width: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--board) 85%, transparent);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 280ms cubic-bezier(0.4, 0, 0.2, 1),
      width 280ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 150ms linear;
  }
  nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding-inline: 10px;
    border-radius: 999px;
    color: var(--text-2);
    font-size: var(--fs-label-lg);
    text-decoration: none;
  }
  .tag {
    color: var(--muted);
    font: 500 10px var(--font-mono);
    letter-spacing: 0.1em;
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  nav a:hover,
  nav a.active {
    color: var(--text);
  }
  nav a {
    transition: color 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  nav a :global(.led) {
    opacity: 0.4;
    filter: saturate(0.2);
    transition:
      opacity 280ms cubic-bezier(0.4, 0, 0.2, 1),
      filter 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  nav a.active :global(.led) {
    opacity: 1;
    filter: none;
    animation: led-blink 1.2s steps(1, end) infinite;
  }
  @keyframes led-blink {
    50% {
      opacity: 0.25;
    }
  }

  /* 16x2 status character LCD */
  .status {
    display: none;
    flex-direction: column;
    justify-content: center;
    padding: 4px 10px;
    border: 2px solid #25282d;
    border-radius: 4px;
    background: linear-gradient(135deg, #c4ecdb, #a9dcc7);
    box-shadow: inset 0 0 6px rgba(20, 50, 40, 0.35);
    color: #16302a;
    font: 600 11px/1.25 var(--font-mono);
    letter-spacing: 0.08em;
    white-space: pre;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity var(--t-slow) var(--ease),
      transform var(--t-slow) var(--ease);
    pointer-events: none;
  }
  .row {
    display: block;
    min-width: 16ch;
    transition: opacity 150ms linear;
  }
  .status.swap .row {
    opacity: 0;
  }
  .nav.show-status .status {
    opacity: 1;
    transform: none;
  }
  @media (min-width: 1040px) {
    .status {
      display: flex;
    }
  }
  @media (max-width: 720px) {
    .tag {
      display: none;
    }
    .bar {
      gap: 0;
    }
    .mono-mark {
      min-width: 36px;
    }
    nav a {
      gap: 4px;
      padding-inline: 5px;
      font-size: 11px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pill,
    nav a,
    nav a :global(.led),
    .row {
      transition: none;
    }
    nav a.active :global(.led) {
      animation: none;
    }
  }
</style>
