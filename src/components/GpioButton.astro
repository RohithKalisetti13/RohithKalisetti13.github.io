---
interface Props {
  pin: string;
  href?: string;
  variant?: 'primary' | 'secondary';
  download?: boolean | string;
  external?: boolean;
  type?: 'button' | 'submit';
}
const { pin, href, variant = 'primary', download, external, type = 'button' } = Astro.props;
const attrs = href
  ? { href, download, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
  : { type };
---

{
  href ? (
    <a class:list={['gpio', variant]} {...attrs}>
      <span class="switch" aria-hidden="true">
        <i class="leg l1" />
        <i class="leg l2" />
        <i class="leg l3" />
        <i class="leg l4" />
        <span class="body">
          <span class="cap" />
        </span>
      </span>
      <span class="text">
        <slot />
      </span>
      <span class="pin" aria-hidden="true">
        {pin}
      </span>
    </a>
  ) : (
    <button class:list={['gpio', variant]} {...attrs}>
      <span class="switch" aria-hidden="true">
        <i class="leg l1" />
        <i class="leg l2" />
        <i class="leg l3" />
        <i class="leg l4" />
        <span class="body">
          <span class="cap" />
        </span>
      </span>
      <span class="text">
        <slot />
      </span>
      <span class="pin" aria-hidden="true">
        {pin}
      </span>
    </button>
  )
}

<style>
  .gpio {
    --cap: var(--accent);
    --cap-down: color-mix(in srgb, var(--accent) 70%, black);
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding: 6px var(--s-2) 6px 6px;
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: var(--board);
    color: var(--text);
    font: 500 var(--fs-body) var(--font-sans);
    text-decoration: none;
    cursor: pointer;
    transition: border-color var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
  }
  .gpio:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .secondary {
    --cap: var(--muted);
    --cap-down: color-mix(in srgb, var(--muted) 65%, black);
    background: transparent;
  }
  .switch {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
  }
  .body {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    background: var(--board-2);
    border: 1px solid var(--line);
    border-radius: var(--r-1);
  }
  .cap {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--cap);
    box-shadow: 0 1px 0 var(--cap-down);
    transition: transform 120ms ease-out, background 120ms ease-out, box-shadow 120ms ease-out;
  }
  .gpio:active .cap {
    transform: translateY(1px);
    background: var(--cap-down);
    box-shadow: none;
  }
  .leg {
    position: absolute;
    width: 4px;
    height: 3px;
    background: var(--muted);
    border-radius: 1px;
  }
  .l1 { top: 0; left: 4px; }
  .l2 { top: 0; right: 4px; }
  .l3 { bottom: 0; left: 4px; }
  .l4 { bottom: 0; right: 4px; }
  .pin {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--muted);
  }
</style>
