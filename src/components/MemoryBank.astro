---
// Work experience as a small memory daughterboard: SPI flash for the recent roles, I2C EEPROMs
// for the earlier ones. Each chip opens the work drawer; the ribbon from CN5 lands on J1, a row of
// gold fingers on the board's edge. Green solder mask in both themes, copper showing through it.
import type { CollectionEntry } from 'astro:content';
import { hexAt } from '../lib/hex';

interface Props {
  work: CollectionEntry<'work'>[];
}
const { work } = Astro.props;
const flash = work.filter((w) => w.data.kind === 'flash');
const rom = work.filter((w) => w.data.kind === 'rom');
const short = (slug: string) => slug.replace(/-/g, ' ').toUpperCase();
const span = (w: CollectionEntry<'work'>) => `${w.data.start} – ${w.data.end}`;
// generic laser marks: a part description over a lot code
const LOT = ['A', 'B', 'C', 'D', 'E', 'F'];

// copper under the mask: buses with 45-degree bends, and their vias (drawn in a 600x300 box, cropped to fit)
const TRACES = [
  'M0 46H120L140 66H300L318 48H600',
  'M0 54H116L136 74H296L314 56H600',
  'M0 62H112L132 82H292L310 64H600',
  'M40 300V236L60 216H220L240 196V120',
  'M48 300V240L68 220H228L248 200V124',
  'M330 300V250L350 230H520L540 210V150L560 130H600',
  'M338 300V254L358 234H524L544 214V154L564 134H600',
  'M150 0V22L170 42',
  'M450 0V20L470 40',
  'M200 120V160L220 180H300',
  'M420 120V170L440 190H500',
  'M560 300V270L580 250H600',
];
const VIAS = [
  [170, 42], [470, 40], [240, 120], [248, 124], [300, 180], [500, 190], [560, 130], [564, 134], [120, 46], [80, 230], [400, 254], [580, 250],
];

// J1, top to bottom, in CN5 order, so the ribbon from the board runs straight across without crossing
const J1 = [
  { silk: 'SCL/D15', pin: 'PB8', color: '#e3b23c', shared: true },
  { silk: 'SDA/D14', pin: 'PB9', color: '#3f86d8', shared: true },
  { silk: 'SCK/D13', pin: 'PA5', color: '#7a5136' },
  { silk: 'MISO/D12', pin: 'PA6', color: '#b5473d' },
  { silk: 'MOSI/D11', pin: 'PA7', color: '#c77a33' },
  { silk: 'CS/D10', pin: 'PB6', color: '#4f8a4f' },
  { silk: 'D9', pin: 'PC7', color: '#6d5596' },
  { silk: 'D8', pin: 'PA9', color: '#7d7f84' },
];
---

<div class="mb">
  <div class="db">
    <svg class="copper" viewBox="0 0 600 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <g fill="none" stroke="#24693e" stroke-width="2.2" stroke-linejoin="round">
        {TRACES.map((d) => <path d={d} />)}
      </g>
      <g fill="none" stroke="#5aa874" stroke-width="0.6" opacity="0.5" transform="translate(-0.6 -0.6)">
        {TRACES.map((d) => <path d={d} />)}
      </g>
      {
        VIAS.map(([x, y]) => (
          <g>
            <circle cx={x} cy={y} r="3.4" fill="#24693e" />
            <circle cx={x} cy={y} r="1.5" fill="#123d22" />
          </g>
        ))
      }
    </svg>
    <span class="hole" style="left:12px;top:12px"></span>
    <span class="hole" style="right:12px;top:12px"></span>
    <span class="hole" style="left:12px;bottom:12px"></span>
    <span class="hole" style="right:12px;bottom:12px"></span>

    <div class="chips">
      <p class="silk bank">FLASH - current roles</p>
      <ul class="row">
        {
          flash.map((w, i) => (
            <li>
              <button type="button" class="ic soic" data-drawer-open={`work/${w.id}`}>
                <span class="pkg" aria-hidden="true">
                  <i class="legs" />
                  <i class="body" data-mark="FLASH 16M" data-code={`2318 ${LOT[i]}`}>
                    <i class="dot" />
                  </i>
                  <i class="legs" />
                  <i class="smd c" />
                  <i class="smd r" />
                </span>
                <span class="led" aria-hidden="true" />
                <span class="ref silk" aria-hidden="true">
                  U{i + 1}
                </span>
                <span class="addr">{w.data.address}</span>
                <span class="name">{short(w.id)}</span>
                <span class="tip">
                  <span class="t-role">{w.data.role}</span>, <span class="t-org">{w.data.org}</span>, <span class="t-date">{span(w)}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
      <p class="silk bank dim">ROM - earlier roles</p>
      <ul class="row">
        {
          rom.map((w, i) => (
            <li>
              <button type="button" class="ic tssop" data-drawer-open={`work/${w.id}`}>
                <span class="pkg" aria-hidden="true">
                  <i class="legs" />
                  <i class="body" data-mark="24C256" data-code={`2207 ${LOT[i]}`}>
                    <i class="dot" />
                  </i>
                  <i class="legs" />
                  <i class="smd c" />
                </span>
                <span class="led" aria-hidden="true" />
                <span class="ref silk" aria-hidden="true">
                  U{flash.length + i + 1}
                </span>
                <span class="addr">{w.data.address}</span>
                <span class="name">{short(w.id)}</span>
                <span class="tip">
                  <span class="t-role">{w.data.role}</span>, <span class="t-org">{w.data.org}</span>, <span class="t-date">{span(w)}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="j1" aria-hidden="true">
      <p class="silk">J1 &middot; CN5</p>
      <ul>
        {
          J1.map((p) => (
            <li>
              <span class="silk">{p.silk}</span>
              <span
                class="pad"
                data-wire-from={`#hero-cn5 [data-pin='${p.pin}']`}
                data-wire-color={p.color}
                data-wire-group="trace"
                {...(p.shared ? { 'data-wire-shared': '' } : {})}
              />
            </li>
          ))
        }
      </ul>
      <p class="silk bus">SPI &middot; I2C</p>
    </div>

    <p class="silk tag">RK-MEM1 REV A</p>
  </div>

  <!-- every role in full, for screen readers and for visits without scripts -->
  <ol class="fallback">
    {
      work.map((w) => (
        <li>
          <h3>
            {w.data.role}, {w.data.org}
          </h3>
          <p>
            {w.data.location}, {span(w)}
          </p>
          <ul>
            {w.data.bullets.map((b, i) => (
              <li>
                <span class="mono">{hexAt(w.data.address, i)}</span> {b}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
  <noscript>
    <style is:inline>
      .mb .fallback { position: static; width: auto; height: auto; clip-path: none; white-space: normal; margin-top: 32px; display: grid; gap: 24px; }
      .mb .fallback ul { display: grid; gap: 8px; margin-top: 8px; }
    </style>
  </noscript>
</div>

<style>
  .mb {
    --mask: #1c5a33;
    --mask-2: #143f24;
    --gold: #c9a24a;
    --silk: #eef3ef;
    --silk-dim: #c6d8cf;
    margin-top: var(--s-4);
  }
  .db {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--s-3);
    width: min(100%, 960px, 80cqw - 48px);
    margin-inline: auto;
    padding: 34px 28px 40px 40px;
    border-radius: 6px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.06), transparent 45%),
      var(--mask);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      inset 0 0 0 1px rgba(0, 0, 0, 0.18),
      0 2px 0 var(--mask-2),
      10px 16px 28px rgba(0, 0, 0, 0.38);
    isolation: isolate;
  }
  /* copper under the mask; the chips and silkscreen sit above it */
  .copper {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    opacity: 0.7;
  }
  .hole {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 3px solid var(--gold);
    border-radius: 50%;
    background: var(--desk);
  }
  .silk {
    color: var(--silk);
    font: 500 var(--fs-label) var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .bank {
    margin-bottom: var(--s-2);
    text-transform: none;
  }
  .bank.dim {
    margin-top: var(--s-4);
    color: var(--silk-dim);
  }
  .row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-3);
  }

  /* one chip with its LED, reference and silkscreen */
  .ic {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 2px;
    width: 100%;
    min-height: 44px;
    padding: 6px 8px 8px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--silk);
    text-align: left;
    cursor: pointer;
  }
  .ic:hover {
    background: rgba(255, 255, 255, 0.04);
  }
  .ic:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .pkg {
    position: relative;
    display: grid;
    width: 78%;
    margin: 6px 0 12px 6px;
  }
  /* white silkscreen corner brackets around the footprint */
  .pkg::before {
    --k: var(--silk);
    content: '';
    position: absolute;
    inset: -5px -7px;
    background:
      linear-gradient(var(--k), var(--k)) left top / 9px 1.5px,
      linear-gradient(var(--k), var(--k)) left top / 1.5px 9px,
      linear-gradient(var(--k), var(--k)) right top / 9px 1.5px,
      linear-gradient(var(--k), var(--k)) right top / 1.5px 9px,
      linear-gradient(var(--k), var(--k)) left bottom / 9px 1.5px,
      linear-gradient(var(--k), var(--k)) left bottom / 1.5px 9px,
      linear-gradient(var(--k), var(--k)) right bottom / 9px 1.5px,
      linear-gradient(var(--k), var(--k)) right bottom / 1.5px 9px;
    background-repeat: no-repeat;
    opacity: 0.85;
  }
  /* matte black package with laser-etched marks */
  .body {
    position: relative;
    display: block;
    border-radius: 2px;
    background: linear-gradient(160deg, #26272b, #151619 70%);
    box-shadow:
      inset 1px 1px 0 rgba(255, 255, 255, 0.08),
      4px 6px 7px rgba(0, 0, 0, 0.42);
  }
  .body::after {
    content: attr(data-mark) '\A' attr(data-code);
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    color: #8b8d92;
    font: 500 10px / 1.35 var(--font-mono);
    letter-spacing: 0.06em;
    text-align: center;
    white-space: pre;
  }
  /* 0603 parts beside each chip: a decoupling cap, a pull-up */
  .smd {
    position: absolute;
    right: -24px;
    width: 9px;
    height: 16px;
    border-radius: 1px;
    box-shadow: 1px 2px 2px rgba(0, 0, 0, 0.35);
  }
  .smd.c {
    top: 14%;
    background: linear-gradient(#c7c9cc 0 22%, #b38f63 22% 78%, #c7c9cc 78%);
  }
  .smd.r {
    bottom: 14%;
    background: linear-gradient(#c7c9cc 0 22%, #1d1e21 22% 78%, #c7c9cc 78%);
  }
  .dot {
    position: absolute;
    left: 8px;
    bottom: 8px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0a0a0b;
    box-shadow: inset 1px 1px 1px rgba(255, 255, 255, 0.12);
  }
  /* four legs per side, drawn as one repeating gradient */
  .legs {
    display: block;
    height: 10px;
    margin-inline: 12%;
    background: repeating-linear-gradient(
        to right,
        transparent 0 6%,
        #c7c9cc 6% 19%,
        transparent 19% 25%
      );
  }
  .soic .body {
    height: 52px;
  }
  /* legacy EEPROMs: a smaller TSSOP-8, finer legs, dimmer marks */
  .tssop .pkg {
    width: 52%;
  }
  .tssop .body {
    height: 30px;
    border-radius: 1.5px;
  }
  .tssop .body::after {
    color: #707277;
    font-size: 8.5px;
    line-height: 1.25;
  }
  .tssop .legs {
    height: 6px;
    margin-inline: 16%;
    background: repeating-linear-gradient(to right, transparent 0 9%, #a9abae 9% 16%, transparent 16% 25%);
  }
  .tssop .dot {
    left: 5px;
    bottom: 5px;
    width: 4px;
    height: 4px;
  }
  .tssop .pkg::before {
    --k: var(--silk-dim);
    opacity: 0.6;
  }
  .tssop .smd {
    right: -20px;
    top: 50%;
    width: 7px;
    height: 12px;
    margin-top: -6px;
  }
  .led {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 12px;
    height: 7px;
    border-radius: 1.5px;
    background: #3b4a3f;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.35),
      2px 2px 2px rgba(0, 0, 0, 0.35);
    transition: background var(--t-fast) var(--ease);
  }
  .ref {
    position: absolute;
    top: 6px;
    right: 26px;
    font-size: 11px;
  }
  .soic .led,
  .soic .ref {
    top: 2px;
  }
  .ic:hover .led,
  .ic:focus-visible .led,
  .ic[aria-current='true'] .led {
    background: #5fd08f;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.2),
      inset -2px -1px 0 rgba(255, 255, 255, 0.4),
      2px 2px 2px rgba(0, 0, 0, 0.35);
  }
  .addr {
    font: 500 var(--fs-label-lg) var(--font-mono);
    letter-spacing: 0.02em;
  }
  .name {
    font: 500 var(--fs-label) var(--font-mono);
    letter-spacing: 0.08em;
  }
  .tssop .addr,
  .tssop .name {
    color: var(--silk-dim);
  }

  /* tooltip: role, company, dates */
  .tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 6px);
    z-index: 3;
    width: max-content;
    max-width: 300px;
    padding: 8px 12px;
    border: 1px solid #2c3a35;
    border-radius: 8px;
    background: #101614;
    color: #e8efe9;
    font: 400 var(--fs-label-lg) / 1.45 var(--font-sans);
    box-shadow: 6px 10px 18px rgba(0, 0, 0, 0.35);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    translate: -50% 4px;
    transition:
      opacity var(--t-fast) var(--ease),
      translate var(--t-fast) var(--ease),
      visibility 0s var(--t-fast);
  }
  .t-role {
    font-weight: 600;
  }
  .t-date {
    color: #b9ccc5;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
  }
  .ic:hover .tip,
  .ic:focus-visible .tip {
    opacity: 1;
    visibility: visible;
    translate: -50% 0;
    transition-delay: 0s;
  }

  /* J1 input header, wired from CN5 */
  .j1 {
    display: grid;
    align-content: center;
    justify-items: end;
    gap: var(--s-1);
    padding-left: var(--s-2);
    border-left: 1px dashed rgba(228, 237, 232, 0.25);
  }
  .j1 ul {
    position: relative;
    display: grid;
    gap: 6px;
    padding-block: 6px;
  }
  /* the fingers run off the board's edge */
  .j1 ul {
    margin-right: -28px;
  }
  .j1 li {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
  }
  .j1 li .silk {
    font-size: 11px;
    white-space: nowrap;
  }
  /* gold finger: plated strip with a lit upper edge, worn a little where the contact rides */
  .pad {
    position: relative;
    z-index: 1;
    display: block;
    width: 34px;
    height: 16px;
    border-radius: 2px 0 0 2px;
    background:
      linear-gradient(rgba(255, 255, 255, 0.35), transparent 30%, transparent 70%, rgba(0, 0, 0, 0.18)),
      linear-gradient(90deg, #a8852f, #e2c46c 45%, #c9a24a);
    box-shadow: inset 0 0 0 1px rgba(110, 82, 24, 0.55);
  }
  .j1 .bus {
    color: var(--silk-dim);
  }
  .tag {
    position: absolute;
    left: 40px;
    bottom: 12px;
    color: var(--silk-dim);
    font-size: 11px;
  }

  .fallback {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* desk world: half the board's width, J1 on the left edge facing CN5 */
  :global(html.world) .db {
    grid-template-columns: auto 1fr;
    width: max(calc(760 * var(--u)), 560px);
    margin-inline: 0;
    padding: 30px 28px 20px 24px;
  }
  :global(html.world) .j1 {
    order: -1;
    justify-items: start;
    padding-left: 0;
    padding-right: var(--s-2);
    border-left: 0;
    border-right: 1px dashed rgba(228, 237, 232, 0.25);
  }
  /* pads at the header's 0.1 in pitch, low on the board so the ribbon from CN5 runs level */
  :global(html.world) .j1 {
    align-content: end;
  }
  :global(html.world) .j1 ul {
    gap: max(4px, calc(53 * var(--u) - 16px));
  }
  /* the bus label rides under the title, so the pads sit at the board's foot and the board ends close below CN5 */
  :global(html.world) .j1 > p:first-child {
    order: -2;
  }
  :global(html.world) .j1 .bus {
    order: -1;
  }
  :global(html.world) .j1 ul {
    margin-right: 0;
    margin-left: -24px;
  }
  :global(html.world) .pad {
    border-radius: 0 2px 2px 0;
    background:
      linear-gradient(rgba(255, 255, 255, 0.35), transparent 30%, transparent 70%, rgba(0, 0, 0, 0.18)),
      linear-gradient(270deg, #a8852f, #e2c46c 45%, #c9a24a);
  }
  :global(html.world) .j1 li {
    flex-direction: row-reverse;
  }
  :global(html.world) .row {
    gap: var(--s-1);
  }
  :global(html.world) .tag {
    left: auto;
    right: 28px;
  }

  @media (max-width: 960px) {
    .row {
      gap: var(--s-2);
    }
  }
  @media (max-width: 720px) {
    .db {
      grid-template-columns: 1fr;
      width: 100%;
      padding: 32px 16px 40px;
    }
    .j1 {
      display: none;
    }
    .row {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }
    .ic {
      grid-template-columns: 76px 1fr;
      column-gap: var(--s-2);
      align-items: center;
      padding: 10px 8px;
    }
    .pkg {
      grid-row: 1 / span 3;
      margin: 0;
    }
    .tssop .pkg {
      width: 52px;
    }
    .soic .body {
      height: 44px;
    }
    .tssop .body {
      height: 28px;
    }
    .smd {
      display: none;
    }
    /* the cropped copper scales up on a narrow board; keep it a texture under the text */
    .copper {
      opacity: 0.4;
    }
    .addr,
    .name {
      grid-column: 2;
    }
    /* the tooltip becomes the visible role line */
    .tip {
      position: static;
      grid-column: 2;
      width: auto;
      max-width: none;
      padding: 0;
      border: 0;
      background: none;
      box-shadow: none;
      color: var(--silk);
      opacity: 1;
      visibility: visible;
      translate: none;
    }
    .t-date {
      color: var(--silk-dim);
    }
    .ref {
      display: none;
    }
  }
</style>
