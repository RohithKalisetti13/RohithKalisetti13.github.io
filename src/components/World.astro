---
// One desk, three stations side by side: left = laptop, center = MCU board, right = bench.
// On wide screens (html.world, set before first paint) a camera glides between stations and the
// document scrolls vertically as usual. Without that class it is a plain vertical stack in DOM
// order: center, right, left.
---

<div class="world" data-world>
  <div class="camera">
    <div class="station" data-station="center"><slot name="center" /></div>
    <div class="station" data-station="right"><slot name="right" /></div>
    <div class="station" data-station="left"><slot name="left" /></div>
    <slot />
  </div>
  <button type="button" class="edge prev" data-go="-1" aria-label="Previous station" hidden>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button type="button" class="edge next" data-go="1" aria-label="Next station" hidden>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button type="button" class="ov-toggle" aria-pressed="false" aria-label="Zoom out to see all stations" hidden>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <rect x="2.5" y="6" width="5" height="12" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.8" />
      <rect x="9.5" y="4" width="5" height="16" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.8" />
      <rect x="16.5" y="7" width="5" height="10" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.8" />
    </svg>
    <span class="mono">Overview</span>
  </button>
  <div class="ov-layer" role="group" aria-label="Stations" hidden>
    <button type="button" class="ov-pick" data-pick="left"><span class="ov-chip mono">IDE – About, Contact</span></button>
    <button type="button" class="ov-pick" data-pick="center"><span class="ov-chip mono">MCU – Home, Skills</span></button>
    <button type="button" class="ov-pick" data-pick="right"><span class="ov-chip mono">Bench – Work, Projects</span></button>
  </div>
  <p class="sr-only" aria-live="polite" data-world-live></p>
</div>

<script>
  import { STATIONS, stationOf, readPos, type Pos, type Station } from '../lib/world';

  const root = document.documentElement;
  const NAMES: Record<Station, string> = {
    left: 'Laptop: about and contact',
    center: 'Board: home and skills',
    right: 'Bench: work and projects',
  };
  const HEADINGS: Record<Station, string> = { left: '#about-title', center: '#home-title', right: '#work-title' };
  // every hash is an anchor: a station plus a scroll position. The section heading lands just below
  // the nav bar; Home is the top of the page.
  const TARGETS: Record<string, { sel: string | null }> = {
    home: { sel: null },
    skills: { sel: '#regs-title' },
    work: { sel: '#work-title' },
    projects: { sel: '#projects-title' },
    about: { sel: '#about-title' },
    contact: { sel: '#about-title' },
  };
  // where a station lands when it is reached without a hash (arrows, edge buttons, swipe)
  const HOME_OF: Record<Station, string> = { left: 'contact', center: 'home', right: 'work' };
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const wide = window.matchMedia('(min-width: 1024px)');

  const save = (s: Station) => {
    try {
      sessionStorage.setItem('rk-station', s);
    } catch {
      /* storage blocked: a reload starts at the board */
    }
  };
  const scrollTo = (y: number, immediate = false) =>
    window.dispatchEvent(new CustomEvent('rk:scroll-to', { detail: { y: Math.max(0, Math.round(y)), immediate } }));
  const navH = () => document.querySelector<HTMLElement>('.nav')?.offsetHeight ?? 52;
  // layout position on the page; ignores the camera's transform, even mid-zoom
  const docY = (el: HTMLElement) => {
    let y = 0;
    for (let n: HTMLElement | null = el; n; n = n.offsetParent as HTMLElement | null) y += n.offsetTop;
    return y;
  };

  // back and forward restore their own scroll position; a hash must not override it
  let traverse = false;
  document.addEventListener('astro:before-preparation', (e) => (traverse = e.navigationType === 'traverse'));

  let ac: AbortController | null = null;
  document.addEventListener('astro:before-swap', () => {
    ac?.abort();
    ac = null;
  });

  const init = () => {
    const world = document.querySelector<HTMLElement>('[data-world]');
    if (!world || world.dataset.bound) return;
    world.dataset.bound = '1';
    ac?.abort();
    ac = new AbortController();
    const signal = ac.signal;
    const camera = world.querySelector<HTMLElement>('.camera')!;
    const stations = new Map(STATIONS.map((s) => [s, world.querySelector<HTMLElement>(`.station[data-station="${s}"]`)!]));
    const live = world.querySelector<HTMLElement>('[data-world-live]')!;
    const prev = world.querySelector<HTMLButtonElement>('.edge.prev')!;
    const next = world.querySelector<HTMLButtonElement>('.edge.next')!;

    const on = () => root.classList.contains('world');
    const current = () => (STATIONS.includes(root.dataset.station as Station) ? (root.dataset.station as Station) : 'center');
    // a drawer or the laptop zoom owns the keyboard and the wheel; the overview takes only its own keys
    const busy = () => !!document.querySelector('dialog[open]') || root.dataset.zoom === 'in';
    const overview = () => root.dataset.overview === 'on';
    const blocked = () => busy() || overview();
    const toggle = world.querySelector<HTMLButtonElement>('.ov-toggle')!;
    const layer = world.querySelector<HTMLElement>('.ov-layer')!;
    const picks = [...layer.querySelectorAll<HTMLButtonElement>('.ov-pick')];

    // off-screen stations leave the tab order; edge arrows only where a neighbour exists
    const sync = () => {
      const s = current();
      const i = STATIONS.indexOf(s);
      for (const [k, el] of stations) el.inert = on() && (k !== s || overview());
      toggle.hidden = !on();
      prev.hidden = !on() || i === 0;
      next.hidden = !on() || i === STATIONS.length - 1;
      prev.setAttribute('aria-label', i > 0 ? `Go to ${NAMES[STATIONS[i - 1]]}` : 'Previous station');
      next.setAttribute('aria-label', i < STATIONS.length - 1 ? `Go to ${NAMES[STATIONS[i + 1]]}` : 'Next station');
      document.querySelector('.nav')?.dispatchEvent(new Event('rk:sync'));
    };

    // the camera has stopped (or jumped): wires and anything measured re-anchor
    const settled = () => {
      world.classList.remove('moving');
      window.dispatchEvent(new Event('rk:world-moved'));
    };
    // the overview's own glides end in their own step
    let ovEnd: (() => void) | null = null;
    camera.addEventListener(
      'transitionend',
      (e) => {
        if (e.target !== camera || e.propertyName !== 'transform') return;
        if (ovEnd) ovEnd();
        else settled();
      },
      { signal },
    );

    // scroll position of an anchor; headings sit one nav height plus a margin below the top edge
    const anchorY = (id: string) => {
      const t = TARGETS[id];
      const el = t?.sel ? document.querySelector<HTMLElement>(t.sel) : null;
      if (!el) return 0;
      return Math.max(0, docY(el) - navH() - 56);
    };

    const go = (s: Station, opts: { y?: number | 'keep'; focus?: boolean; immediate?: boolean } = {}) => {
      if (!on()) return;
      // from the overview, the camera zooms back in on the station instead
      if (ov) return leave(s, typeof opts.y === 'number' ? opts.y : null, opts.focus !== false);
      const from = current();
      const instant = reduced.matches;
      if (s !== from) {
        if (!instant) world.classList.add('moving');
        root.dataset.station = s;
        save(s);
        sync();
        live.textContent = NAMES[s];
        if (instant) settled();
      }
      // a new station always lands on its anchor; the same station stays put unless told where to go
      const y = opts.y === 'keep' && s === from ? window.scrollY : typeof opts.y === 'number' ? opts.y : anchorY(HOME_OF[s]);
      if (Math.abs(y - window.scrollY) > 1) scrollTo(y, instant || !!opts.immediate);
      if (opts.focus !== false && s !== from) {
        const h = document.querySelector<HTMLElement>(HEADINGS[s]);
        if (h) {
          if (!h.hasAttribute('tabindex')) h.setAttribute('tabindex', '-1');
          h.focus({ preventScroll: true });
        }
      }
    };
    const step = (dir: number) => {
      const i = STATIONS.indexOf(current()) + dir;
      if (i >= 0 && i < STATIONS.length) go(STATIONS[i]);
    };

    // hash targets: station first, then the vertical spot
    const goHash = (id: string, focus = true, immediate = false) => {
      const s = stationOf(`#${id}`);
      if (!s || !(id in TARGETS)) return false;
      // the laptop waits for the camera to land before it opens the terminal
      if (ov) world.classList.add('moving');
      // anywhere else, leave the laptop screen first
      if (s !== 'left' && root.dataset.zoom === 'in') window.dispatchEvent(new Event('rk:zoom-out'));
      if (id === 'contact' || id === 'about') window.dispatchEvent(new CustomEvent('rk:laptop', { detail: id }));
      go(s, { y: anchorY(id), focus, immediate });
      return true;
    };

    window.addEventListener(
      'rk:goto',
      (e) => {
        const id = (e as CustomEvent<string>).detail;
        if (on() && goHash(id)) e.preventDefault();
      },
      { signal },
    );
    window.addEventListener(
      'rk:go',
      (e) => {
        const d = (e as CustomEvent<Station>).detail;
        if (STATIONS.includes(d)) go(d);
      },
      { signal },
    );

    // back and forward inside the page: the entry's own station and scrollY, with no glide and no anchor
    let popped = -1e9;
    const jump = (pos: Pos) => {
      drop();
      world.classList.remove('ready', 'moving');
      root.dataset.station = pos.st;
      save(pos.st);
      sync();
      settled();
      window.scrollTo({ top: pos.y, left: 0, behavior: 'instant' });
      scrollTo(pos.y, true);
      requestAnimationFrame(() => requestAnimationFrame(() => world.classList.add('ready')));
    };
    window.addEventListener(
      'popstate',
      () => {
        popped = performance.now();
        const pos = readPos();
        if (on() && pos && root.dataset.zoom !== 'in') jump(pos);
      },
      { signal },
    );

    // a hash changed in place (typed, or a drawer deep link) moves the camera too
    window.addEventListener(
      'hashchange',
      () => {
        if (performance.now() - popped < 200) return;
        const id = decodeURIComponent(location.hash.slice(1));
        const s = stationOf(location.hash);
        if (!on() || !s) return;
        if (id in TARGETS) goHash(id);
        else go(s, { y: 'keep', focus: false });
      },
      { signal },
    );

    prev.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));

    document.addEventListener(
      'keydown',
      (e) => {
        if (!on() || blocked() || e.defaultPrevented || e.altKey || e.metaKey || e.ctrlKey || e.shiftKey) return;
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        const t = e.target as Element | null;
        if (t?.closest('input, textarea, select, [contenteditable], [role="tablist"], [role="slider"], pre')) return;
        e.preventDefault();
        step(e.key === 'ArrowLeft' ? -1 : 1);
      },
      { signal },
    );

    // horizontal trackpad swipe: one station per gesture, and never the browser's back swipe
    let acc = 0;
    let lockUntil = 0;
    let reset = 0;
    window.addEventListener(
      'wheel',
      (e) => {
        if (!on() || Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
        e.preventDefault();
        if (blocked() || performance.now() < lockUntil) return;
        acc += e.deltaX;
        clearTimeout(reset);
        reset = window.setTimeout(() => (acc = 0), 180);
        if (Math.abs(acc) < 60) return;
        step(acc > 0 ? 1 : -1);
        acc = 0;
        lockUntil = performance.now() + 900;
      },
      { passive: false, signal },
    );

    // click and drag: the camera follows the pointer, with a soft give past the first and last
    // station, and the release lands on the nearest one (a flick or a long pull takes the neighbour,
    // never more). Never from anything that takes a click, the keyboard or a text selection
    const NO_DRAG =
      'a, button, input, textarea, select, label, summary, [role="tab"], [role="tablist"], [role="slider"], [contenteditable], nav, dialog, .ide, pre, code, .wire-hit, .skill-part, .sk-sheet, h1, h2, h3, h4, p, li';
    type Drag = { id: number; x: number; y: number; dx: number; on: boolean; base: number; stops: number[]; t: number; v: number };
    let drag: Drag | null = null;
    // camera offset that frames each station, from layout
    const stops = () => {
      const c = camera.getBoundingClientRect().left;
      const w = world.clientWidth;
      return STATIONS.map((s) => {
        const r = stations.get(s)!.getBoundingClientRect();
        return -(r.left - c + r.width - w);
      });
    };
    const give = (over: number) => (world.clientWidth / 2) * (1 - 1 / (over / world.clientWidth + 1));
    const eatClick = (e: Event) => {
      e.preventDefault();
      e.stopImmediatePropagation();
    };

    window.addEventListener(
      'pointerdown',
      (e) => {
        if (drag || !on() || blocked() || e.button !== 0 || e.pointerType === 'touch' || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
        const t = e.target as Element | null;
        if (!t?.closest || !world.contains(t) || t.closest(NO_DRAG)) return;
        drag = { id: e.pointerId, x: e.clientX, y: e.clientY, dx: 0, on: false, base: 0, stops: [], t: e.timeStamp, v: 0 };
      },
      { signal },
    );
    window.addEventListener(
      'pointermove',
      (e) => {
        if (!drag || e.pointerId !== drag.id) return;
        const dx = e.clientX - drag.x;
        if (!drag.on) {
          const dy = e.clientY - drag.y;
          if (Math.hypot(dx, dy) < 8) return;
          if (Math.abs(dx) <= Math.abs(dy) || blocked()) return void (drag = null);
          drag.on = true;
          drag.base = new DOMMatrixReadOnly(getComputedStyle(camera).transform).m41;
          drag.stops = stops();
          root.classList.add('dragging');
          world.classList.add('moving');
          getSelection()?.removeAllRanges();
          try {
            root.setPointerCapture(e.pointerId);
          } catch {
            /* the window listeners still see the rest of the drag */
          }
        }
        const dt = e.timeStamp - drag.t;
        if (dt > 0) drag.v = 0.7 * ((dx - drag.dx) / dt) + 0.3 * drag.v;
        drag.t = e.timeStamp;
        drag.dx = dx;
        if (reduced.matches) return;
        const [first] = drag.stops;
        const last = drag.stops[drag.stops.length - 1];
        const x = drag.base + dx;
        camera.style.transform = `translate3d(${x > first ? first + give(x - first) : x < last ? last - give(last - x) : x}px, 0, 0)`;
      },
      { signal },
    );
    const release = (e: Event) => {
      const d = drag;
      if (!d || (e instanceof PointerEvent && e.pointerId !== d.id)) return;
      drag = null;
      if (!d.on) return;
      root.classList.remove('dragging');
      if (root.hasPointerCapture(d.id)) root.releasePointerCapture(d.id);
      // the click that ends a drag presses nothing
      if (e.type === 'pointerup') {
        window.addEventListener('click', eatClick, { capture: true, once: true });
        setTimeout(() => window.removeEventListener('click', eatClick, true), 0);
      }
      const from = STATIONS.indexOf(current());
      const x = d.base + d.dx;
      const v = e.timeStamp - d.t > 80 ? 0 : d.v;
      let to = d.stops.reduce((best, s, i) => (Math.abs(s - x) < Math.abs(d.stops[best] - x) ? i : best), from);
      if (to === from && (Math.abs(d.dx) > world.clientWidth * 0.15 || (Math.abs(v) > 0.5 && Math.sign(v) === Math.sign(d.dx)))) to = from - Math.sign(d.dx);
      to = e.type === 'pointerup' ? Math.max(0, Math.min(STATIONS.length - 1, Math.max(from - 1, Math.min(from + 1, to)))) : from;
      camera.style.transform = '';
      if (to !== from) return go(STATIONS[to]);
      // back to where it was: the glide home ends in transitionend, a camera that never left settles now
      if (reduced.matches || Math.abs(new DOMMatrixReadOnly(getComputedStyle(camera).transform).m41 - d.stops[from]) < 1) settled();
    };
    window.addEventListener('pointerup', release, { signal });
    window.addEventListener('pointercancel', release, { signal });
    window.addEventListener('blur', release, { signal });
    // no image drag or text selection while the camera is held
    for (const t of ['dragstart', 'selectstart'] as const) window.addEventListener(t, (e) => drag?.on && e.preventDefault(), { signal });

    // overview: the whole desk scaled down until all three stations fit side by side under the nav.
    // Two states only, normal and fit-all; the page holds still underneath and only a station pick,
    // the toggle, O, Esc and a pinch work in it. Nothing is remembered
    const OV_MS = 500;
    const OV_EASE = 'cubic-bezier(0.65, 0, 0.35, 1)';
    // a pinch (ctrl + wheel) has to travel this far before it counts; a light touch stays below it
    const PINCH = 60;
    let ov: { from: Station; y: number } | null = null;
    let ovTimer = 0;
    const fit = () => {
      const pad = 24;
      const nav = navH();
      const vw = world.clientWidth;
      const vh = window.innerHeight - nav;
      const w = camera.offsetWidth;
      const h = Math.max(...[...stations.values()].map((el) => el.offsetHeight));
      const s = Math.min((vw - 2 * pad) / w, (vh - 2 * pad) / h);
      // the page sits at the top while in overview, so the camera's own top is its layout position
      return { s, x: (vw - w * s) / 2, y: nav + (vh - h * s) / 2 - docY(camera) };
    };
    const fitted = (f: ReturnType<typeof fit>) => `translate(${f.x}px, ${f.y}px) scale(${f.s})`;
    // camera offset that frames a station, from layout
    const camAt = (st: Station) => {
      const el = stations.get(st)!;
      return -(el.offsetLeft + el.offsetWidth - world.clientWidth);
    };
    // the camera's transform, glided over ms (none with reduced motion), then done
    const place = (t: string, ms: number, done?: () => void) => {
      clearTimeout(ovTimer);
      ovEnd = null;
      const instant = !ms || reduced.matches;
      camera.style.transition = instant ? 'none' : `transform ${ms}ms ${OV_EASE}`;
      camera.style.transform = t;
      if (instant) {
        void camera.offsetWidth;
        done?.();
        return;
      }
      ovEnd = () => {
        ovEnd = null;
        clearTimeout(ovTimer);
        done?.();
      };
      ovTimer = window.setTimeout(() => ovEnd?.(), ms + 120);
    };
    // the pick targets sit over the scaled stations, in viewport space
    const lay = (f: ReturnType<typeof fit>) => {
      const top = docY(camera) + f.y;
      for (const b of picks) {
        const el = stations.get(b.dataset.pick as Station)!;
        Object.assign(b.style, {
          left: `${f.x + el.offsetLeft * f.s}px`,
          top: `${top + el.offsetTop * f.s}px`,
          width: `${el.offsetWidth * f.s}px`,
          height: `${el.offsetHeight * f.s}px`,
        });
      }
    };
    const lock = (on: boolean) => window.dispatchEvent(new CustomEvent('rk:scroll-lock', { detail: on }));

    const enter = (focusPick: boolean) => {
      if (ov || !on() || blocked()) return;
      const x = new DOMMatrixReadOnly(getComputedStyle(camera).transform).m41;
      const y = window.scrollY;
      ov = { from: current(), y };
      root.dataset.overview = 'on';
      // the page goes to the top and the camera takes up the difference, so nothing moves yet
      place(`translate(${x}px, ${-y}px) scale(1)`, 0);
      window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      scrollTo(0, true);
      lock(true);
      sync();
      toggle.setAttribute('aria-pressed', 'true');
      const f = fit();
      lay(f);
      layer.hidden = false;
      live.textContent = 'Overview: all stations';
      world.classList.add('moving');
      place(fitted(f), OV_MS, settled);
      if (focusPick) picks.find((b) => b.dataset.pick === ov!.from)?.focus({ preventScroll: true });
    };
    // back to normal scale on a station: its anchor, or where the page was if it is the one we left
    const leave = (to: Station, y: number | null, focus = true) => {
      if (!ov) return;
      const from = ov.from;
      const max = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      const target = Math.round(Math.max(0, Math.min(max, y ?? (to === from ? ov.y : anchorY(HOME_OF[to])))));
      ov = null;
      layer.hidden = true;
      toggle.setAttribute('aria-pressed', 'false');
      world.classList.add('moving');
      if (to !== current()) {
        root.dataset.station = to;
        save(to);
        document.querySelector('.nav')?.dispatchEvent(new Event('rk:sync'));
      }
      live.textContent = NAMES[to];
      place(`translate(${camAt(to)}px, ${-target}px) scale(1)`, OV_MS, () => {
        // hand the frame back to the page: same picture, now from the scroll position
        delete root.dataset.overview;
        place('', 0);
        camera.style.transition = '';
        lock(false);
        window.scrollTo({ top: target, left: 0, behavior: 'instant' });
        scrollTo(target, true);
        sync();
        if (focus && !toggle.contains(document.activeElement)) {
          const h = document.querySelector<HTMLElement>(HEADINGS[to]);
          if (h) {
            if (!h.hasAttribute('tabindex')) h.setAttribute('tabindex', '-1');
            h.focus({ preventScroll: true });
          }
        }
        settled();
        document.dispatchEvent(new Event('rk:remember'));
      });
    };
    // out at once, no glide: a back jump or a switch to the stacked layout
    function drop() {
      if (!overview()) return;
      ov = null;
      layer.hidden = true;
      toggle.setAttribute('aria-pressed', 'false');
      delete root.dataset.overview;
      place('', 0);
      camera.style.transition = '';
      lock(false);
      sync();
    }

    toggle.addEventListener('click', () => (ov ? leave(ov.from, null) : enter(false)));
    for (const b of picks) b.addEventListener('click', () => leave(b.dataset.pick as Station, null));
    window.addEventListener(
      'resize',
      () => {
        if (!ov || !on()) return;
        const f = fit();
        place(fitted(f), 0);
        lay(f);
      },
      { signal },
    );
    document.addEventListener(
      'keydown',
      (e) => {
        if (!on() || e.defaultPrevented || e.altKey || e.metaKey || e.ctrlKey) return;
        if (e.key === 'Escape' && ov) {
          e.preventDefault();
          leave(ov.from, null);
        } else if ((e.key === 'o' || e.key === 'O') && !e.repeat) {
          if ((e.target as Element | null)?.closest?.('input, textarea, select, [contenteditable]')) return;
          if (ov) leave(ov.from, null);
          else if (!blocked()) enter(true);
        }
      },
      { signal },
    );
    // pinch: Chrome, Edge and Firefox send it as ctrl + wheel, positive deltaY to pinch in. The page's
    // own zoom never runs on the desk; one toggle per gesture, and nothing past the fit-all scale
    let pinch = 0;
    let pinched = false;
    let pinchIdle = 0;
    window.addEventListener(
      'wheel',
      (e) => {
        if (!e.ctrlKey || !on()) return;
        e.preventDefault();
        clearTimeout(pinchIdle);
        pinchIdle = window.setTimeout(() => {
          pinch = 0;
          pinched = false;
        }, 250);
        if (pinched || busy()) return;
        pinch += e.deltaMode === 1 ? e.deltaY * 16 : e.deltaY;
        if (pinch > PINCH && !ov && !overview()) {
          pinched = true;
          enter(false);
        } else if (pinch < -PINCH && ov) {
          pinched = true;
          leave(ov.from, null);
        }
      },
      { passive: false, signal },
    );
    // Safari sends the pinch as gesture events with a scale
    let gestured = false;
    const gesture = (e: Event) => {
      if (!on()) return;
      e.preventDefault();
      if (e.type === 'gesturestart') return void (gestured = false);
      const scale = (e as Event & { scale?: number }).scale ?? 1;
      if (gestured || busy()) return;
      if (scale < 0.8 && !ov && !overview()) {
        gestured = true;
        enter(false);
      } else if (scale > 1.25 && ov) {
        gestured = true;
        leave(ov.from, null);
      }
    };
    for (const t of ['gesturestart', 'gesturechange']) window.addEventListener(t, gesture, { passive: false, signal });

    // the layout mode follows the viewport; the stack has no camera at all
    const mode = () => {
      const was = on();
      if (!wide.matches) drop();
      root.classList.toggle('world', wide.matches);
      if (was !== on()) {
        sync();
        settled();
      }
    };
    wide.addEventListener('change', mode, { signal });

    sync();
    // first frame placed without a glide; later moves animate
    requestAnimationFrame(() => requestAnimationFrame(() => world.classList.add('ready')));
    setTimeout(() => world.classList.add('ready'), 100);
    settled();
    // a hash on arrival picks its spot once layout has settled; the bench slides into place a moment
    // after first paint, so the anchor is placed again until the visitor takes over
    const arrival = decodeURIComponent(location.hash.slice(1));
    const arrivalStation = stationOf(location.hash);
    if (on() && !traverse && arrivalStation) {
      const place = () => (arrival in TARGETS ? goHash(arrival, false, true) : go(arrivalStation, { focus: false, immediate: true }));
      let taken = false;
      for (const t of ['wheel', 'touchstart', 'keydown', 'pointerdown'] as const) window.addEventListener(t, () => (taken = true), { once: true, passive: true, signal });
      requestAnimationFrame(place);
      const again = () => !taken && !signal.aborted && place();
      window.addEventListener('rk:layout', again, { signal });
      for (const ms of [250, 700, 1500]) setTimeout(again, ms);
      // layout settles by the end of the intro; after that the anchor belongs to the visitor
      setTimeout(() => window.removeEventListener('rk:layout', again), 5000);
    }
    traverse = false;
  };
  document.addEventListener('astro:after-swap', init);
  document.addEventListener('astro:page-load', init);
</script>

<style is:global>
  .world {
