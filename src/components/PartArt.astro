---
// Top-view drawings of the parts on the breadboard. Light from the top-left, so each part
// carries a flat offset shadow down-right; matte fills, no filters.
export type Kind = 'iio' | 'rj45' | 'esp32' | 'gesture' | 'antenna' | 'matrix' | 'swd' | 'sbc' | 'camera';
interface Props {
  kind: Kind;
}
const { kind } = Astro.props;
const VB: Record<Kind, string> = {
  iio: '0 0 400 150',
  rj45: '0 0 160 150',
  esp32: '0 0 180 150',
  gesture: '0 0 180 150',
  antenna: '0 0 360 150',
  matrix: '0 0 160 150',
  swd: '0 0 120 90',
  sbc: '0 0 120 90',
  camera: '0 0 120 90',
};
const MONO = "'JetBrains Mono Variable', ui-monospace, monospace";
const range = (n: number) => Array.from({ length: n }, (_, i) => i);
// 8x8 matrix: a hollow square, the edge of a filtered image
const lit = (r: number, c: number) => (r === 2 || r === 5) && c >= 2 && c <= 5 || (c === 2 || c === 5) && r >= 2 && r <= 5;
---

<svg viewBox={VB[kind]} aria-hidden="true" focusable="false" font-family={MONO}>
  {
    kind === 'iio' && (
      <g>
        <g fill="#000" opacity=".2">
          <rect x="13" y="18" width="110" height="48" rx="3" />
          <rect x="19" y="84" width="46" height="36" rx="2" />
          <rect x="75" y="80" width="62" height="60" rx="2" />
          <rect x="153" y="22" width="104" height="118" rx="4" />
          <rect x="289" y="28" width="108" height="100" rx="5" />
        </g>
        <rect x="8" y="12" width="110" height="48" rx="3" fill="#2f5d8a" />
        {[34, 92].map((cx) => (
          <g>
            <circle cx={cx} cy="36" r="20" fill="#c9cbcd" />
            <circle cx={cx} cy="36" r="14" fill="#55595e" />
            <path d={`M${cx - 13} 30a14 14 0 0 1 10-8`} stroke="#fff" stroke-width="2" fill="none" opacity=".3" />
          </g>
        ))}
        <text x="63" y="57" font-size="6.5" fill="#e8eef4" text-anchor="middle">HC-SR04</text>
        <rect x="14" y="78" width="46" height="36" rx="2" fill="#4b3c7a" />
        <rect x="30" y="86" width="13" height="13" rx="1" fill="#141416" />
        {range(4).map((i) => <circle cx={21 + i * 10.5} cy="107" r="2.6" fill="#c9a24a" />)}
        <text x="37" y="84" font-size="5.5" fill="#ece8f6" text-anchor="middle">MSA311</text>
        <rect x="70" y="74" width="62" height="60" rx="2" fill="#1d2433" />
        <rect x="75" y="82" width="52" height="40" rx="1" fill="#2a3644" />
        <path d="M76 120L96 83H104L84 120Z" fill="#fff" opacity=".05" />
        <text x="101" y="130" font-size="5.5" fill="#cfd6e4" text-anchor="middle">TFT</text>
        <rect x="148" y="16" width="104" height="118" rx="4" fill="#eceee9" />
        <rect x="154" y="24" width="8" height="102" rx="1" fill="#1b1c1f" />
        <rect x="238" y="24" width="8" height="102" rx="1" fill="#1b1c1f" />
        <g fill="#8d9096">
          {range(9).map((i) => <rect x={183 + i * 4} y="52" width="2" height="5" />)}
          {range(9).map((i) => <rect x={183 + i * 4} y="93" width="2" height="5" />)}
          {range(9).map((i) => <rect x="176" y={59 + i * 4} width="5" height="2" />)}
          {range(9).map((i) => <rect x="219" y={59 + i * 4} width="5" height="2" />)}
        </g>
        <rect x="181" y="57" width="38" height="36" rx="1.5" fill="#1c1d20" />
        <circle cx="186" cy="88" r="1.8" fill="#0b0b0c" />
        <text x="200" y="114" font-size="8" font-weight="600" fill="#2a58a6" text-anchor="middle">STM32</text>
        <rect x="252" y="62" width="34" height="18" fill="#b9b8b1" />
        <path d="M252 63.5H286" stroke="#b5473d" stroke-width="2.5" />
        <path d="M252 68H286M252 72H286M252 76H286" stroke="#8f8e88" stroke-width=".8" />
        <rect x="284" y="22" width="108" height="100" rx="5" fill="#2a6a45" />
        <rect x="296" y="28" width="66" height="10" rx="1" fill="#141517" />
        {range(16).map((i) => <circle cx={299.5 + i * 4} cy="33" r="1.1" fill="#c9a24a" />)}
        <rect x="314" y="54" width="28" height="28" rx="2" fill="#b7b9bb" />
        <rect x="370" y="44" width="26" height="22" rx="1" fill="#c7c9cb" />
        <rect x="370" y="72" width="26" height="22" rx="1" fill="#c7c9cb" />
        <rect x="368" y="98" width="28" height="18" rx="1" fill="#c7c9cb" />
        <text x="292" y="114" font-size="7" fill="#eef3ee">Raspberry Pi 4</text>
      </g>
    )
  }
  {
    kind === 'rj45' && (
      <g>
        <rect x="20" y="36" width="132" height="106" rx="3" fill="#000" opacity=".2" />
        <rect x="14" y="30" width="132" height="106" rx="3" fill="#1d4d3a" />
        <rect x="40" y="22" width="92" height="88" rx="2" fill="#000" opacity=".22" />
        <rect x="34" y="16" width="92" height="88" rx="2" fill="#c4c6c8" />
        <path d="M36 102V18H124" stroke="#fff" stroke-width="1.5" fill="none" opacity=".35" />
        <rect x="50" y="38" width="60" height="50" rx="2" fill="#1b1c1e" />
        <rect x="70" y="84" width="20" height="8" fill="#1b1c1e" />
        <g stroke="#c9a24a" stroke-width="2">{range(8).map((i) => <path d={`M${57 + i * 6.5} 40v10`} />)}</g>
        <rect x="38" y="20" width="10" height="6" rx="1" fill="#3f6b48" />
        <rect x="112" y="20" width="10" height="6" rx="1" fill="#7a6232" />
        <text x="80" y="128" font-size="8" fill="#e6efe9" text-anchor="middle">RJ45</text>
      </g>
    )
  }
  {
    kind === 'esp32' && (
      <g>
        <rect x="16" y="40" width="160" height="84" rx="4" fill="#000" opacity=".2" />
        <rect x="10" y="34" width="160" height="84" rx="4" fill="#1b1c1f" />
        {range(15).map((i) => (
          <g fill="#c9a24a">
            <circle cx={22 + i * 10} cy="40" r="2" />
            <circle cx={22 + i * 10} cy="112" r="2" />
          </g>
        ))}
        <rect x="4" y="66" width="18" height="20" rx="1.5" fill="#c3c5c7" />
        <rect x="28" y="52" width="9" height="7" rx="1" fill="#0d0d0f" />
        <rect x="28" y="93" width="9" height="7" rx="1" fill="#0d0d0f" />
        <rect x="60" y="46" width="106" height="62" rx="1.5" fill="#23324a" />
        <rect x="64" y="50" width="72" height="54" rx="1" fill="#c3c5c7" />
        <path d="M66 102V52H134" stroke="#fff" stroke-width="1.2" fill="none" opacity=".4" />
        <path d="M142 54H160V62H146V70H160V78H146V86H160V94H146V100" stroke="#c9a24a" stroke-width="2" fill="none" />
        <text x="100" y="81" font-size="10" font-weight="600" fill="#5d6166" text-anchor="middle">ESP32</text>
      </g>
    )
  }
  {
    kind === 'gesture' && (
      <g>
        <rect x="17" y="34" width="70" height="62" rx="2" fill="#000" opacity=".2" />
        <rect x="12" y="28" width="70" height="62" rx="2" fill="#4b3c7a" />
        <rect x="35" y="40" width="24" height="24" rx="1.5" fill="#141416" />
        <circle cx="39" cy="60" r="1.6" fill="#2c2c30" />
        {range(5).map((i) => <circle cx={22 + i * 12.5} cy="80" r="2.8" fill="#c9a24a" />)}
        <text x="47" y="74" font-size="6.5" fill="#ece8f6" text-anchor="middle">MEMS ACC</text>
        <rect x="101" y="26" width="74" height="110" rx="3" fill="#000" opacity=".2" />
        <rect x="96" y="20" width="74" height="110" rx="3" fill="#2f5d8a" />
        <circle cx="116" cy="40" r="10" fill="#dfe6ea" />
        <circle cx="113" cy="37" r="3" fill="#fff" opacity=".7" />
        <circle cx="150" cy="40" r="10" fill="#18191c" />
        <rect x="119" y="64" width="28" height="28" rx="2" fill="#3f6fa8" />
        <circle cx="133" cy="78" r="9" fill="#ecebe6" />
        <path d="M128 78h10M133 73v10" stroke="#777" stroke-width="2" />
        {range(3).map((i) => <circle cx={118 + i * 15} cy="118" r="2.8" fill="#c9a24a" />)}
        <text x="133" y="106" font-size="7" fill="#e8eef4" text-anchor="middle">IR</text>
      </g>
    )
  }
  {
    kind === 'antenna' && (
      <g>
        <rect x="16" y="22" width="340" height="118" rx="3" fill="#000" opacity=".2" />
        <rect x="10" y="16" width="340" height="118" rx="3" fill="#24443a" />
        {[30, 110, 190, 270].map((x) => (
          <g>
            <rect x={x + 3} y="31" width="58" height="52" rx="1" fill="#000" opacity=".18" />
            <rect x={x} y="28" width="58" height="52" rx="1" fill="#b98650" />
            <path d={`M${x + 2} 78V30H${x + 56}`} stroke="#fff" stroke-width="1" fill="none" opacity=".25" />
            <path d={`M${x + 29} 80V96`} stroke="#b98650" stroke-width="4" />
          </g>
        ))}
        <path d="M59 96H139M219 96H299M99 96V108H259M179 108V120" stroke="#b98650" stroke-width="4" fill="none" />
        <path d="M169 114h20l5 7-5 7h-20l-5-7z" fill="#d1ad5c" />
        <circle cx="179" cy="121" r="3.5" fill="#6e5a2a" />
      </g>
    )
  }
  {
    kind === 'matrix' && (
      <g>
        <rect x="32" y="22" width="108" height="108" rx="3" fill="#000" opacity=".22" />
        <rect x="26" y="16" width="108" height="108" rx="3" fill="#17181b" />
        <path d="M28 122V18H132" stroke="#fff" stroke-width="1" fill="none" opacity=".12" />
        {range(64).map((i) => {
          const r = Math.floor(i / 8);
          const c = i % 8;
          return <circle cx={36.25 + c * 12.5} cy={26.25 + r * 12.5} r="4.4" fill={lit(r, c) ? '#d9a04a' : '#38393d'} />;
        })}
        <text x="80" y="140" font-size="7" fill="#5a554a" text-anchor="middle">8x8</text>
      </g>
    )
  }
  {
    kind === 'swd' && (
      <g>
        <rect x="25" y="23" width="80" height="48" rx="2" fill="#000" opacity=".22" />
        <rect x="20" y="18" width="80" height="48" rx="2" fill="#1b1c1f" />
        <rect x="26" y="24" width="68" height="36" rx="1" fill="#0d0d0f" />
        <rect x="50" y="60" width="20" height="6" fill="#0d0d0f" />
        {range(10).map((i) => <rect x={32 + (i % 5) * 13} y={i < 5 ? 31 : 46} width="5" height="5" fill="#c9a24a" />)}
        <text x="60" y="82" font-size="8" fill="#5a554a" text-anchor="middle">SWD</text>
      </g>
    )
  }
  {
    kind === 'sbc' && (
      <g>
        <rect x="16" y="20" width="100" height="66" rx="4" fill="#000" opacity=".2" />
        <rect x="10" y="14" width="100" height="66" rx="4" fill="#2a6a45" />
        <rect x="18" y="18" width="60" height="8" rx="1" fill="#141517" />
        {range(14).map((i) => <circle cx={21 + i * 4.1} cy="22" r="1" fill="#c9a24a" />)}
        <rect x="34" y="38" width="22" height="22" rx="2" fill="#b7b9bb" />
        <rect x="88" y="30" width="22" height="16" rx="1" fill="#c7c9cb" />
        <rect x="88" y="52" width="22" height="16" rx="1" fill="#c7c9cb" />
      </g>
    )
  }
  {
    kind === 'camera' && (
      <g>
        <rect x="52" y="70" width="16" height="20" fill="#c8954b" />
        <rect x="35" y="17" width="62" height="62" rx="3" fill="#000" opacity=".2" />
        <rect x="30" y="12" width="62" height="62" rx="3" fill="#1f4d3a" />
        <circle cx="61" cy="43" r="19" fill="#141517" />
        <circle cx="61" cy="43" r="10" fill="#2d3a4a" />
        <circle cx="57" cy="39" r="3" fill="#fff" opacity=".35" />
        {[[35, 17], [87, 17], [35, 69], [87, 69]].map(([x, y]) => <circle cx={x} cy={y} r="2.4" fill="#c9a24a" />)}
      </g>
    )
  }
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
