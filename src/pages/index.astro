---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import DeskHero from '../components/DeskHero.astro';
import SideDrawer from '../components/SideDrawer.astro';
import MemoryBank from '../components/MemoryBank.astro';
import WireLayer from '../components/WireLayer.astro';
import Breadboard from '../components/Breadboard.astro';
import { getProjects } from '../lib/projects';
import { hexAt } from '../lib/hex';
import site from '../content/site.json';

// resume order comes from the file names ("01-...")
const work = (await getCollection('work')).sort((a, b) => (a.filePath ?? '').localeCompare(b.filePath ?? ''));
const projects = await getProjects();
---

<Base>
  <Nav />
  <main id="main">
    <DeskHero>
      <section id="trace" class="region" aria-labelledby="trace-title">
        <div class="container">
          <p class="mono eyebrow"><span class="pin" style="--wire:var(--pa1)">PA1</span> 0x1000 / work experience</p>
          <h2 id="trace-title">Execution trace</h2>
          <MemoryBank work={work} />
        </div>
      </section>

      <section id="builds" class="region" aria-labelledby="builds-title">
        <div class="container">
          <p class="mono eyebrow"><span class="pin" style="--wire:var(--pa2)">PA2</span> 0x2000 / projects</p>
          <h2 id="builds-title">Firmware builds</h2>
          <Breadboard projects={projects} />
        </div>
      </section>
      <WireLayer />
    </DeskHero>

    <a class="to-ide" href="/ide/" aria-label="Go to the IDE world" title="IDE world">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>

  </main>
  <SideDrawer route="work" label="TRACE / work" mode="inspector">
    {
      work.map((w) => (
        <article data-slug={w.id} hidden>
          <p class="mono head-line">
            {w.data.kind === 'flash' ? 'FLASH' : 'ROM'} @ {w.data.address} &middot; {w.data.bullets.length}{' '}
            {w.data.bullets.length === 1 ? 'record' : 'records'}
          </p>
          <h2>{w.data.role}</h2>
          <p class="role">
            {w.data.org} &middot; {w.data.location} &middot; {w.data.start} – {w.data.end}
          </p>
          <ol class="records">
            {w.data.bullets.map((b, i) => (
              <li>
                <span class="mono gutter">{hexAt(w.data.address, i)}</span>
                <p>{b}</p>
              </li>
            ))}
          </ol>
        </article>
      ))
    }
  </SideDrawer>
  <footer class="foot">
    <div class="container silk">
      <span>Rohith Kalisetti</span>
      <a href={`mailto:${site.email}`}>Email</a>
      <a href={site.github} rel="noopener">GitHub</a>
      <a href={site.linkedin} rel="noopener">LinkedIn</a>
    </div>
  </footer>
</Base>

<style>
  /* desk regions below the board; C1 and C2 draw into these */
  .region {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: var(--s-12);
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    margin-bottom: var(--s-2);
    color: var(--muted);
  }
  .pin {
    padding: 0 6px;
    border: 1px solid var(--wire);
    border-radius: var(--r-1);
    color: var(--text);
    font-size: var(--fs-label);
  }
  .to-ide {
    position: fixed;
    left: 0;
    top: 50%;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 36px;
    height: 72px;
    margin-top: -36px;
    border: 1px solid var(--line);
    border-left: 0;
    border-radius: 0 var(--r-2) var(--r-2) 0;
    background: color-mix(in srgb, var(--board) 90%, transparent);
    color: var(--text-2);
    transition:
      transform var(--t-fast) var(--ease),
      opacity var(--t-fast) var(--ease);
  }
  .to-ide:hover {
    color: var(--text);
    transform: translateX(3px);
  }
  :global(.drawer) .head-line {
    color: var(--muted);
  }
  :global(.drawer) h2 {
    margin-top: var(--s-1);
  }
  :global(.drawer) .role {
    margin-block: var(--s-1) var(--s-3);
    color: var(--text);
  }
  :global(.drawer) .records {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  :global(.drawer) .records li {
    display: grid;
    grid-template-columns: 11ch 1fr;
    gap: var(--s-2);
    padding-block: var(--s-2);
    border-bottom: 1px solid var(--line);
  }
  :global(.drawer) .gutter {
    padding-top: 3px;
    color: var(--muted);
    font-size: var(--fs-label);
  }
  :global(.drawer) .records p {
    font-family: var(--font-mono);
    font-size: var(--fs-label-lg);
    line-height: 1.65;
  }
  @media (max-width: 480px) {
    :global(.drawer) .records li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
  .foot {
    position: relative;
    z-index: 1;
    padding-block: var(--s-4);
    border-top: 1px solid var(--line);
    background: var(--bg);
  }
  .silk {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-3);
    color: var(--text-2);
    font: 500 var(--fs-label) var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .silk span {
    margin-right: auto;
    color: var(--text);
  }
  .silk a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-2);
    text-decoration: none;
  }
  .silk a:hover {
    color: var(--accent);
  }
</style>
