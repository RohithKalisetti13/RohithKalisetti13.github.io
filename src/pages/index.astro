---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Section from '../components/Section.astro';
import GpioButton from '../components/GpioButton.astro';
import Panel from '../components/Panel.astro';
import DeskHero from '../components/DeskHero.astro';
import SideDrawer from '../components/SideDrawer.astro';
import site from '../content/site.json';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
// work ids carry an order prefix ("01-..."); the URL slug drops it
const slugOf = (id: string) => id.replace(/^\d+-/, '');
---

<Base>
  <Nav />
  <main id="main">
    <DeskHero>
      <section id="trace" class="region" aria-labelledby="trace-title">
        <div class="container">
          <p class="mono eyebrow"><span class="pin" style="--wire:var(--pa1)">PA1</span> 0x1000 / work experience</p>
          <h2 id="trace-title">Execution trace</h2>
          <p class="placeholder mono">[Work Exp: memory bank goes here]</p>
          {
            work[0] && (
              <button type="button" class="test-btn mono" data-drawer-open={`work/${slugOf(work[0].id)}`}>
                Open drawer (test): {work[0].data.org}
              </button>
            )
          }
        </div>
      </section>

      <section id="builds" class="region" aria-labelledby="builds-title">
        <div class="container">
          <p class="mono eyebrow"><span class="pin" style="--wire:var(--pa2)">PA2</span> 0x2000 / projects</p>
          <h2 id="builds-title">Firmware builds</h2>
          <p class="placeholder mono">[Projects: breadboard goes here]</p>
          <ul class="case-links">
            {
              projects.map((p) => (
                <li>
                  <a href={`/projects/${p.id}/`}>{p.data.title} →</a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </DeskHero>

    <a class="to-ide" href="/ide/" aria-label="Go to the IDE world" title="IDE world">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>

    <Section id="irq" addr="0x4000" title="Interrupt line" plain="contact" pin="PA4">
      <div class="irq">
        <Panel as="section" class="about">
          <h3>Device descriptor</h3>
          <p class="mono sub">about</p>
          <div class="photo" role="img" aria-label="Photo placeholder">[photo]</div>
          <p>{site.about}</p>
          <ul class="facts">
            <li>{site.location}</li>
            <li>{site.education}</li>
            <li>{site.looking}</li>
          </ul>
        </Panel>
        <Panel as="section">
          <h3>Flash image</h3>
          <p class="mono sub">resume</p>
          <p class="mono file">{site.resumeName}</p>
          <div class="actions">
            <GpioButton href={site.resume} download pin="PB3">Download</GpioButton>
            <GpioButton href={site.resume} external pin="PB4" variant="secondary">View</GpioButton>
          </div>
        </Panel>
        <Panel as="section">
          <h3>Pinout</h3>
          <p class="mono sub">contact</p>
          <ul class="pinout">
            <li><span class="mono">MAIL</span> <a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><span class="mono">LNKD</span> <a href={site.linkedin}>LinkedIn</a></li>
            <li><span class="mono">GITH</span> <a href={site.github}>GitHub</a></li>
          </ul>
        </Panel>
      </div>
    </Section>
  </main>
  <SideDrawer route="work" label="TRACE / work">
    {
      work.map((w) => (
        <article data-slug={slugOf(w.id)} hidden>
          <p class="mono dates">{w.data.dates}</p>
          <h2>{w.data.org}</h2>
          <p class="role">{w.data.role}</p>
          <p>{w.data.summary}</p>
        </article>
      ))
    }
  </SideDrawer>
  <footer class="foot">
    <div class="container mono">__stack_top</div>
  </footer>
</Base>

<style>
  /* desk regions below the board; C1 and C2 draw into these */
  .region {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: var(--s-12);
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    margin-bottom: var(--s-2);
    color: var(--muted);
  }
  .pin {
    padding: 0 6px;
    border: 1px solid var(--wire);
    border-radius: var(--r-1);
    color: var(--text);
    font-size: var(--fs-label);
  }
  .placeholder {
    display: grid;
    place-items: center;
    min-height: 40svh;
    margin-top: var(--s-4);
    border: 1px dashed var(--line);
    border-radius: var(--r-3);
    color: var(--muted);
    text-align: center;
  }
  .test-btn {
    margin-top: var(--s-3);
    min-height: 44px;
    padding: 0 var(--s-2);
    border: 1px solid var(--accent);
    border-radius: var(--r-2);
    background: transparent;
    color: var(--accent);
    cursor: pointer;
  }
  .test-btn:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    margin-top: var(--s-3);
  }
  .case-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .to-ide {
    position: fixed;
    left: 0;
    top: 50%;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 36px;
    height: 72px;
    margin-top: -36px;
    border: 1px solid var(--line);
    border-left: 0;
    border-radius: 0 var(--r-2) var(--r-2) 0;
    background: color-mix(in srgb, var(--board) 90%, transparent);
    color: var(--text-2);
    transition:
      transform var(--t-fast) var(--ease),
      opacity var(--t-fast) var(--ease);
  }
  .to-ide:hover {
    color: var(--text);
    transform: translateX(3px);
  }
  :global(.drawer) .dates {
    color: var(--muted);
  }
  :global(.drawer) h2 {
    margin-top: var(--s-1);
  }
  :global(.drawer) .role {
    margin-block: var(--s-1) var(--s-2);
    color: var(--text);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .dates,
  .sub {
    color: var(--muted);
  }
  .role {
    color: var(--text);
    margin-bottom: var(--s-1);
  }
  .irq {
    display: grid;
    gap: var(--s-3);
  }
  .photo {
    display: grid;
    place-items: center;
    width: 160px;
    height: 200px;
    margin-block: var(--s-2);
    border: 1px dashed var(--line);
    border-radius: var(--r-2);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
  }
  .facts,
  .pinout {
    display: grid;
    gap: var(--s-1);
    margin-top: var(--s-2);
    color: var(--text-2);
  }
  .pinout li {
    display: flex;
    gap: var(--s-2);
    align-items: baseline;
    flex-wrap: wrap;
  }
  .pinout .mono {
    color: var(--muted);
    min-width: 4ch;
  }
  .file {
    margin-block: var(--s-2) var(--s-3);
    color: var(--text);
  }
  .foot {
    padding-block: var(--s-6);
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  @media (min-width: 820px) {
    .irq {
      grid-template-columns: 1.2fr 1fr 1fr;
    }
  }
</style>
