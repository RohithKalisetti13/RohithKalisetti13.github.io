---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import DeskHero from '../components/DeskHero.astro';
import SideDrawer from '../components/SideDrawer.astro';
import MemoryBank from '../components/MemoryBank.astro';
import WireLayer from '../components/WireLayer.astro';
import World from '../components/World.astro';
import Breadboard from '../components/Breadboard.astro';
import { getProjects } from '../lib/projects';
import { hexAt } from '../lib/hex';
import site from '../content/site.json';

// resume order comes from the file names ("01-...")
const work = (await getCollection('work')).sort((a, b) => (a.filePath ?? '').localeCompare(b.filePath ?? ''));
const projects = await getProjects();
---

<Base>
  <Nav />
  <main id="main">
    <World>
      <DeskHero slot="center" />

      <Fragment slot="right">
        <section id="work" class="region" aria-labelledby="work-title">
          <div class="container">
            <p class="mono eyebrow"><span class="pin" style="--wire:var(--pa1)">PA1</span> 0x1000 / work experience</p>
            <h2 id="work-title">Execution trace</h2>
            <MemoryBank work={work} />
          </div>
        </section>

        <section id="projects" class="region" aria-labelledby="projects-title">
          <div class="container">
            <div class="proj-head">
              <p class="mono eyebrow"><span class="pin" style="--wire:var(--pa2)">PA2</span> 0x2000 / projects</p>
              <h2 id="projects-title">Firmware builds</h2>
            </div>
            <Breadboard projects={projects} />
          </div>
        </section>
      </Fragment>

      <section id="about" class="region laptop-station" aria-labelledby="about-title" slot="left">
        <div class="container">
          <p class="mono eyebrow"><span class="pin" style="--wire:var(--pa4)">PA4</span> 0x4000 / about and contact</p>
          <h2 id="about-title">Laptop</h2>
          <div class="lap-stub">
            <p>[about and contact: IDE coming in the next step]</p>
            <span class="usb-port" aria-hidden="true"></span>
          </div>
        </div>
      </section>

      <WireLayer />
    </World>
  </main>
  <SideDrawer route="work" label="TRACE / work" mode="inspector">
    {
      work.map((w) => (
        <article data-slug={w.id} hidden>
          <p class="mono head-line">
            {w.data.kind === 'flash' ? 'FLASH' : 'ROM'} @ {w.data.address} &middot; {w.data.bullets.length}{' '}
            {w.data.bullets.length === 1 ? 'record' : 'records'}
          </p>
          <h2>{w.data.role}</h2>
          <p class="role">
            {w.data.org} &middot; {w.data.location} &middot; {w.data.start} – {w.data.end}
          </p>
          <ol class="records">
            {w.data.bullets.map((b, i) => (
              <li>
                <span class="mono gutter">{hexAt(w.data.address, i)}</span>
                <p>{b}</p>
              </li>
            ))}
          </ol>
        </article>
      ))
    }
  </SideDrawer>
  <footer class="foot">
    <div class="container silk">
      <span>Rohith Kalisetti</span>
      <a href={`mailto:${site.email}`}>Email</a>
      <a href={site.github} rel="noopener">GitHub</a>
      <a href={site.linkedin} rel="noopener">LinkedIn</a>
    </div>
  </footer>
</Base>

<style>
  /* desk regions below the board; C1 and C2 draw into these */
  .region {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: var(--s-12);
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    margin-bottom: var(--s-2);
    color: var(--muted);
  }
  .pin {
    padding: 0 6px;
    border: 1px solid var(--wire);
    border-radius: var(--r-1);
    color: var(--text);
    font-size: var(--fs-label);
  }
  /* desk world: the bench sits level with the headers it is wired to (offsets set by WireLayer) */
  :global(html.world) .region {
    display: block;
    min-height: 0;
    padding-block: 0;
  }
  :global(html.world) #work {
    padding-top: var(--work-y, 120px);
  }
  :global(html.world) #projects {
    padding-top: var(--projects-y, 48px);
    padding-bottom: var(--s-8);
  }
  :global(html.world .station[data-station='right']) .container {
    width: auto;
    margin: 0;
    padding-left: 120px;
    padding-right: 120px;
  }
  /* the builds heading sits beside the half-width memory board, so the breadboard can tuck in below it */
  :global(html.world) .proj-head {
    position: absolute;
    left: calc(120px + max(760 * var(--u), 560px) + var(--s-4));
    right: 120px;
    bottom: calc(100% + var(--s-3));
  }
  .lap-stub {
    position: relative;
    margin-top: var(--s-3);
    padding: var(--s-6);
    border: 1px dashed var(--line);
    border-radius: var(--r-3);
  }
  .usb-port {
    position: absolute;
    right: -6px;
    top: 50%;
    width: 12px;
    height: 24px;
    margin-top: -12px;
    border-radius: 2px;
    background: #2c2d32;
  }
  :global(html.world) .laptop-station {
    padding-top: calc(var(--copy-h) - 220 * var(--u));
  }
  :global(.drawer) .head-line {
    color: var(--muted);
  }
  :global(.drawer) h2 {
    margin-top: var(--s-1);
  }
  :global(.drawer) .role {
    margin-block: var(--s-1) var(--s-3);
    color: var(--text);
  }
  :global(.drawer) .records {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  :global(.drawer) .records li {
    display: grid;
    grid-template-columns: 11ch 1fr;
    gap: var(--s-2);
    padding-block: var(--s-2);
    border-bottom: 1px solid var(--line);
  }
  :global(.drawer) .gutter {
    padding-top: 3px;
    color: var(--muted);
    font-size: var(--fs-label);
  }
  :global(.drawer) .records p {
    font-family: var(--font-mono);
    font-size: var(--fs-label-lg);
    line-height: 1.65;
  }
  @media (max-width: 480px) {
    :global(.drawer) .records li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
  .foot {
    position: relative;
    z-index: 1;
    padding-block: var(--s-4);
    border-top: 1px solid var(--line);
    background: var(--bg);
  }
  .silk {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-3);
    color: var(--text-2);
    font: 500 var(--fs-label) var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .silk span {
    margin-right: auto;
    color: var(--text);
  }
  .silk a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-2);
    text-decoration: none;
  }
  .silk a:hover {
    color: var(--accent);
  }
</style>
