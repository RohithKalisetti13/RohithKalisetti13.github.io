---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import site from '../content/site.json';
---

<Base title={`IDE · ${site.name}`} description="The IDE world, coming next.">
  <Nav />
  <main id="main" class="ide">
    <a class="back mono" href="/">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      Back to the desk
    </a>
    <div class="container center">
      <p class="mono addr">0x4000 / IRQ</p>
      <h1>IDE world coming next</h1>
      <p>[placeholder]</p>
    </div>
  </main>
</Base>

<style>
  .ide {
    position: relative;
    min-height: calc(100svh - var(--nav-h));
    display: grid;
    place-items: center;
    background: var(--ide-bg);
  }
  .center {
    display: grid;
    gap: var(--s-2);
    justify-items: center;
    text-align: center;
  }
  .addr {
    color: var(--muted);
  }
  /* the desk lies to the right of this world */
  .back {
    position: absolute;
    top: var(--s-3);
    right: var(--s-3);
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    min-height: 44px;
    padding: 0 var(--s-2);
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    color: var(--text);
    text-decoration: none;
  }
  .back:hover {
    border-color: var(--accent);
  }
</style>
