---
import { ClientRouter } from 'astro:transitions';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import site from '../content/site.json';

interface Props {
  title?: string;
  description?: string;
}
const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0a1a14" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // dark unless the visitor chose otherwise; set before first paint
      (() => {
        let t = 'dark';
        try {
          if (localStorage.getItem('rk-theme') === 'light') t = 'light';
        } catch {
          /* storage blocked: stay dark */
        }
        document.documentElement.dataset.theme = t;
      })();
      // wide screens get the desk world; pick the station before first paint (see lib/world.ts)
      (() => {
        const r = document.documentElement;
        if (!matchMedia('(min-width: 1024px)').matches) return;
        r.classList.add('world');
        const h = location.hash;
        let s = /^#(about|contact)$/.test(h) ? 'left' : /^#(work|projects)$/.test(h) || h.startsWith('#/work/') ? 'right' : /^#(home|skills)$/.test(h) ? 'center' : null;
        if (!s) {
          try {
            const nav = performance.getEntriesByType('navigation')[0];
            if (nav && nav.type !== 'navigate') s = sessionStorage.getItem('rk-station');
          } catch {
            /* storage blocked: start at the board */
          }
        }
        r.dataset.station = s === 'left' || s === 'right' ? s : 'center';
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <button type="button" class="theme-toggle" transition:name="theme-toggle" transition:animate="none" aria-label="Toggle light or dark theme" aria-pressed="false">
      <svg viewBox="0 0 56 56" width="56" height="56" aria-hidden="true">
        <rect x="2" y="2" width="52" height="52" rx="6" fill="#10241b" stroke="#2a6b50" stroke-width="1.5" />
        <circle cx="9" cy="9" r="2.4" fill="#c9b16c" />
        <circle cx="47" cy="9" r="2.4" fill="#c9b16c" />
        <circle cx="28" cy="26" r="15" class="ldr-body" />
        <circle cx="28" cy="26" r="12.5" class="ldr-face" />
        <path class="ldr-track" d="M18 19h20M38 19v4M38 23H18M18 23v4M18 27h20M38 27v4M38 31H19" fill="none" stroke-width="2.2" stroke-linejoin="round" />
        <path d="M24 41v7M32 41v7" stroke="#c9ccd0" stroke-width="2.4" stroke-linecap="round" />
        <text x="28" y="14" text-anchor="middle" font-family="'JetBrains Mono Variable', ui-monospace, monospace" font-size="6.5" font-weight="700" fill="#e8efe9" letter-spacing=".6">LDR</text>
      </svg>
    </button>
    <script>
      import Lenis from 'lenis';
      import { stationOf, readPos, writePos } from '../lib/world';

      const root = document.documentElement;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      let lenis: Lenis | null = null;
      let raf = 0;
      const loop = (t: number) => {
        lenis?.raf(t);
        raf = requestAnimationFrame(loop);
      };
      // wheel smoothing only: no snap, no hijack; keys, find-in-page and touch stay native
      const sync = () => {
        if (reduced.matches) {
          cancelAnimationFrame(raf);
          lenis?.destroy();
          lenis = null;
        } else if (!lenis) {
          lenis = new Lenis({ lerp: 0.12, smoothWheel: true, syncTouch: false });
          raf = requestAnimationFrame(loop);
        }
      };
      sync();
      reduced.addEventListener('change', sync);

      // same-page anchors glide; the URL and focus still follow. Capture phase, ahead of the
      // router's own link handler, which would otherwise take these as navigations
      window.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const a = (e.target as Element).closest?.('a[href*="#"]') as HTMLAnchorElement | null;
        if (!a || a.target || a.origin !== location.origin || a.pathname !== location.pathname) return;
        const id = decodeURIComponent(a.hash.slice(1));
        if (!id || id.startsWith('/')) return;
        // the desk world moves its camera for its own hashes
        if (!window.dispatchEvent(new CustomEvent('rk:goto', { detail: id, cancelable: true }))) {
          e.preventDefault();
          history.replaceState(history.state, '', a.hash);
          return;
        }
        const el = document.getElementById(id);
        if (!el || !lenis) return;
        e.preventDefault();
        const nav = parseFloat(getComputedStyle(root).scrollPaddingTop) || 0;
        lenis.scrollTo(el, { offset: -nav, duration: 0.9, easing: (t) => 1 - Math.pow(1 - t, 3) });
        history.replaceState(history.state, '', a.hash);
        if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '-1');
        el.focus({ preventScroll: true });
      }, true);

      // the world asks for a vertical spot; Lenis glides there unless told to jump
      window.addEventListener('rk:scroll-to', (e) => {
        const { y, immediate } = (e as CustomEvent<{ y: number; immediate: boolean }>).detail;
        if (lenis) lenis.scrollTo(y, { immediate, force: true, duration: 0.8, easing: (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2) });
        else window.scrollTo({ top: y, behavior: immediate || reduced.matches ? 'instant' : 'smooth' });
      });

      // the drawer asks for the page to hold still
      window.addEventListener('rk:scroll-lock', (e) => {
        const on = (e as CustomEvent<boolean>).detail;
        root.classList.toggle('scroll-locked', on);
        if (on) lenis?.stop();
        else lenis?.start();
      });

      // theme switch: the button is replaced on every swap, so bind each new one once
      const readTheme = () => {
        try {
          return localStorage.getItem('rk-theme') === 'light' ? 'light' : 'dark';
        } catch {
          return root.dataset.theme === 'light' ? 'light' : 'dark';
        }
      };
      const bindTheme = () => {
        const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
        if (!btn || btn.dataset.bound) return;
        btn.dataset.bound = '1';
        const sync = () => btn.setAttribute('aria-pressed', String(root.dataset.theme === 'light'));
        sync();
        btn.addEventListener('click', () => {
          const next = root.dataset.theme === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          try {
            localStorage.setItem('rk-theme', next);
          } catch {
            /* storage blocked: choice lasts until the next full load */
          }
          sync();
        });
      };

      // scroll: our own memory per history entry (station and scrollY), restored in one jump while
      // Lenis holds still. Written as the page moves, so leaving never has to catch it in time
      history.scrollRestoration = 'manual';
      let remembering = 0;
      const remember = () => {
        if (root.classList.contains('rk-swapping')) return;
        writePos(window.scrollY, root.dataset.station);
      };
      window.addEventListener(
        'scroll',
        () => {
          cancelAnimationFrame(remembering);
          remembering = requestAnimationFrame(remember);
        },
        { passive: true },
      );
      new MutationObserver(remember).observe(root, { attributes: true, attributeFilter: ['data-station'] });
      window.addEventListener('pagehide', remember);
      document.addEventListener('rk:remember', remember);

      let traverse = false;
      document.addEventListener('astro:before-preparation', (e) => {
        traverse = e.navigationType === 'traverse';
      });

      // pick the page transition: forward to a case study slides in from the right, home fades
      const side = (p: string) => (p.startsWith('/projects/') ? 1 : 0);
      let restoreY: number | null = null;
      document.addEventListener('astro:before-swap', (e) => {
        const next = e.newDocument.documentElement;
        next.dataset.theme = readTheme();
        next.classList.add('rk-swapping');
        lenis?.stop();
        const from = side(e.from.pathname);
        const to = side(e.to.pathname);
        next.dataset.slide = e.to.pathname === '/' && e.from.pathname !== '/' ? 'fade' : to < from ? 'left' : to > from ? 'right' : 'none';
        // on a traverse the location already names the destination entry
        const pos = traverse && e.from.pathname !== e.to.pathname ? readPos() : null;
        restoreY = pos ? pos.y : null;
        // the world class and station travel with the document; back home returns to the entry's own station
        next.classList.toggle('world', root.classList.contains('world'));
        const st = pos ? pos.st : stationOf(e.to.hash);
        next.dataset.station = st === 'left' || st === 'right' ? st : 'center';
      });
      document.addEventListener('astro:after-swap', () => {
        root.classList.remove('scroll-locked');
        history.scrollRestoration = 'manual';
        // the router has just scrolled (smoothly, if CSS asks); land exactly, with no animation
        if (restoreY !== null) window.scrollTo({ top: restoreY, left: 0, behavior: 'instant' });
        restoreY = null;
        if (lenis) {
          root.classList.add(...lenis.className.split(' '));
          lenis.resize();
          lenis.scrollTo(window.scrollY, { immediate: true, force: true });
          lenis.start();
        }
        bindTheme();
        setTimeout(() => root.classList.remove('rk-swapping'), 0);
      });
      document.addEventListener('astro:page-load', () => {
        root.classList.remove('rk-swapping');
        bindTheme();
      });
      bindTheme();
    </script>
  </body>
</html>

<style is:global>
  html.scroll-locked {
    overflow: hidden;
  }
  html.rk-swapping {
    scroll-behavior: auto !important;
  }
  /* back home: a short crossfade, no travel */
  html[data-slide='fade']::view-transition-old(root) {
    animation: 150ms linear both fade-out;
  }
  html[data-slide='fade']::view-transition-new(root) {
    animation: 150ms linear both fade-in;
  }
  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  /* world travel: the new page slides in from its side, the old one moves away */
  html[data-slide='left']::view-transition-old(root) {
    animation: 420ms var(--ease) both slide-to-right;
  }
  html[data-slide='left']::view-transition-new(root) {
    animation: 420ms var(--ease) both slide-from-left;
  }
  html[data-slide='right']::view-transition-old(root) {
    animation: 420ms var(--ease) both slide-to-left;
  }
  html[data-slide='right']::view-transition-new(root) {
    animation: 420ms var(--ease) both slide-from-right;
  }
  @keyframes slide-from-left {
    from {
      transform: translateX(-100%);
    }
  }
  @keyframes slide-from-right {
    from {
      transform: translateX(100%);
    }
  }
  @keyframes slide-to-left {
    to {
      transform: translateX(-30%);
      opacity: 0;
    }
  }
  @keyframes slide-to-right {
    to {
      transform: translateX(30%);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
  .theme-toggle {
    --ldr-face: #6b4a1e;
    --ldr-track: #c98a3a;
    position: fixed;
    right: var(--s-2);
    bottom: var(--s-2);
    z-index: 90;
    display: block;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: none;
    cursor: pointer;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.35);
    transition: transform var(--t-fast) var(--ease);
  }
  :root[data-theme='light'] .theme-toggle {
    --ldr-face: #f2d9a0;
    --ldr-track: #a86a14;
  }
  .theme-toggle svg {
    display: block;
  }
  .theme-toggle .ldr-body {
    fill: #b9bcc0;
  }
  .theme-toggle .ldr-face {
    fill: var(--ldr-face);
    transition: fill 400ms var(--ease);
  }
  .theme-toggle .ldr-track {
    stroke: var(--ldr-track);
    transition: stroke 400ms var(--ease);
  }
  .theme-toggle:hover {
    transform: rotate(-4deg);
  }
  .theme-toggle:active {
    transform: translateY(2px);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle .ldr-face,
    .theme-toggle .ldr-track {
      transition: none;
    }
  }
</style>
