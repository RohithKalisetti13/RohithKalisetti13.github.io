---
import { ClientRouter } from 'astro:transitions';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import site from '../content/site.json';

interface Props {
  title?: string;
  description?: string;
}
const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0a1a14" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // dark unless the visitor chose otherwise; set before first paint
      (() => {
        let t = 'dark';
        try {
          if (localStorage.getItem('rk-theme') === 'light') t = 'light';
        } catch {
          /* storage blocked: stay dark */
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <button type="button" class="theme-toggle" transition:name="theme-toggle" transition:animate="none" aria-label="Toggle light or dark theme" aria-pressed="false">
      <svg viewBox="0 0 56 56" width="56" height="56" aria-hidden="true">
        <rect x="2" y="2" width="52" height="52" rx="6" fill="#10241b" stroke="#2a6b50" stroke-width="1.5" />
        <circle cx="9" cy="9" r="2.4" fill="#c9b16c" />
        <circle cx="47" cy="9" r="2.4" fill="#c9b16c" />
        <circle cx="28" cy="26" r="15" class="ldr-body" />
        <circle cx="28" cy="26" r="12.5" class="ldr-face" />
        <path class="ldr-track" d="M18 19h20M38 19v4M38 23H18M18 23v4M18 27h20M38 27v4M38 31H19" fill="none" stroke-width="2.2" stroke-linejoin="round" />
        <path d="M24 41v7M32 41v7" stroke="#c9ccd0" stroke-width="2.4" stroke-linecap="round" />
        <text x="28" y="14" text-anchor="middle" font-family="'JetBrains Mono Variable', ui-monospace, monospace" font-size="6.5" font-weight="700" fill="#e8efe9" letter-spacing=".6">LDR</text>
      </svg>
    </button>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const btn = document.querySelector('.theme-toggle');
        const sync = () => btn.setAttribute('aria-pressed', String(root.dataset.theme === 'light'));
        sync();
        btn.addEventListener('click', () => {
          const next = root.dataset.theme === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          try {
            localStorage.setItem('rk-theme', next);
          } catch {
            /* storage blocked: choice lasts for this page only */
          }
          sync();
        });
      })();
    </script>
    <script>
      import Lenis from 'lenis';

      const root = document.documentElement;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      let lenis: Lenis | null = null;
      let raf = 0;
      const loop = (t: number) => {
        lenis?.raf(t);
        raf = requestAnimationFrame(loop);
      };
      // wheel smoothing only: no snap, no hijack; keys, find-in-page and touch stay native
      const sync = () => {
        if (reduced.matches) {
          cancelAnimationFrame(raf);
          lenis?.destroy();
          lenis = null;
        } else if (!lenis) {
          lenis = new Lenis({ lerp: 0.12, smoothWheel: true, syncTouch: false });
          raf = requestAnimationFrame(loop);
        }
      };
      sync();
      reduced.addEventListener('change', sync);

      // same-page anchors glide; the URL and focus still follow
      document.addEventListener('click', (e) => {
        if (!lenis || e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const a = (e.target as Element).closest?.('a[href*="#"]') as HTMLAnchorElement | null;
        if (!a || a.target || a.origin !== location.origin || a.pathname !== location.pathname) return;
        const id = decodeURIComponent(a.hash.slice(1));
        const el = id && !id.startsWith('/') ? document.getElementById(id) : null;
        if (!el) return;
        e.preventDefault();
        const nav = parseFloat(getComputedStyle(root).scrollPaddingTop) || 0;
        lenis.scrollTo(el, { offset: -nav });
        history.replaceState(history.state, '', a.hash);
        if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '-1');
        el.focus({ preventScroll: true });
      });

      // the drawer asks for the page to hold still
      window.addEventListener('rk:scroll-lock', (e) => {
        const on = (e as CustomEvent<boolean>).detail;
        root.classList.toggle('scroll-locked', on);
        if (on) lenis?.stop();
        else lenis?.start();
      });

      // keep theme across client-side swaps; pick the slide direction
      const side = (p: string) => (p.startsWith('/ide') ? -1 : p.startsWith('/projects/') ? 1 : 0);
      document.addEventListener('astro:before-swap', (e) => {
        const next = e.newDocument.documentElement;
        next.dataset.theme = root.dataset.theme;
        const from = side(e.from.pathname);
        const to = side(e.to.pathname);
        // new page comes in from the side of the world it lives on
        next.dataset.slide = to < from ? 'left' : to > from ? 'right' : 'none';
      });
      document.addEventListener('astro:after-swap', () => {
        root.classList.remove('scroll-locked');
        if (!lenis) return;
        lenis.start();
        lenis.resize();
        root.classList.add(...lenis.className.split(' '));
      });
    </script>
  </body>
</html>

<style is:global>
  html.scroll-locked {
    overflow: hidden;
  }
  /* world travel: the new page slides in from its side, the old one moves away */
  html[data-slide='left']::view-transition-old(root) {
    animation: 420ms var(--ease) both slide-to-right;
  }
  html[data-slide='left']::view-transition-new(root) {
    animation: 420ms var(--ease) both slide-from-left;
  }
  html[data-slide='right']::view-transition-old(root) {
    animation: 420ms var(--ease) both slide-to-left;
  }
  html[data-slide='right']::view-transition-new(root) {
    animation: 420ms var(--ease) both slide-from-right;
  }
  @keyframes slide-from-left {
    from {
      transform: translateX(-100%);
    }
  }
  @keyframes slide-from-right {
    from {
      transform: translateX(100%);
    }
  }
  @keyframes slide-to-left {
    to {
      transform: translateX(-30%);
      opacity: 0;
    }
  }
  @keyframes slide-to-right {
    to {
      transform: translateX(30%);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
  .theme-toggle {
    --ldr-face: #6b4a1e;
    --ldr-track: #c98a3a;
    position: fixed;
    right: var(--s-2);
    bottom: var(--s-2);
    z-index: 90;
    display: block;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: none;
    cursor: pointer;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.35);
    transition: transform var(--t-fast) var(--ease);
  }
  :root[data-theme='light'] .theme-toggle {
    --ldr-face: #f2d9a0;
    --ldr-track: #a86a14;
  }
  .theme-toggle svg {
    display: block;
  }
  .theme-toggle .ldr-body {
    fill: #b9bcc0;
  }
  .theme-toggle .ldr-face {
    fill: var(--ldr-face);
    transition: fill 400ms var(--ease);
  }
  .theme-toggle .ldr-track {
    stroke: var(--ldr-track);
    transition: stroke 400ms var(--ease);
  }
  .theme-toggle:hover {
    transform: rotate(-4deg);
  }
  .theme-toggle:active {
    transform: translateY(2px);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle .ldr-face,
    .theme-toggle .ldr-track {
      transition: none;
    }
  }
</style>
